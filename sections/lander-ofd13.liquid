{%- comment -%}
  OFD13 — GLP-1 Nutrient Support Stack advertorial-PDP hybrid.
  Angle: rapid GLP-1 weight loss creates a nutrient deficit. Stack closes the gap.
  Brand voice: declarative, no em dashes, no exclamations, no rhetorical questions.
  Compliance: structure/function only, "GLP-1 injections" never brand names, ~ on weight numbers.
{%- endcomment -%}

{%- liquid
  assign hero_img    = section.settings.hero_img    | default: 'https://www.absorbmore.com/cdn/shop/files/TAC_PDP-Image_GLP1-Nutrient-Stack.png?v=1775533230&width=1024'
  assign stack_img   = section.settings.stack_img   | default: 'https://www.absorbmore.com/cdn/shop/files/TAC_GLP1-Nutrient-Stack_PDP_1.png?v=1775533230&width=1024'
  assign graph_img   = section.settings.graph_img   | default: 'https://www.absorbmore.com/cdn/shop/files/TAC_PDP-Image_GLP-1NutrientSupportStack_Graph.png?v=1775533230&width=1024'
  assign restore_img = section.settings.restore_img | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/restore-raspberry-bag-v2-ofd13.png?v=1781222183'
  assign dk_img      = section.settings.dk_img      | default: 'https://www.absorbmore.com/cdn/shop/files/TAC_PDP-Image_Vitamin-D3-K2.png?v=1768595416&width=600'

  comment
    Single variant ($99). Skio sub = $69.30 every 60 days (30% off), plan 691124896033.
    Use native form POST /cart/add (cart permalinks drop selling_plan on this theme).
  endcomment
  assign variant_id      = section.settings.variant_id      | default: '52542695112993'
  assign sub_plan_id     = section.settings.sub_plan_id     | default: '691124863265'
  assign price_sub       = section.settings.price_sub       | default: '$69.30'
  assign price_sub_was   = section.settings.price_sub_was   | default: '$99.00'
  assign price_sub_save  = section.settings.price_sub_save  | default: 'Save $29.70'
  assign sub_cadence     = section.settings.sub_cadence     | default: 'every 30 days'
  assign price_ot        = section.settings.price_ot        | default: '$99.00'
  assign discount_pct    = section.settings.discount_pct    | default: '30'

  assign rating          = section.settings.rating          | default: '4.7'
  assign review_count    = section.settings.review_count    | default: '2,400+'
  assign wlp1_link       = section.settings.wlp1_link       | default: 'https://www.absorbmore.com/products/wlp-1'

  assign testimonial_quote  = section.settings.testimonial_quote  | default: 'I am on GLP-1 injections for 6 months now and did not realize how the reduced calorie intake was affecting me. My skin seemed pale and my muscles got sore so easily. These products have helped me feel better while continuing to lose weight. I look healthier and feel better too.'
  assign testimonial_name   = section.settings.testimonial_name   | default: 'Christopher'
  assign testimonial_title  = section.settings.testimonial_title  | default: 'Verified Customer · GLP-1 Nutrient Support Stack'
  assign testimonial_pull   = section.settings.testimonial_pull   | default: 'I look healthier and feel better too.'
-%}

<style>
  .ofd13 { --bg:#ffffff; --bg-soft:#fdf6f7; --bg-tint:#fbe9ec; --paper:#fdf8f9; --ink:#1a0d10; --ink-soft:#3d2429; --muted:#7a6a6d; --line:#f0d3d8; --line-soft:#f7e1e5; --brand:#C63947; --brand-hover:#A82D3A; --brand-deep:#8F1F2D; --brand-tint:#fae5e9; --accent:#FF7815; --accent-hover:#e76b0e; --green:#3EA193; --green-tint:#e1f2ee; --ink-deep:#1a0408; --red:#E1225C; --red-soft:#ff406f;
    background:var(--bg); color:var(--ink); -webkit-font-smoothing:antialiased; line-height:1.5; }
  .ofd13 *{box-sizing:border-box}
  .ofd13 img{max-width:100%;display:block;height:auto}
  .ofd13 a{color:inherit;text-decoration:none}
  .ofd13 .wrap{max-width:1120px;margin:0 auto;padding:0 18px}
  .ofd13 .wrap-narrow{max-width:760px;margin:0 auto;padding:0 18px}

  /* HERO */
  .ofd13-hero{background:linear-gradient(180deg,var(--bg) 0%,var(--bg-soft) 100%);padding:30px 0 40px;border-bottom:1px solid var(--line-soft);position:relative}
  .ofd13-hero__grid{display:grid;grid-template-columns:1fr;gap:22px;align-items:center}
  @media(min-width:880px){.ofd13-hero__grid{grid-template-columns:1.05fr .95fr;gap:48px;padding:14px 0}}
  .ofd13-hero__eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;margin-bottom:16px}
  .ofd13-hero__eyebrow::before{content:"";width:6px;height:6px;background:var(--brand);border-radius:50%;display:inline-block}
  .ofd13-hero h1{font-size:clamp(30px,5.6vw,50px);line-height:1.02;letter-spacing:-.035em;font-weight:800;margin:0 0 14px;color:var(--ink-deep)}
  .ofd13-hero h1 em{font-style:normal;color:var(--brand)}
  .ofd13-hero__sub{font-size:clamp(15px,2vw,18px);max-width:540px;margin:0 0 18px;color:var(--ink-soft);line-height:1.5}
  .ofd13-hero__sub b{color:var(--ink);font-weight:600}
  .ofd13-hero__bullets{list-style:none;padding:0;margin:0 0 18px;display:grid;gap:8px;max-width:540px}
  .ofd13-hero__bullets li{display:flex;align-items:flex-start;gap:10px;font-size:15px;font-weight:500;color:var(--ink);line-height:1.4}
  .ofd13-hero__bullets li svg{width:20px;height:20px;flex:0 0 auto;color:var(--brand);margin-top:2px}
  .ofd13-hero__cta{display:inline-flex;align-items:center;justify-content:center;width:100%;max-width:440px;padding:16px 30px;background:var(--brand);color:#fff !important;font-weight:600;font-size:15px;letter-spacing:.01em;border-radius:2px;border:none;cursor:pointer;text-decoration:none;transition:background .2s}
  .ofd13-hero__cta:hover{background:var(--brand-hover)}
  .ofd13-hero__cta:after{content:" →";margin-left:10px}
  .ofd13-hero__rating{display:flex;align-items:center;gap:10px;margin:14px 0 0;font-size:13px;color:var(--ink-soft);flex-wrap:wrap}
  .ofd13-hero__stars{color:var(--accent);letter-spacing:2px;font-size:14px}
  .ofd13-hero__rating b{color:var(--ink-deep);font-weight:700}
  .ofd13-hero__media{position:relative;text-align:center}
  .ofd13-hero__card{background:var(--bg-soft);border-radius:8px;width:100%;max-width:440px;margin:0 auto;aspect-ratio:1/1;border:1px solid var(--line);overflow:hidden;padding:18px;display:flex;align-items:center;justify-content:center}
  .ofd13-hero__card img{width:100%;height:100%;object-fit:contain}
  .ofd13-hero__badge{position:absolute;top:-10px;right:14px;background:var(--accent);color:#fff;border-radius:999px;width:96px;height:96px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;line-height:1;transform:rotate(-8deg);border:3px solid #fff;box-shadow:0 6px 14px rgba(8,13,36,.18)}
  .ofd13-hero__badge big{font-size:22px;letter-spacing:-.01em}
  .ofd13-hero__badge span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-top:2px}
  .ofd13-hero__chip{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:#fff;color:var(--ink-deep);border:1px solid var(--line);border-radius:999px;padding:9px 18px;font-size:12px;font-weight:700;letter-spacing:.04em;line-height:1;box-shadow:0 6px 16px rgba(8,13,36,.12);white-space:nowrap;display:inline-flex;align-items:center;gap:8px}
  .ofd13-hero__chip::before{content:"";width:6px;height:6px;background:var(--brand);border-radius:50%;flex:0 0 auto}
  @media(max-width:879px){.ofd13-hero__card{max-width:340px}.ofd13-hero__badge{top:-6px;right:6px;width:80px;height:80px}.ofd13-hero__badge big{font-size:18px}.ofd13-hero__chip{font-size:11px;padding:8px 14px;bottom:10px}}

  /* TRUST STRIP */
  .ofd13-trust{background:var(--bg-soft);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:14px 0}
  .ofd13-trust__row{display:grid;grid-template-columns:1fr;gap:10px 16px;font-size:13px;font-weight:500;color:var(--ink)}
  @media(min-width:520px){.ofd13-trust__row{grid-template-columns:1fr 1fr;text-align:center}}
  @media(min-width:720px){.ofd13-trust__row{grid-template-columns:repeat(4,1fr)}}
  .ofd13-trust__cell{display:flex;align-items:center;justify-content:flex-start;gap:8px}
  @media(min-width:520px){.ofd13-trust__cell{justify-content:center}}
  .ofd13-trust__cell svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}

  /* SECTION BASE */
  .ofd13-sec{padding:54px 0}
  .ofd13-sec--soft{background:var(--bg-soft)}
  .ofd13-sec--tint{background:var(--bg-tint)}
  .ofd13-sec--ink{background:var(--ink-deep);color:#fff}
  .ofd13-sec--ink h2,.ofd13-sec--ink h3{color:#fff}
  .ofd13-sec__eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.24em;font-weight:700;color:var(--ink);margin:0 0 12px;display:inline-flex;align-items:center;gap:10px}
  .ofd13-sec__eyebrow::before{content:"";width:6px;height:6px;background:var(--brand);border-radius:50%;display:inline-block}
  .ofd13-sec--ink .ofd13-sec__eyebrow{color:rgba(255,255,255,.85)}
  .ofd13-sec--ink .ofd13-sec__eyebrow::before{background:var(--accent)}
  .ofd13-sec__title{font-size:clamp(26px,4.5vw,40px);font-weight:800;letter-spacing:-.035em;color:var(--ink-deep);margin:0 0 12px;line-height:1.05}
  .ofd13-sec--ink .ofd13-sec__title{color:#fff}
  .ofd13-sec__title em{font-style:normal;color:var(--brand)}
  .ofd13-sec--ink .ofd13-sec__title em{color:var(--accent)}
  .ofd13-sec__sub{font-size:16px;color:var(--ink-soft);max-width:680px;margin:0 0 28px;line-height:1.6}
  .ofd13-sec--ink .ofd13-sec__sub{color:rgba(255,255,255,.82)}

  /* PROSE */
  .ofd13-prose{max-width:680px;margin:0 auto}
  .ofd13-prose p{font-size:17px;line-height:1.65;color:var(--ink);margin:0 0 18px}
  .ofd13-prose p b{font-weight:700;color:var(--ink-deep)}
  .ofd13-prose p .blue{color:var(--brand);font-weight:700}

  /* MATH PULL */
  .ofd13-math{background:#fff;border:1px solid var(--line);border-left:4px solid var(--brand);border-radius:0 8px 8px 0;padding:22px 22px;margin:0 auto;max-width:680px}
  .ofd13-math__num{font-size:32px;font-weight:800;color:var(--brand);line-height:1;letter-spacing:-.02em;margin:0 0 6px}
  .ofd13-math__t{font-size:15px;color:var(--ink);line-height:1.5;margin:0}
  .ofd13-math__t b{color:var(--ink-deep);font-weight:700}

  /* DARK 3-DEFICIT SECTION */
  .ofd13-sec--ink .ofd13-prose p{color:rgba(255,255,255,.88)}
  .ofd13-sec--ink .ofd13-prose p b{color:#fff}
  .ofd13-sec--ink .ofd13-prose p .red{color:var(--red-soft);font-weight:700}

  .ofd13-deflead{max-width:760px;margin:0 auto 36px;text-align:center}
  .ofd13-deflead .ofd13-sec__eyebrow{justify-content:center}
  .ofd13-deflead__sub{font-size:16px;color:rgba(255,255,255,.82);line-height:1.55;margin:0 auto;max-width:620px}
  .ofd13-deflead__sub .red{color:var(--red-soft);font-weight:700}
  .ofd13-deflead__sub b{color:#fff;font-weight:600}

  .ofd13-defs{max-width:1040px;margin:0 auto;display:grid;grid-template-columns:1fr;gap:10px}
  @media(min-width:600px){.ofd13-defs{grid-template-columns:repeat(2,1fr);gap:12px}}
  @media(min-width:880px){.ofd13-defs{grid-template-columns:repeat(3,1fr);gap:14px}}
  .ofd13-def{background:#10173a;border:1px solid rgba(255,255,255,.08);border-left:3px solid var(--red);padding:16px 18px;display:flex;flex-direction:column;gap:4px}
  .ofd13-def__num{font-size:11px;font-weight:800;letter-spacing:.18em;color:var(--red-soft);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;margin:0}
  .ofd13-def__h{font-size:16px;font-weight:800;color:#fff;line-height:1.2;margin:2px 0 0;letter-spacing:-.01em}
  .ofd13-def__why{font-size:13.5px;color:rgba(255,255,255,.74);line-height:1.45;margin:4px 0 0}
  .ofd13-defs__close{max-width:880px;margin:40px auto 0;padding:28px 24px;text-align:center;background:linear-gradient(180deg,rgba(198,57,71,.12),rgba(198,57,71,.04));border:1px solid rgba(198,57,71,.28);border-radius:14px;font-size:18px;color:rgba(255,255,255,.92);line-height:1.55}
  @media(min-width:700px){.ofd13-defs__close{font-size:20px;padding:34px 32px;margin-top:48px}}
  .ofd13-defs__close b{color:#fff;font-weight:800}
  .ofd13-defs__close .red{color:var(--red-soft);font-weight:800;letter-spacing:.14em;text-transform:uppercase;font-size:12.5px;display:block;margin-bottom:12px}
  @media(min-width:700px){.ofd13-defs__close .red{font-size:13.5px;margin-bottom:14px}}

  /* FOUNDER QUOTE */
  .ofd13-founder{padding:54px 0;background:var(--paper);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
  .ofd13-founder--inline{padding:38px 22px 36px;background:#fff;border:1px solid var(--line);border-radius:14px;margin:0 auto 36px;max-width:960px;box-shadow:0 14px 40px rgba(198,57,71,.10);position:relative}
  .ofd13-founder--inline:before{content:"";position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,var(--brand),var(--brand-hover));border-radius:14px 14px 0 0}
  .ofd13-founder__inner{max-width:820px;margin:0 auto;padding:0;text-align:center}
  .ofd13-founder__badge{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--brand);background:var(--brand-tint);padding:6px 12px;border-radius:999px;margin:0 0 14px}
  .ofd13-founder__stars{font-size:24px;color:var(--accent);letter-spacing:3px;margin:0 0 14px;line-height:1}
  .ofd13-founder__pull{font-size:clamp(28px,4.5vw,42px);line-height:1.1;color:var(--ink-deep);font-weight:800;letter-spacing:-.02em;margin:0 0 18px}
  .ofd13-founder__pull em{font-style:normal;color:var(--brand)}
  .ofd13-founder__q{font-size:clamp(16px,2vw,19px);line-height:1.55;color:var(--ink);font-weight:500;letter-spacing:-.005em;margin:0 0 22px;font-style:normal;max-width:680px;margin-left:auto;margin-right:auto}
  .ofd13-founder__q b{color:var(--ink-deep);font-weight:800}
  .ofd13-founder__q b{color:var(--brand);font-weight:700}
  .ofd13-founder__attr{display:inline-flex;align-items:center;justify-content:center;gap:14px;padding-top:14px;border-top:1px solid var(--line);min-width:220px}
  .ofd13-founder__name{font-size:14px;color:var(--ink-deep);font-weight:700;line-height:1.2;text-align:left;display:flex;align-items:center;gap:8px;justify-content:center}
  .ofd13-founder__verified{font-size:11px;color:var(--green);font-weight:700;background:var(--green-tint);padding:3px 8px;border-radius:999px;letter-spacing:.02em}
  .ofd13-founder__title{font-size:12px;color:var(--ink-soft);font-weight:500;display:block;margin-top:4px;letter-spacing:.02em;text-align:center}

  /* STACK COMPONENTS */
  .ofd13-stack{display:grid;grid-template-columns:1fr;gap:18px;max-width:980px;margin:0 auto}
  @media(min-width:760px){.ofd13-stack{grid-template-columns:1fr 1fr}}
  .ofd13-comp{background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;display:flex;flex-direction:column}
  .ofd13-comp__img{position:relative;background:var(--bg-soft);aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;padding:24px;border-bottom:1px solid var(--line-soft)}
  .ofd13-comp__img img{max-width:100%;max-height:100%;object-fit:contain}
  .ofd13-flavor-badge{position:absolute;top:14px;left:14px;background:var(--brand);color:#fff;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:9px 12px 8px;border-radius:6px;line-height:1.25;text-align:left;box-shadow:0 6px 18px rgba(198,57,71,.28);display:inline-flex;flex-direction:column;gap:2px;z-index:2;max-width:140px}
  .ofd13-flavor-badge b{font-size:11.5px;font-weight:800;letter-spacing:.14em;display:block}
  .ofd13-flavor-badge i{font-style:normal;display:block;font-size:9.5px;font-weight:600;opacity:.95;letter-spacing:.14em}
  @media(min-width:520px){.ofd13-flavor-badge{font-size:10.5px;padding:10px 14px 9px;max-width:160px}.ofd13-flavor-badge b{font-size:12.5px}.ofd13-flavor-badge i{font-size:10px}}
  .ofd13-comp__body{padding:22px 22px 24px}
  .ofd13-comp__eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.18em;font-weight:700;color:var(--brand);margin:0 0 8px}
  .ofd13-comp__h{font-size:22px;font-weight:800;color:var(--ink-deep);letter-spacing:-.02em;margin:0 0 8px;line-height:1.1}
  .ofd13-comp__role{font-size:13px;color:var(--ink-soft);font-weight:600;margin:0 0 14px;text-transform:uppercase;letter-spacing:.08em}
  .ofd13-comp__list{list-style:none;padding:0;margin:0;display:grid;gap:8px}
  .ofd13-comp__list li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;color:var(--ink);line-height:1.4}
  .ofd13-comp__list li svg{width:18px;height:18px;flex:0 0 auto;color:var(--brand);margin-top:2px}
  .ofd13-comp__cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;margin-top:20px;padding:12px 20px;background:#fff;border:1.5px solid var(--brand);color:var(--brand);font-weight:700;font-size:13.5px;text-decoration:none;border-radius:6px;letter-spacing:.05em;text-transform:uppercase;transition:background .15s,color .15s;width:fit-content}
  .ofd13-comp__cta:hover{background:var(--brand);color:#fff}
  .ofd13-comp__cta:after{content:"→";font-weight:600}
  .ofd13-comp__role-hint{font-size:12px;color:var(--muted);font-weight:500;margin:6px 0 0;font-style:italic}

  /* BUYBOX */
  .ofd13-buy{background:#fff;border:1px solid var(--line);border-radius:14px;padding:26px 22px;max-width:580px;margin:0 auto;box-shadow:0 8px 36px rgba(198,57,71,.07)}
  .ofd13-buy__flag{display:inline-flex;align-items:center;gap:10px;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;margin-bottom:14px}
  .ofd13-buy__flag::before{content:"";width:6px;height:6px;background:var(--accent);border-radius:50%;display:inline-block}
  .ofd13-buy__head{display:flex;gap:14px;align-items:center;margin:0 0 14px}
  .ofd13-buy__thumb{width:78px;height:78px;flex:0 0 auto;border-radius:10px;background:var(--bg-soft);border:1px solid var(--line-soft);overflow:hidden;display:flex;align-items:center;justify-content:center}
  .ofd13-buy__thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .ofd13-buy__head-text{flex:1;min-width:0}
  .ofd13-buy__h{font-size:22px;font-weight:800;color:var(--ink-deep);margin:0 0 4px;letter-spacing:-.02em;line-height:1.15}
  .ofd13-buy__sub{font-size:14px;color:var(--ink-soft);margin:0;line-height:1.4}
  .ofd13-buy__bens{list-style:none;padding:14px 0;margin:0 0 18px;display:flex;flex-direction:column;gap:9px;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
  .ofd13-buy__bens li{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:var(--ink);line-height:1.4}
  .ofd13-buy__bens li b{color:var(--ink-deep);font-weight:700}
  .ofd13-buy__bens svg{width:18px;height:18px;color:var(--green);flex:0 0 auto;margin-top:1px}
  .ofd13-buy__bens .ofd13-buy__bens-gift{color:var(--accent)}
  .ofd13-buy__bens .ofd13-buy__bens-gift b{color:var(--ink-deep)}
  .ofd13-buy__gift-val{display:inline-block;background:#fff3e8;color:var(--accent);font-weight:800;font-size:11px;letter-spacing:.06em;padding:2px 7px;border-radius:6px;margin-left:6px;text-transform:uppercase;vertical-align:1px}
  .ofd13-buy__list{display:flex;flex-direction:column;gap:0;border:1px solid var(--line);border-radius:10px;overflow:hidden;margin:0 0 18px;background:#fff}
  .ofd13-buy__form{margin:0;padding:0}
  .ofd13-flavor{margin:0 0 16px}
  .ofd13-flavor__label{display:flex;align-items:center;justify-content:space-between;font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--ink-deep);margin:0 0 8px}
  .ofd13-flavor__label-hint{font-size:11px;font-weight:600;color:var(--muted);text-transform:none;letter-spacing:.02em}
  .ofd13-flavor__opts{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .ofd13-flavor__opt{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:2px;padding:12px 14px;border:1.5px solid var(--line);border-radius:8px;background:#fff;cursor:pointer;transition:border-color .15s,background .15s,box-shadow .15s}
  .ofd13-flavor__opt input{position:absolute;opacity:0;pointer-events:none}
