<script>
  (function(){
    var sticky = document.getElementById('ofd13Sticky');
    var buy = document.querySelector('[data-buybox]');
    if(!sticky || !buy) return;
    var onScroll = function(){
      if(window.innerWidth >= 880) return;
      var y = window.scrollY || window.pageYOffset;
      var buyTop = buy.getBoundingClientRect().top + window.scrollY;
      if(y > 400 && y < buyTop - 100){
        sticky.classList.add('is-visible');
      } else {
        sticky.classList.remove('is-visible');
      }
    };
    window.addEventListener('scroll', onScroll, {passive:true});
    onScroll();
  })();

  (function(){
    var form = document.querySelector('[data-buyform]');
    if(!form) return;
    var sp = form.querySelector('[data-selling-plan]');
    var ctaPrice = form.querySelector('[data-cta-price]');
    var subPlanId = {{ sub_plan_id | json }};
    var priceSub = {{ price_sub | json }};
    var priceOt  = {{ price_ot  | json }};
    form.addEventListener('change', function(e){
      if(e.target.name !== 'plan') return;
      if(e.target.value === 'sub'){
        sp.value = subPlanId;
        ctaPrice.textContent = priceSub;
      } else {
        sp.value = '';
        ctaPrice.textContent = priceOt;
      }
    });
  })();

  // Direct-to-checkout: intercept any /cart/add form in this section,
  // POST to /cart/add.js, then redirect to /checkout. Falls back to native submit on error.
  (function(){
    var root = document.querySelector('.ofd13');
    if(!root) return;
    root.addEventListener('submit', function(e){
      var form = e.target;
      if(!form || form.tagName !== 'FORM') return;
      if((form.getAttribute('action') || '') !== '/cart/add') return;
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      var originalLabel = btn ? btn.innerHTML : null;
      if(btn){ btn.disabled = true; btn.innerHTML = 'Working…'; }
      var fd = new FormData(form);
      // Strip empty selling_plan so one-time doesn't post selling_plan=""
      if(fd.get('selling_plan') === '' || fd.get('selling_plan') == null){ fd.delete('selling_plan'); }
      fd.delete('return_to');
      fd.delete('plan');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Accept':'application/json','X-Requested-With':'XMLHttpRequest'},
        body: fd,
        credentials: 'same-origin'
      }).then(function(res){
        if(!res.ok) throw new Error('add failed');
        window.location.href = '/checkout';
      }).catch(function(){
        if(btn){ btn.disabled = false; btn.innerHTML = originalLabel; }
        form.removeEventListener('submit', arguments.callee);
        form.submit();
      });
    });
  })();
</script>

