<style>
  .adv3 { --bg:#ffffff; --paper:#fbfaf6; --paper-soft:#f5f3ec; --ink:#15161a; --ink-soft:#3a3d49; --muted:#6d7383; --line:#e2e0d6; --line-soft:#ecead9; --brand:#4659FF; --brand-deep:#2c39b3; --brand-tint:#e6e9ff; --accent:#FF7815; --accent-deep:#c25a0c; --accent-tint:#ffe9d6; --rule:#15161a; }
  .adv3 *{box-sizing:border-box}
  .adv3{color:var(--ink);background:var(--bg);font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
  .adv3 .wrap{max-width:680px;margin:0 auto;padding:0 20px}
  .adv3 .wrap-wide{max-width:880px;margin:0 auto;padding:0 20px}

  /* Disclosure bar */
  .adv3-disc{background:#15161a;color:#dcdfe8;font-size:11px;letter-spacing:.12em;text-transform:uppercase;text-align:center;padding:7px 14px;font-weight:600}
  .adv3-disc b{color:#fff}

  /* Editorial masthead */
  .adv3-masthead{border-bottom:1px solid var(--line);padding:18px 0 14px;margin-bottom:18px;text-align:center}
  .adv3-masthead__logo{font-size:22px;font-weight:700;letter-spacing:.02em;color:var(--ink);text-transform:uppercase}
  .adv3-masthead__tag{font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:5px;font-weight:600}

  /* Article header */
  .adv3-art{padding:14px 0 8px}
  .adv3-cat{font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--accent-deep);margin-bottom:14px}
  .adv3-h1{font-size:clamp(28px,5vw,42px);line-height:1.12;font-weight:700;color:var(--ink);letter-spacing:-.015em;margin:0 0 14px}
  .adv3-h1 em{font-style:normal;color:var(--brand)}
  .adv3-deck{font-size:18px;line-height:1.42;color:var(--ink-soft);font-weight:400;margin:0 0 18px;font-style:italic}
  .adv3-meta{display:flex;align-items:center;gap:12px;font-size:12.5px;color:var(--muted);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0;margin-bottom:18px;flex-wrap:wrap}
  .adv3-meta b{color:var(--ink);font-weight:600}
  .adv3-meta__dot{width:3px;height:3px;background:var(--muted);border-radius:50%;display:inline-block}
  .adv3-meta__read{margin-left:auto;font-weight:600;color:var(--ink-soft)}

  /* Lead image */
  .adv3-lead{margin:0 0 8px;width:100%}
  .adv3-lead img{width:100%;height:auto;display:block;aspect-ratio:4/3;object-fit:cover;object-position:center 18%;background:var(--paper-soft)}
  .adv3-lead__cap{font-size:12px;color:var(--muted);line-height:1.45;padding:8px 4px 22px;border-bottom:1px solid var(--line);margin-bottom:22px}
  .adv3-lead__cap b{color:var(--ink-soft);font-weight:600}

  /* Body */
  .adv3-body p{font-size:17.5px;line-height:1.62;color:var(--ink);margin:0 0 18px;font-weight:400}
  .adv3-body p b{font-weight:700;color:var(--ink)}
  .adv3-body p i, .adv3-body p em{font-style:italic}
  .adv3-body p.lead{font-size:19.5px;line-height:1.45;color:var(--ink);font-weight:500}
  .adv3-body h2{font-size:clamp(22px,3.4vw,28px);font-weight:700;color:var(--ink);line-height:1.2;letter-spacing:-.01em;margin:34px 0 14px}
  .adv3-body h2 em{font-style:italic}
  .adv3-body a{color:var(--brand-deep);text-decoration:underline;text-underline-offset:3px;font-weight:600}
  .adv3-body a:hover{color:var(--brand)}

  /* Pull quote */
  .adv3-pull{margin:30px -4px;padding:22px 22px 22px;background:var(--paper);border-left:4px solid var(--accent);border-radius:0 4px 4px 0}
  .adv3-pull__q{font-size:21px;line-height:1.4;font-weight:500;color:var(--ink);font-style:italic;margin:0 0 10px;letter-spacing:-.005em}
  .adv3-pull__a{font-size:12.5px;color:var(--muted);font-weight:600;letter-spacing:.04em}
  .adv3-pull__a b{color:var(--ink);font-weight:700}
  .adv3-pull__a svg{width:12px;height:12px;color:var(--brand);vertical-align:-1px;margin-left:5px}

  /* Inline image */
