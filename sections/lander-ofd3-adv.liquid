  .adv3-actives__title{font-size:18px;font-weight:700;color:var(--ink);margin:0 0 14px;letter-spacing:-.01em}
  .adv3-actives ul{list-style:none;margin:0;padding:0;display:grid;gap:14px}
  .adv3-actives li{font-size:15px;line-height:1.5;color:var(--ink-soft);padding-left:0}
  .adv3-actives li b{display:block;color:var(--ink);font-weight:700;font-size:14px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}

  /* Buy block */
  .adv3-buy{margin:34px 0 14px;background:var(--paper);border:2px solid var(--accent);border-radius:6px;padding:22px 18px;scroll-margin-top:60px}
  .adv3-buy__flag{display:inline-block;background:var(--accent);color:#fff;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.08em;padding:4px 10px;border-radius:2px;margin-bottom:14px}
  .adv3-buy__title{font-size:22px;font-weight:700;color:var(--ink);margin:0 0 4px;letter-spacing:-.01em}
  .adv3-buy__sub{font-size:13.5px;color:var(--ink-soft);margin:0 0 16px}
  .adv3-buy__rate{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-soft);margin-bottom:16px}
  .adv3-buy__rate b{color:var(--ink);font-weight:700}
  .adv3-buy__rate .stars{color:var(--accent);letter-spacing:1.5px;font-size:14px}
  .adv3-buy__opts{display:grid;gap:10px;margin-bottom:14px}
  .adv3-opt{background:#fff;border:1.5px solid var(--line);border-radius:4px;padding:14px 12px 14px 38px;cursor:pointer;position:relative;display:grid;grid-template-columns:1fr auto;gap:10px;align-items:start;transition:border-color .15s,background .15s}
  .adv3-opt input{position:absolute;opacity:0;pointer-events:none}
  .adv3-opt__bullet{position:absolute;top:18px;left:14px;width:14px;height:14px;border-radius:50%;border:2px solid var(--muted);background:#fff}
  .adv3-opt.is-on{border-color:var(--accent);background:var(--accent-tint)}
  .adv3-opt.is-on .adv3-opt__bullet{border-color:var(--accent);background:radial-gradient(circle,var(--accent) 40%,#fff 45%)}
  .adv3-opt__title{font-size:14.5px;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:6px;flex-wrap:wrap;line-height:1.25}
  .adv3-opt__chip{display:inline-block;background:var(--accent);color:#fff;font-weight:700;font-size:10px;text-transform:uppercase;letter-spacing:.08em;padding:2px 7px;border-radius:2px}
  .adv3-opt__chip--blue{background:var(--brand);color:#fff}
  .adv3-opt__meta{font-size:12px;color:var(--ink-soft);margin-top:4px;line-height:1.4}
  .adv3-opt__gift{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;color:var(--accent-deep);background:var(--accent-tint);border-radius:3px;padding:3px 7px;margin-top:6px;line-height:1.2;border:1px solid var(--accent)}
  .adv3-opt__gift svg{width:12px;height:12px;flex:0 0 auto}
  .adv3-opt__fine{font-size:11px;color:var(--muted);margin-top:6px}
  .adv3-opt__price{text-align:right;font-size:12px;color:var(--ink-soft);line-height:1.3}
  .adv3-opt__price b{display:block;font-size:18px;color:var(--ink);font-weight:800;margin-bottom:2px;letter-spacing:-.01em}
  .adv3-opt__price s{color:var(--muted);text-decoration:line-through;margin-right:4px}
  .adv3-opt__price-row{display:block;margin-top:2px}
  .adv3-opt__save{display:block;color:var(--brand-deep);font-weight:700;margin-top:2px}
  .adv3-buy__cta{display:inline-flex;align-items:center;justify-content:center;width:100%;padding:16px 28px;background:var(--brand);color:#fff !important;font-weight:700;font-size:15px;letter-spacing:.02em;border-radius:2px;text-decoration:none;border:none;cursor:pointer;text-transform:uppercase;transition:background .2s}
  .adv3-buy__cta:hover{background:var(--brand-deep)}
  .adv3-buy__info{margin:12px 0 0;font-size:11.5px;color:var(--muted);line-height:1.45;text-align:center}
  .adv3-buy__trust{display:flex;flex-wrap:wrap;gap:10px 16px;justify-content:center;margin-top:12px;font-size:11px;color:var(--ink-soft);font-weight:600}
  .adv3-buy__trust span{display:inline-flex;align-items:center;gap:4px}
  .adv3-buy__trust svg{width:11px;height:11px;color:var(--brand)}

  /* Customer reviews stack */
  .adv3-revs{margin:30px 0 22px;background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:22px 18px}
  .adv3-revs__h{font-size:18px;font-weight:700;color:var(--ink);margin:0 0 4px;letter-spacing:-.01em}
  .adv3-revs__sub{font-size:12.5px;color:var(--muted);margin:0 0 18px}
  .adv3-rev{padding:14px 0;border-top:1px solid var(--line-soft)}
  .adv3-rev:first-of-type{border-top:none;padding-top:0}
  .adv3-rev__stars{color:var(--accent);font-size:12px;letter-spacing:1.5px;margin-bottom:6px}
  .adv3-rev__txt{font-size:14.5px;color:var(--ink);line-height:1.5;margin:0 0 6px}
  .adv3-rev__name{font-size:12px;color:var(--ink-soft)}
  .adv3-rev__name b{color:var(--ink);font-weight:700}
  .adv3-rev__verif{display:inline-flex;align-items:center;gap:3px;color:var(--brand-deep);font-weight:600;margin-left:4px}
  .adv3-rev__verif svg{width:11px;height:11px}

  /* FAQ */
  .adv3-faq{margin:30px 0}
  .adv3-faq__h{font-size:22px;font-weight:700;color:var(--ink);margin:0 0 14px;letter-spacing:-.01em}
  .adv3-faq details{border-bottom:1px solid var(--line);padding:14px 0}
  .adv3-faq details:first-of-type{border-top:1px solid var(--line)}
  .adv3-faq summary{font-size:15.5px;font-weight:700;color:var(--ink);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:14px}
  .adv3-faq summary::-webkit-details-marker{display:none}
  .adv3-faq summary::after{content:"+";font-size:22px;color:var(--accent);font-weight:300;line-height:1}
  .adv3-faq details[open] summary::after{content:"−"}
  .adv3-faq__a{font-size:14.5px;color:var(--ink-soft);line-height:1.55;margin:12px 0 0;padding-bottom:2px}

  /* Final CTA band */
  .adv3-trust{background:#f6f4ef;border:1px solid var(--line);border-radius:6px;padding:24px 20px 20px;margin:24px 0 0}
  .adv3-trust__eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--brand);font-weight:700;text-align:center;margin:0 0 6px}
  .adv3-trust__h{font-size:clamp(20px,3.6vw,26px);font-weight:700;line-height:1.2;letter-spacing:-.015em;text-align:center;margin:0 0 20px;color:var(--ink)}
  .adv3-trust__grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 14px}
  .adv3-trust__card{background:#fff;border:1px solid var(--line);border-radius:4px;padding:14px 12px;display:flex;align-items:flex-start;gap:10px}
  .adv3-trust__check{flex:0 0 22px;width:22px;height:22px;border-radius:50%;background:var(--brand);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;line-height:1;margin-top:1px}
  .adv3-trust__body{flex:1;min-width:0}
  .adv3-trust__lbl{font-size:14px;font-weight:700;color:var(--ink);line-height:1.2;margin:0 0 3px;letter-spacing:-.005em}
  .adv3-trust__sub{font-size:12.5px;color:#5a5d68;line-height:1.35;margin:0}
  .adv3-trust__fine{font-size:11px;color:#7a7d88;text-align:center;line-height:1.5;margin:14px 0 0}
  @media (min-width:560px){.adv3-trust__grid{grid-template-columns:repeat(4,1fr)}}

  /* Editorial footer */
  .adv3-foot{border-top:1px solid var(--line);margin-top:30px;padding:22px 0 30px;text-align:center;font-size:11.5px;color:var(--muted);line-height:1.55}
  .adv3-foot b{color:var(--ink-soft);font-weight:600}
  .adv3-foot a{color:var(--ink-soft);text-decoration:underline}

  /* Sticky mobile CTA */
  .adv3-sticky{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);padding:10px 14px 12px;display:flex;align-items:center;gap:10px;z-index:50;box-shadow:0 -4px 14px rgba(0,0,0,.06)}
  .adv3-sticky__txt{flex:1;font-size:12px;color:var(--ink-soft);line-height:1.3}
  .adv3-sticky__txt b{display:block;color:var(--ink);font-weight:700;font-size:13px}
  .adv3-sticky__cta{padding:11px 16px;background:var(--brand);color:#fff !important;font-weight:700;font-size:12.5px;letter-spacing:.04em;text-transform:uppercase;border-radius:2px;text-decoration:none;flex:0 0 auto}
  body.adv3-has-sticky{padding-bottom:74px}
  @media(min-width:760px){.adv3-sticky{display:none}body.adv3-has-sticky{padding-bottom:0}}

  /* Compliance asterisks */
  .adv3-ast{color:var(--accent);font-weight:700;font-size:.85em;vertical-align:.3em;margin-left:1px}

  /* Inline jump CTA */
  .adv3-jump{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:22px 0 26px;padding:14px 18px;background:var(--brand);color:#fff !important;text-decoration:none;border-radius:4px;font-weight:700;font-size:14px;letter-spacing:.02em;line-height:1.3;transition:background .2s}
  .adv3-jump:hover{background:var(--brand-deep);color:#fff}
  .adv3-jump__lbl{flex:1}
  .adv3-jump__lbl small{display:block;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;opacity:.8;margin-bottom:2px}
  .adv3-jump__arrow{font-size:18px;flex:0 0 auto}

  /* 3-mechanism cards (How it works) */
  .adv3-mech{display:grid;gap:10px;margin:18px 0 14px}
  .adv3-mech__card{border-radius:6px;padding:22px 20px;position:relative;overflow:hidden}
  .adv3-mech__card:nth-of-type(1){background:var(--accent-tint)}
  .adv3-mech__card:nth-of-type(2){background:var(--brand-tint)}
  .adv3-mech__card:nth-of-type(3){background:#e6f0ec}
  .adv3-mech__ico{width:36px;height:36px;display:block;margin-bottom:10px;color:var(--ink)}
  .adv3-mech__num{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:4px;opacity:.7}
  .adv3-mech__h{font-size:19px;font-weight:700;color:var(--ink);margin:0 0 6px;letter-spacing:-.015em;line-height:1.2}
  .adv3-mech__p{font-size:14.5px;color:var(--ink);line-height:1.5;margin:0;opacity:.85}
  .adv3-mech__cap{font-size:11.5px;color:var(--muted);text-align:center;letter-spacing:.06em;text-transform:uppercase;font-weight:600;margin:0 0 24px}
  @media (min-width:560px){.adv3-mech{grid-template-columns:repeat(3,1fr);gap:12px}}

  /* Featured (big) review */
  .adv3-rev--feature{padding:20px;background:#fff;border:2px solid var(--accent);border-radius:6px;margin:0 0 12px}
  .adv3-rev--feature .adv3-rev__stars{font-size:14px;letter-spacing:2px;margin-bottom:8px}
  .adv3-rev--feature .adv3-rev__txt{font-size:18px;line-height:1.5;font-style:italic;color:var(--ink);margin:0 0 10px}
  .adv3-rev--feature .adv3-rev__name{font-size:13px}

  /* Pull-quote review grid */
  .adv3-rev-grid{display:grid;gap:10px;margin:0 0 24px}
  .adv3-rev-card{border-radius:6px;padding:20px 18px;display:flex;flex-direction:column;justify-content:space-between;min-height:140px}
  .adv3-rev-card:nth-of-type(1){background:var(--accent-tint)}
  .adv3-rev-card:nth-of-type(2){background:var(--brand-tint)}
  .adv3-rev-card:nth-of-type(3){background:#e6f0ec}
  .adv3-rev-card__stars{color:var(--accent);font-size:13px;letter-spacing:2px;margin-bottom:8px}
  .adv3-rev-card__q{font-size:17px;line-height:1.35;color:var(--ink);font-weight:600;letter-spacing:-.01em;margin:0 0 12px}
  .adv3-rev-card__name{font-size:12px;color:var(--ink-soft);font-weight:600}
  .adv3-rev-card__name b{color:var(--ink);font-weight:700}
  @media (min-width:560px){.adv3-rev-grid{grid-template-columns:repeat(3,1fr);gap:12px}}

  /* Buy block product image */
  .adv3-buy__img{display:block;width:200px;height:auto;max-height:240px;margin:0 auto 8px;object-fit:contain}
</style>

<div class="adv3">

  <!-- ARTICLE HEADER -->
  <article class="wrap adv3-art">
    <div class="adv3-cat">Inside WLP-1</div>
    <h1 class="adv3-h1">Hollywood has had their secret advantage for years. <em>Now here's yours.</em></h1>
    <p class="adv3-deck">WLP-1 targets the same biology as a GLP-1 injection. Three patented extracts. Formulated for absorption. No prescription, no needles.</p>
    <div class="adv3-meta">
      <span>By <b>The Absorption Company</b></span>
      <span class="adv3-meta__dot"></span>
      <span>{{ pub_date }}</span>
      <span class="adv3-meta__read">4 min read</span>
    </div>

    <!-- LEAD IMAGE -->
    <figure class="adv3-lead">
      <img src="{{ hero_img }}" alt="Ian Somerhalder, actor and co-founder of The Absorption Company" loading="eager">
      <figcaption class="adv3-lead__cap"><b>Ian Somerhalder</b>, actor and co-founder of The Absorption Company.</figcaption>
    </figure>

    <!-- BODY -->
    <div class="adv3-body">

      <p class="lead">If you've watched Hollywood get visibly leaner over the last two years and quietly wondered how, you're not imagining it.</p>

      <p>It's not genetics. It's not willpower. It's not a new trainer.</p>

      <p><b>It's the Hollywood secret that's been quietly running on a private network of doctors, prescriptions, and chefs for years.</b></p>

      <p>Working actors have had a head start on GLP-1 injections since long before the rest of the country knew the term. Hundreds a month for the medication. Thousands more for the doctors and chefs around it.</p>

      <p>Most people will not have that. So we built the version that doesn't need any of it.</p>

      <a href="#buy" class="adv3-jump"><span class="adv3-jump__lbl"><small>See pricing</small>Try WLP-1 with up to 35% off</span><span class="adv3-jump__arrow">↓</span></a>

      <h2>What this is, and where it came from.</h2>

      <p><b>The Absorption Company</b> was founded in <b>2024</b> on a narrower mission than weight loss. On average, <b>only 16%</b> of supplements absorb at all. We rebuild that math.</p>

      <p>Our co-founder, actor <b>Ian Somerhalder</b>, made the case to apply that work to GLP-1 biology. <b>WLP-1</b> is what came out of it.</p>

      <h2>How it actually works.</h2>

      <p>Three patented plant extracts, formulated for absorption. Supporting your body's own GLP-1 signal on three things at once.</p>

