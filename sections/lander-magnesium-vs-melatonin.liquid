{%- comment -%} Magnesium Glycinate vs Melatonin advertorial lander. Educational, skeptic-friendly. Category critique of melatonin -> magnesium as the root-cause swap. Hero builds trust before product reveal. Buybox defaults to subscription via POST /cart/add (cart permalinks drop selling_plan on this theme). {%- endcomment -%}

{%- liquid
  assign variant_1 = section.settings.variant_1 | default: '52439421976865'
  assign variant_2 = section.settings.variant_2 | default: '52439422009633'
  assign variant_3 = section.settings.variant_3 | default: '52439422042401'
  assign sub_plan  = section.settings.sub_plan  | default: '691154485537'

  assign price_1_ot  = section.settings.price_1_ot  | default: '$28.00'
  assign price_1_sub = section.settings.price_1_sub | default: '$22.40'
  assign price_1_was = section.settings.price_1_was | default: '$28.00'

  assign price_2_ot  = section.settings.price_2_ot  | default: '$56.00'
  assign price_2_sub = section.settings.price_2_sub | default: '$44.80'
  assign price_2_was = section.settings.price_2_was | default: '$56.00'

  assign price_3_ot  = section.settings.price_3_ot  | default: '$84.00'
  assign price_3_sub = section.settings.price_3_sub | default: '$67.20'
  assign price_3_was = section.settings.price_3_was | default: '$84.00'

  assign hero_img    = section.settings.hero_img    | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/TAC_PDP-Image_Magnesium_fca66eba-7d7b-41d2-b6a1-9209fb90e380.png?v=1768241640'
  assign bundle_img  = section.settings.bundle_img  | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/magnesium-sleep-bundle.png'
  assign bundle_url  = section.settings.bundle_url  | default: '/products/magnesium-sleep-bundle'
  assign rating      = section.settings.rating      | default: '4.7'
  assign review_count = section.settings.review_count | default: '2,400+'
-%}

<style>
  .mvm{ --bg:#ffffff; --bg-soft:#f6f8ff; --bg-tint:#eef2ff; --paper:#fafbff; --ink:#0a1233; --ink-soft:#2a3260; --muted:#6b7390; --line:#dfe4f7; --line-soft:#ecf0fb; --brand:#4659FF; --brand-hover:#3a4ad9; --brand-deep:#2c39b3; --brand-tint:#e6e9ff; --accent:#FF7815; --accent-hover:#e76b0e; --accent-deep:#c25a0c; --accent-tint:#ffe9d6; --ink-deep:#080d24;
    background:var(--bg); color:var(--ink); -webkit-font-smoothing:antialiased; line-height:1.5; }
  .mvm *{box-sizing:border-box}
  .mvm img{max-width:100%;display:block}
  .mvm a{color:inherit;text-decoration:none}
  .mvm .wrap{max-width:1180px;margin:0 auto;padding:0 18px}
  .mvm .wrap-narrow{max-width:780px;margin:0 auto;padding:0 18px}

  /* TOP BAR */
  .mvm-bar{background:var(--ink-deep);color:#fff}
  .mvm-bar__row{display:flex;align-items:center;justify-content:center;gap:10px;padding:10px 14px;font-size:13px;text-align:center;line-height:1.3}
  .mvm-bar__lead{font-weight:700;letter-spacing:.04em;text-transform:uppercase}
  .mvm-bar__lead em{font-style:normal;color:var(--accent);font-weight:700}
  @media(max-width:480px){.mvm-bar__row{font-size:12px;gap:6px}}

  /* HERO */
  .mvm-hero{background:linear-gradient(180deg,var(--bg) 0%,var(--bg-soft) 100%);padding:32px 0 44px;border-bottom:1px solid var(--line-soft)}
  .mvm-hero__grid{display:grid;grid-template-columns:1fr;gap:22px;align-items:center}
  @media(min-width:880px){.mvm-hero__grid{grid-template-columns:1.1fr .9fr;gap:48px}}
  @media(max-width:879px){.mvm-hero{padding:18px 0 28px}.mvm-hero__grid{gap:18px}}
  .mvm-hero__eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;margin-bottom:14px}
  .mvm-hero__eyebrow::before{content:"";width:6px;height:6px;background:var(--accent);border-radius:50%;display:inline-block}
  .mvm-hero h1{font-size:clamp(30px,5.4vw,48px);line-height:1.04;letter-spacing:-.035em;font-weight:800;margin:0 0 14px;color:var(--ink-deep)}
  .mvm-hero h1 em{font-style:normal;color:var(--brand)}
  .mvm-hero h1 .strike{text-decoration:line-through;text-decoration-thickness:3px;text-decoration-color:var(--accent);color:var(--ink-soft);font-weight:700}
  .mvm-hero__sub{font-size:clamp(15px,2vw,18px);max-width:560px;margin:0 0 20px;color:var(--ink-soft);line-height:1.55}
  .mvm-hero__sub b{color:var(--ink);font-weight:600}
  .mvm-hero__bullets{list-style:none;padding:0;margin:0 0 22px;display:grid;gap:10px;max-width:560px}
  .mvm-hero__bullets li{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--ink);line-height:1.4}
  .mvm-hero__bullets li strong{font-weight:700;color:var(--ink-deep)}
  .mvm-hero__bullets li svg{width:20px;height:20px;flex:0 0 auto;color:var(--brand);margin-top:2px}
  .mvm-hero__cta{display:inline-flex;align-items:center;justify-content:center;width:100%;max-width:440px;padding:16px 30px;background:var(--brand);color:#fff !important;font-weight:600;font-size:15px;border-radius:2px;transition:background .2s}
  .mvm-hero__cta:hover{background:var(--brand-hover)}
  .mvm-hero__cta:after{content:" →";margin-left:10px}
  .mvm-hero__guarantee{display:flex;align-items:center;gap:8px;margin-top:14px;font-size:13px;color:var(--ink-soft)}
  .mvm-hero__guarantee svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}
  .mvm-hero__media{position:relative;text-align:center}
  .mvm-hero__card{background:var(--bg-soft);border-radius:12px;padding:24px;position:relative;width:100%;max-width:420px;margin:0 auto;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;border:1px solid var(--line)}
  .mvm-hero__card img{max-width:86%;max-height:86%;object-fit:contain}
  .mvm-hero__badge{position:absolute;top:-28px;right:-12px;background:var(--accent);color:#fff;border-radius:999px;width:116px;height:116px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:700;line-height:1;transform:rotate(-8deg);border:4px solid var(--bg);box-shadow:0 10px 22px rgba(8,13,36,.24)}
  .mvm-hero__badge big{font-size:30px}
  .mvm-hero__badge span{font-size:10px;text-transform:uppercase;letter-spacing:.1em;margin-top:4px;font-weight:700}
  @media(max-width:760px){.mvm-hero__badge{top:-22px;right:6px;width:96px;height:96px}.mvm-hero__badge big{font-size:24px}}

  /* 3 USPs (replaces trust strip) */
  .mvm-usp{background:#fff;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:18px 0}
  .mvm-usp__row{display:grid;grid-template-columns:1fr;gap:14px;text-align:center;font-size:14px;font-weight:500;color:var(--ink-deep);align-items:center;justify-items:center}
  @media(min-width:720px){.mvm-usp__row{grid-template-columns:1fr 1px 1fr 1px 1fr;gap:0}}
  .mvm-usp__cell{display:flex;align-items:center;gap:10px;padding:0 12px}
  .mvm-usp__cell svg{width:24px;height:24px;color:var(--ink-deep);flex:0 0 auto}
  @media(min-width:720px){.mvm-usp__row::after,.mvm-usp__row::before{content:""}}
  .mvm-usp__row > .mvm-usp__cell + .mvm-usp__cell{position:relative}
  @media(min-width:720px){
    .mvm-usp__row{grid-template-columns:repeat(3,1fr)}
    .mvm-usp__row > .mvm-usp__cell + .mvm-usp__cell::before{content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);width:1px;height:24px;background:var(--line)}
  }
  .mvm-stars5:before{content:"★★★★★";color:var(--accent);letter-spacing:1px}

  /* SECTION BASE */
  .mvm-sec{padding:56px 0}
  .mvm-sec--blue{background:var(--bg-tint)}
  .mvm-sec--soft{background:var(--bg-soft)}
  .mvm-sec--ink{background:var(--ink-deep);color:#fff}
  .mvm-sec--ink h2,.mvm-sec--ink h3{color:#fff}
  .mvm-sec__eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.24em;font-weight:700;color:var(--ink);margin:0 0 12px;display:inline-flex;align-items:center;gap:10px}
  .mvm-sec__eyebrow::before{content:"";width:6px;height:6px;background:var(--brand);border-radius:50%;display:inline-block}
  .mvm-sec--ink .mvm-sec__eyebrow{color:rgba(255,255,255,.85)}
  .mvm-sec--ink .mvm-sec__eyebrow::before{background:var(--accent)}
  .mvm-sec__title{font-size:clamp(26px,4.4vw,38px);font-weight:800;letter-spacing:-.035em;color:var(--ink-deep);margin:0 0 12px;line-height:1.07}
  .mvm-sec__title em{font-style:normal;color:var(--brand)}
  .mvm-sec--ink .mvm-sec__title{color:#fff}
  .mvm-sec--ink .mvm-sec__title em{color:var(--accent)}
  .mvm-sec__sub{font-size:16px;color:var(--ink-soft);max-width:720px;margin:0 0 28px;line-height:1.6}
  .mvm-sec--ink .mvm-sec__sub{color:rgba(255,255,255,.82)}
  .mvm .center{text-align:center}
  .mvm .center .mvm-sec__sub{margin-left:auto;margin-right:auto}

  /* MELATONIN PROBLEM CARDS */
  .mvm-mel{display:grid;grid-template-columns:1fr;gap:14px;margin-top:8px}
  @media(min-width:760px){.mvm-mel{grid-template-columns:repeat(2,1fr)}}
  .mvm-mel__card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px}
  .mvm-mel__card-h{font-size:17px;font-weight:800;color:var(--ink-deep);margin:0 0 8px;letter-spacing:-.01em;display:flex;align-items:center;gap:10px}
  .mvm-mel__card-h svg{width:22px;height:22px;color:var(--accent);flex:0 0 auto}
  .mvm-mel__card-p{font-size:14.5px;color:var(--ink-soft);line-height:1.55;margin:0}

  /* SPLIT CARD (Melatonin vs Magnesium visual — light cards w/ contrasting eyebrows) */
  .mvm-split{display:grid;grid-template-columns:1fr;gap:14px;margin:0 0 24px}
  @media(min-width:760px){.mvm-split{grid-template-columns:1fr 1fr;gap:18px}}
  .mvm-split__card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:26px 24px;display:flex;flex-direction:column;position:relative}
  .mvm-split__card--mag{border-color:var(--brand);box-shadow:0 4px 24px rgba(70,89,255,.10)}
  .mvm-split__lbl{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;padding:5px 10px;border-radius:999px;margin-bottom:18px;width:fit-content}
  .mvm-split__card--mel .mvm-split__lbl{background:#f1f2f7;color:var(--muted)}
  .mvm-split__card--mag .mvm-split__lbl{background:var(--brand-tint);color:var(--brand-deep)}
  .mvm-split__lbl::before{content:"";width:6px;height:6px;border-radius:50%;display:inline-block}
  .mvm-split__card--mel .mvm-split__lbl::before{background:var(--muted)}
  .mvm-split__card--mag .mvm-split__lbl::before{background:var(--brand)}
  .mvm-split__h{font-size:clamp(20px,2.8vw,26px);font-weight:800;letter-spacing:-.02em;line-height:1.15;margin:0 0 18px;color:var(--ink-deep)}
  .mvm-split__card--mel .mvm-split__h{color:var(--ink-soft)}
  .mvm-split__list{list-style:none;padding:0;margin:0;display:grid;gap:10px;flex:1}
  .mvm-split__list li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;line-height:1.45;color:var(--ink);font-weight:500}
  .mvm-split__list li svg{width:18px;height:18px;flex:0 0 auto;margin-top:2px}
  .mvm-split__card--mel li svg{color:var(--muted)}
  .mvm-split__card--mag li svg{color:var(--brand)}
  .mvm-split__card--mel li{color:var(--ink-soft)}
  .mvm-split__card--mag li b{color:var(--ink-deep);font-weight:700}

  /* STAT TRIO */
  .mvm-stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  @media(max-width:600px){.mvm-stat-row{grid-template-columns:1fr;gap:8px}}
  .mvm-stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:24px 18px;text-align:left}
  .mvm-stat__lbl{font-size:13px;font-weight:700;color:var(--ink-deep);margin:0 0 10px;letter-spacing:-.005em;line-height:1.3}
  .mvm-stat__num{font-size:clamp(36px,5vw,48px);font-weight:800;color:var(--brand);letter-spacing:-.035em;line-height:1;margin:0 0 8px;display:flex;align-items:baseline;gap:2px}
  .mvm-stat__num sup,.mvm-stat__num small{font-size:.5em;color:var(--brand);font-weight:800;letter-spacing:-.02em}
  .mvm-stat__sub{font-size:12.5px;color:var(--ink-soft);margin:0;line-height:1.45}

  /* 300+ FUNCTIONS BLOCK */
  .mvm-fx{display:grid;grid-template-columns:1fr;gap:32px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:14px;padding:36px;overflow:hidden}
  @media(min-width:880px){.mvm-fx{grid-template-columns:.9fr 1.1fr;gap:48px;padding:48px}}
  .mvm-fx__media{background:var(--bg-soft);border-radius:12px;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid var(--line-soft);position:relative}
  .mvm-fx__media img{max-width:78%;max-height:78%;object-fit:contain;transform:rotate(-6deg)}
  .mvm-fx__h{font-size:clamp(28px,4vw,40px);font-weight:800;color:var(--ink-deep);margin:0 0 14px;letter-spacing:-.035em;line-height:1.05}
  .mvm-fx__h em{font-style:normal;color:var(--brand)}
  .mvm-fx__sub{font-size:15.5px;color:var(--ink-soft);margin:0 0 24px;line-height:1.55}
  .mvm-fx__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  @media(min-width:480px) and (max-width:879px){.mvm-fx__grid{grid-template-columns:repeat(3,1fr)}}
  .mvm-fx__pill{display:flex;align-items:center;gap:10px;background:var(--bg-soft);border:1px solid var(--line-soft);border-radius:10px;padding:12px 14px;font-size:14px;font-weight:600;color:var(--ink-deep);line-height:1.2}
  .mvm-fx__pill svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}
  .mvm-fx__note{font-size:11px;color:var(--muted);margin:14px 0 0;line-height:1.4}

  /* COMPARISON TABLE */
  .mvm-comp{background:#fff;border-radius:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--line);font-size:14px;margin-top:8px}
  .mvm-comp table{width:100%;border-collapse:collapse;min-width:520px}
  .mvm-comp th,.mvm-comp td{padding:14px 12px;text-align:center;border-bottom:1px solid var(--line-soft);vertical-align:middle}
  .mvm-comp thead th{background:var(--ink-deep);color:#fff;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.14em}
  .mvm-comp thead th:first-child{text-align:left}
  .mvm-comp thead th.mag-col{background:var(--brand);color:#fff;font-size:13px;letter-spacing:.04em}
  .mvm-comp tbody td:first-child{text-align:left;font-weight:600;color:var(--ink);background:var(--paper)}
  .mvm-comp .yes{color:var(--brand-deep);font-weight:700}
  .mvm-comp .no{color:var(--muted);font-weight:500}
  .mvm-comp tbody td.mag-col{background:var(--brand-tint);font-weight:600;border-left:1px solid var(--brand);border-right:1px solid var(--brand)}
  .mvm-comp tbody tr:last-child td.mag-col{border-bottom:1px solid var(--brand)}

  /* BENEFITS GRID */
  .mvm-bens{display:grid;grid-template-columns:repeat(1,1fr);gap:12px;margin-top:10px}
  @media(min-width:600px){.mvm-bens{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:900px){.mvm-bens{grid-template-columns:repeat(3,1fr)}}
  .mvm-ben{background:#fff;border:1px solid var(--line);border-radius:10px;padding:22px;text-align:left}
  .mvm-ben__ico{width:42px;height:42px;border-radius:10px;background:var(--brand-tint);color:var(--brand-deep);display:flex;align-items:center;justify-content:center;margin:0 0 12px}
  .mvm-ben__ico svg{width:24px;height:24px}
  .mvm-ben__h{font-size:16px;font-weight:800;color:var(--ink-deep);margin:0 0 6px;letter-spacing:-.01em}
  .mvm-ben__p{font-size:14px;color:var(--ink-soft);line-height:1.55;margin:0}

  /* ABSORPTION STAT BLOCK */
  .mvm-abs{background:#fff;border:1px solid var(--line);border-radius:12px;padding:32px;margin-top:8px}
  .mvm-abs__grid{display:grid;grid-template-columns:1fr;gap:24px;align-items:center}
  @media(min-width:760px){.mvm-abs__grid{grid-template-columns:1fr 1fr}}
  .mvm-abs__num{font-size:clamp(56px,10vw,96px);font-weight:800;color:var(--brand);letter-spacing:-.04em;line-height:1;margin:0 0 6px}
  .mvm-abs__num sup{font-size:.4em;color:var(--ink-soft);margin-left:2px}
  .mvm-abs__lbl{font-size:14px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.12em;margin:0 0 6px}
  .mvm-abs__p{font-size:15px;color:var(--ink-soft);line-height:1.6;margin:0}
  .mvm-abs__bars{display:grid;gap:14px}
  .mvm-abs__bar{display:grid;grid-template-columns:120px 1fr 50px;gap:10px;align-items:center;font-size:13px;color:var(--ink-soft);font-weight:600}
  .mvm-abs__bar-name{text-align:right}
  .mvm-abs__bar-name b{display:block;color:var(--ink-deep);font-weight:700;font-size:13px}
  .mvm-abs__bar-track{background:var(--line-soft);border-radius:999px;height:14px;overflow:hidden}
  .mvm-abs__bar-fill{height:100%;background:var(--brand);border-radius:999px}
  .mvm-abs__bar-fill--low{background:var(--muted)}
  .mvm-abs__bar-fill--mid{background:var(--ink-soft)}
  .mvm-abs__bar-pct{text-align:left;font-weight:800;color:var(--ink-deep)}

  /* CLINICIAN REVIEW */
  .mvm-clin{max-width:820px;margin:0 auto;background:#fff;border:1px solid var(--line);border-radius:12px;padding:32px;position:relative}
  .mvm-clin__badge{display:inline-flex;align-items:center;gap:8px;background:var(--brand-tint);color:var(--brand-deep);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.16em;padding:6px 12px;border-radius:999px;margin-bottom:18px}
  .mvm-clin__badge svg{width:14px;height:14px}
  .mvm-clin__h{font-size:22px;font-weight:800;color:var(--ink-deep);margin:0 0 14px;letter-spacing:-.015em;line-height:1.25}
  .mvm-clin__q{font-size:15.5px;color:var(--ink-soft);line-height:1.65;margin:0 0 14px;font-style:italic}
  .mvm-clin__q b{color:var(--ink-deep);font-style:normal;font-weight:700}
  .mvm-clin__tags{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 20px}
  .mvm-clin__tag{font-size:11px;font-weight:700;color:var(--brand-deep);background:var(--brand-tint);padding:5px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.06em}
  .mvm-clin__attr{display:flex;align-items:center;gap:14px;padding-top:18px;border-top:1px solid var(--line)}
  .mvm-clin__avatar{width:54px;height:54px;border-radius:50%;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;letter-spacing:-.02em;flex:0 0 auto}
  .mvm-clin__attr-meta{font-size:14px;line-height:1.3}
  .mvm-clin__attr-meta b{display:block;color:var(--ink-deep);font-weight:800;font-size:15px}
  .mvm-clin__attr-meta span{color:var(--ink-soft);font-size:13px}

  /* BUYBOX */
  .mvm-buy{background:#fff;border:1px solid var(--line);border-radius:12px;padding:26px;max-width:560px;margin:0 auto;box-shadow:0 6px 30px rgba(70,89,255,.06)}
  .mvm-buy__head{display:flex;gap:16px;align-items:center;margin:0 0 18px}
  .mvm-buy__thumb{width:80px;height:80px;background:var(--bg-soft);border:1px solid var(--line-soft);border-radius:10px;padding:8px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
  .mvm-buy__thumb img{max-width:100%;max-height:100%;object-fit:contain}
  .mvm-buy__head-text h3{font-size:22px;font-weight:800;color:var(--ink-deep);margin:0 0 4px;letter-spacing:-.02em;line-height:1.15}
  .mvm-buy__head-text p{font-size:13px;color:var(--ink-soft);margin:0;line-height:1.4}
  .mvm-buy__stars{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink-soft);margin:0 0 18px}
  .mvm-buy__sub-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.24em;color:var(--ink);margin:0 0 12px}
  .mvm-opts{display:grid;gap:10px;margin:0 0 18px}
  .mvm-opt{display:block;border:1.5px solid var(--line);border-radius:10px;padding:16px;cursor:pointer;background:var(--paper);position:relative;transition:border-color .15s, background .15s}
  .mvm-opt input{position:absolute;opacity:0;pointer-events:none}
  .mvm-opt__top{display:flex;align-items:flex-start;gap:12px}
