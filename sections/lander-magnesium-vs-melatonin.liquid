<script>
(function(){
  var root = document.querySelector('.mvm');
  if(!root) return;
  var form = root.querySelector('[data-buyform]');
  if(!form) return;

  var subPlanId = {{ sub_plan | json }};
  var variants  = {
    '1': {{ variant_1 | json }},
    '2': {{ variant_2 | json }},
    '3': {{ variant_3 | json }}
  };
  var prices = {
    '1': { sub: {{ price_1_sub | json }}, ot: {{ price_1_ot | json }} },
    '2': { sub: {{ price_2_sub | json }}, ot: {{ price_2_ot | json }} },
    '3': { sub: {{ price_3_sub | json }}, ot: {{ price_3_ot | json }} }
  };

  var variantInput = form.querySelector('[data-variant-id]');
  var planInput    = form.querySelector('[data-selling-plan]');
  var ctaPrice     = form.querySelector('[data-cta-price]');

  var stickyPrice  = document.querySelector('[data-sticky-price]');
  var stickyLabel  = document.querySelector('[data-sticky-label]');
  var stickyVar    = document.querySelector('[data-sticky-variant]');
  var stickyPlan   = document.querySelector('[data-sticky-plan]');

  function sync(){
    var sizeEl = form.querySelector('input[name="size"]:checked');
    var planEl = form.querySelector('input[name="plan"]:checked');
    var size = sizeEl ? sizeEl.value : '3';
    var plan = planEl ? planEl.value : 'sub';
    variantInput.value = variants[size];
    planInput.value    = plan === 'sub' ? subPlanId : '';
    var price = plan === 'sub' ? prices[size].sub : prices[size].ot;
    ctaPrice.textContent = price;

    // Update active visuals
    form.querySelectorAll('.mvm-opt').forEach(function(el){
      var input = el.querySelector('input[name="size"]');
      el.classList.toggle('is-on', input && input.checked);
    });
    form.querySelectorAll('.mvm-plan').forEach(function(el){
      var input = el.querySelector('input[name="plan"]');
      el.classList.toggle('is-on', input && input.checked);
    });

    // Sticky mirror
    if(stickyPrice){ stickyPrice.textContent = price; }
    if(stickyLabel){ stickyLabel.textContent = plan === 'sub' ? 'Subscribe · Save 20%' : 'One-time'; }
    if(stickyVar){ stickyVar.value = variants[size]; }
    if(stickyPlan){ stickyPlan.value = plan === 'sub' ? subPlanId : ''; }
  }
  form.addEventListener('change', sync);
  sync();
})();

(function(){
  var sticky = document.getElementById('mvmSticky');
  var buy = document.querySelector('[data-buybox]');
  if(!sticky || !buy) return;
  function onScroll(){
    if(window.innerWidth >= 880){ sticky.classList.remove('is-on'); return; }
    var y = window.scrollY || window.pageYOffset;
    var buyTop = buy.getBoundingClientRect().top + window.scrollY;
    if(y > 500 && y < buyTop - 200){ sticky.classList.add('is-on'); }
    else { sticky.classList.remove('is-on'); }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
})();

// Direct-to-checkout: POST /cart/add.js then redirect.
(function(){
  var root = document.querySelector('.mvm');
  if(!root) return;
  root.addEventListener('submit', function(e){
    var form = e.target;
    if(!form || form.tagName !== 'FORM') return;
    if((form.getAttribute('action') || '') !== '/cart/add') return;
    e.preventDefault();
    var btn = form.querySelector('button[type="submit"]');
    if(btn){ btn.disabled = true; var orig = btn.innerHTML; btn.innerHTML = 'Adding...'; setTimeout(function(){ if(btn){ btn.innerHTML = orig; btn.disabled = false; } }, 4000); }
    var fd = new FormData(form);
    // Strip empty selling_plan so one-time goes through cleanly
    if(!fd.get('selling_plan')){ fd.delete('selling_plan'); }
    fetch('/cart/add.js', { method:'POST', body: fd, headers: { 'Accept': 'application/json' } })
      .then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); })
      .then(function(){ window.location.href = '/checkout'; })
      .catch(function(){ form.submit(); });
  });
})();
</script>

