  assign save_3mo     = section.settings.save_3mo     | default: 'Save 30%'

  assign v_6mo        = section.settings.v_6mo        | default: '52472821186849'
  assign p_6mo        = section.settings.p_6mo        | default: '691166544161'
  assign price_6mo    = section.settings.price_6mo    | default: '$64.35'
  assign was_6mo      = section.settings.was_6mo      | default: '$99.00'
  assign total_6mo    = section.settings.total_6mo    | default: '$386.10 total'
  assign save_6mo     = section.settings.save_6mo     | default: 'Save 35%'

  assign h1_text      = section.settings.h1_text      | default: 'The 90-day off-ramp from <em>GLP-1 injections</em>.'
  assign sub_text     = section.settings.sub_text     | default: 'A daily oral capsule that supports your body’s own GLP-1, so you can taper off the shot without bouncing back to where you started.'
  assign eyebrow_text = section.settings.eyebrow_text | default: 'For people coming off GLP-1 injections'

  assign rating       = section.settings.rating       | default: '4.8'
