  assign featured_name   = section.settings.featured_name   | default: 'Jessica N.'
  assign featured_title  = section.settings.featured_title  | default: 'Verified Customer · WLP-1'
-%}

<style>
  .ofd7 { --bg:#ffffff; --bg-soft:#f7f8ff; --bg-tint:#eef0ff; --paper:#fafbff; --ink:#0d1130; --ink-soft:#3a3f5e; --muted:#6a708e; --line:#dde0f3; --line-soft:#ebedf8; --brand:#4659FF; --brand-hover:#3142d1; --brand-deep:#2231a8; --brand-tint:#e6e9ff; --accent:#FF7815; --accent-hover:#e76b0e; --green:#3EA193; --green-deep:#2d7268; --green-tint:#e1f2ee; --ink-deep:#080d24; --red:#E1225C; --red-soft:#ff406f; --gold:#FFB237;
    background:var(--bg); color:var(--ink); -webkit-font-smoothing:antialiased; line-height:1.5; }
  .ofd7 *{box-sizing:border-box}
  .ofd7 img{max-width:100%;display:block;height:auto}
  .ofd7 a{color:inherit;text-decoration:none}
  .ofd7 .wrap{max-width:1120px;margin:0 auto;padding:0 18px}
  .ofd7 .wrap-narrow{max-width:760px;margin:0 auto;padding:0 18px}

  /* HERO */
  .ofd7-hero{background:linear-gradient(180deg,var(--bg) 0%,var(--bg-soft) 100%);padding:30px 0 40px;border-bottom:1px solid var(--line-soft);position:relative}
  .ofd7-hero__grid{display:grid;grid-template-columns:1fr;gap:22px;align-items:center}
  @media(min-width:880px){.ofd7-hero__grid{grid-template-columns:1.05fr .95fr;gap:48px;padding:14px 0}}
  .ofd7-hero__eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;margin-bottom:16px}
  .ofd7-hero__eyebrow::before{content:"";width:6px;height:6px;background:var(--brand);border-radius:50%;display:inline-block}
  .ofd7-hero h1{font-size:clamp(30px,5.6vw,50px);line-height:1.02;letter-spacing:-.035em;font-weight:800;margin:0 0 14px;color:var(--ink-deep)}
  .ofd7-hero h1 em{font-style:normal;color:var(--brand)}
  .ofd7-hero__sub{font-size:clamp(15px,2vw,18px);max-width:540px;margin:0 0 18px;color:var(--ink-soft);line-height:1.5}
  .ofd7-hero__sub b{color:var(--ink);font-weight:600}
  .ofd7-hero__bullets{list-style:none;padding:0;margin:0 0 22px;display:grid;gap:9px;max-width:560px}
  .ofd7-hero__bullets li{display:flex;align-items:flex-start;gap:10px;font-size:15px;font-weight:500;color:var(--ink);line-height:1.45}
  .ofd7-hero__bullets li svg{width:20px;height:20px;flex:0 0 auto;color:var(--brand);margin-top:2px}
  .ofd7-hero__bullets li b{color:var(--ink-deep);font-weight:700}
  .ofd7-hero__cta{display:inline-flex;align-items:center;justify-content:center;width:100%;max-width:440px;padding:16px 30px;background:var(--brand);color:#fff !important;font-weight:600;font-size:15px;letter-spacing:.01em;border-radius:2px;border:none;cursor:pointer;text-decoration:none;transition:background .2s}
  .ofd7-hero__cta:hover{background:var(--brand-hover);color:#fff !important}
  .ofd7-hero__cta:after{content:" →";margin-left:10px}
  .ofd7-hero__rating{display:flex;align-items:center;gap:10px;margin:14px 0 0;font-size:13px;color:var(--ink-soft);flex-wrap:wrap}
  .ofd7-hero__stars{color:var(--accent);letter-spacing:2px;font-size:14px}
  .ofd7-hero__rating b{color:var(--ink-deep);font-weight:700}
  .ofd7-hero__media{position:relative;text-align:center}
  .ofd7-hero__card{background:var(--bg-soft);border-radius:8px;width:100%;max-width:440px;margin:0 auto;aspect-ratio:1/1;border:1px solid var(--line);overflow:hidden;padding:18px;display:flex;align-items:center;justify-content:center}
  .ofd7-hero__card img{width:100%;height:100%;object-fit:contain}
  .ofd7-hero__badge{position:absolute;top:-10px;right:14px;background:var(--accent);color:#fff;border-radius:999px;width:96px;height:96px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:800;line-height:1;transform:rotate(-8deg);border:3px solid #fff;box-shadow:0 6px 14px rgba(8,13,36,.18)}
  .ofd7-hero__badge big{font-size:22px;letter-spacing:-.01em}
  .ofd7-hero__badge span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-top:2px}
  .ofd7-hero__chip{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:#fff;color:var(--ink-deep);border:1px solid var(--line);border-radius:999px;padding:9px 18px;font-size:12px;font-weight:700;letter-spacing:.04em;line-height:1;box-shadow:0 6px 16px rgba(8,13,36,.12);white-space:nowrap;display:inline-flex;align-items:center;gap:8px}
  .ofd7-hero__chip::before{content:"";width:6px;height:6px;background:var(--brand);border-radius:50%;flex:0 0 auto}
  @media(max-width:879px){.ofd7-hero__card{max-width:340px}.ofd7-hero__badge{top:-6px;right:6px;width:80px;height:80px}.ofd7-hero__badge big{font-size:18px}.ofd7-hero__chip{font-size:11px;padding:8px 14px;bottom:10px}}

  /* TRUST STRIP */
  .ofd7-trust{background:var(--bg-soft);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:14px 0}
  .ofd7-trust__row{display:grid;grid-template-columns:1fr;gap:10px 16px;font-size:13px;font-weight:500;color:var(--ink)}
  @media(min-width:520px){.ofd7-trust__row{grid-template-columns:1fr 1fr;text-align:center}}
  @media(min-width:720px){.ofd7-trust__row{grid-template-columns:repeat(4,1fr)}}
  .ofd7-trust__cell{display:flex;align-items:center;justify-content:flex-start;gap:8px}
  @media(min-width:520px){.ofd7-trust__cell{justify-content:center}}
  .ofd7-trust__cell svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}

  /* SECTION BASE */
  .ofd7-sec{padding:54px 0}
  .ofd7-sec--soft{background:var(--bg-soft)}
  .ofd7-sec--tint{background:var(--bg-tint)}
  .ofd7-sec--ink{background:var(--ink-deep);color:#fff}
  .ofd7-sec--ink h2,.ofd7-sec--ink h3{color:#fff}
  .ofd7-sec__eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.24em;font-weight:700;color:var(--ink);margin:0 0 12px;display:inline-flex;align-items:center;gap:10px}
  .ofd7-sec__eyebrow::before{content:"";width:6px;height:6px;background:var(--brand);border-radius:50%;display:inline-block}
  .ofd7-sec--ink .ofd7-sec__eyebrow{color:rgba(255,255,255,.85)}
  .ofd7-sec--ink .ofd7-sec__eyebrow::before{background:var(--accent)}
  .ofd7-sec__title{font-size:clamp(26px,4.5vw,40px);font-weight:800;letter-spacing:-.035em;color:var(--ink-deep);margin:0 0 12px;line-height:1.05}
  .ofd7-sec--ink .ofd7-sec__title{color:#fff}
  .ofd7-sec__title em{font-style:normal;color:var(--brand)}
  .ofd7-sec--ink .ofd7-sec__title em{color:var(--accent)}
  .ofd7-sec__sub{font-size:16px;color:var(--ink-soft);max-width:680px;margin:0 0 28px;line-height:1.6}
  .ofd7-sec--ink .ofd7-sec__sub{color:rgba(255,255,255,.82)}

  /* INLINE ANCHOR CTA */
  .ofd7-anchor{display:flex;justify-content:center;margin-top:34px}
  .ofd7-anchor a{display:inline-flex;align-items:center;justify-content:center;width:100%;max-width:380px;padding:16px 26px;background:var(--brand);color:#fff !important;font-weight:700;font-size:15px;letter-spacing:.01em;border-radius:2px;text-decoration:none;transition:background .2s}
  .ofd7-anchor a:hover{background:var(--brand-hover);color:#fff !important}
  .ofd7-anchor a:after{content:" →";margin-left:10px}
  .ofd7-sec--ink .ofd7-anchor a{background:var(--accent);color:#fff !important}
  .ofd7-sec--ink .ofd7-anchor a:hover{background:var(--accent-hover);color:#fff !important}

  /* LEDE — problem→answer 1+1 block (bullets) */
  .ofd7-lede{display:grid;grid-template-columns:1fr;gap:18px;max-width:980px;margin:0 auto}
  @media(min-width:760px){.ofd7-lede{grid-template-columns:1fr auto 1fr;align-items:stretch;gap:16px}}
  .ofd7-lede__card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:26px 22px;position:relative;display:flex;flex-direction:column}
  .ofd7-lede__card--prob{border-left:4px solid var(--red)}
  .ofd7-lede__card--ans{border-left:4px solid var(--brand);background:var(--paper)}
  .ofd7-lede__label{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--muted);margin:0 0 10px}
  .ofd7-lede__card--prob .ofd7-lede__label{color:var(--red)}
  .ofd7-lede__card--ans .ofd7-lede__label{color:var(--brand)}
  .ofd7-lede__h{font-size:clamp(20px,3.2vw,26px);font-weight:800;line-height:1.15;letter-spacing:-.02em;color:var(--ink-deep);margin:0 0 14px}
  .ofd7-lede__list{list-style:none;padding:0;margin:0;display:grid;gap:10px}
  .ofd7-lede__list li{display:flex;align-items:flex-start;gap:10px;font-size:15px;line-height:1.45;color:var(--ink)}
  .ofd7-lede__list li svg{width:18px;height:18px;flex:0 0 auto;margin-top:2px}
  .ofd7-lede__card--prob .ofd7-lede__list li svg{color:var(--red)}
  .ofd7-lede__card--ans .ofd7-lede__list li svg{color:var(--brand)}
  .ofd7-lede__list li b{color:var(--ink-deep);font-weight:700}
  .ofd7-lede__arrow{display:flex;align-items:center;justify-content:center;color:var(--brand)}
  .ofd7-lede__arrow svg{width:42px;height:42px}
  @media(max-width:759px){.ofd7-lede__arrow{transform:rotate(90deg);padding:4px 0}.ofd7-lede__arrow svg{width:32px;height:32px}}

  /* 3-AREA SECTION (dark) */
  .ofd7-three{display:grid;grid-template-columns:1fr;gap:14px;max-width:980px;margin:0 auto}
  @media(min-width:760px){.ofd7-three{grid-template-columns:repeat(3,1fr)}}
  .ofd7-three__card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:24px 20px;position:relative}
  .ofd7-three__num{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--accent);margin:0 0 12px;display:flex;align-items:center;gap:8px}
  .ofd7-three__h{font-size:22px;font-weight:800;letter-spacing:-.02em;color:#fff;margin:0 0 8px;line-height:1.15}
  .ofd7-three__p{font-size:15px;line-height:1.5;color:rgba(255,255,255,.78);margin:0 0 12px}
  .ofd7-three__tag{font-size:12px;font-weight:700;color:#fff;background:var(--brand);display:inline-block;padding:5px 10px;border-radius:4px;letter-spacing:.02em}
  .ofd7-three__tag--shot{background:var(--red)}
  .ofd7-three__tag--no{background:rgba(255,255,255,.18);color:rgba(255,255,255,.7)}
  .ofd7-three__tag--all{background:var(--green)}
  .ofd7-three__sum{max-width:760px;margin:30px auto 0;text-align:center;padding:22px;background:rgba(255,255,255,.06);border-radius:10px}
  .ofd7-three__sum p{font-size:17px;line-height:1.5;color:#fff;margin:0;font-weight:600}
  .ofd7-three__sum p em{font-style:normal;color:var(--accent)}

  /* FEATURED TESTIMONIAL (distinct, large, gold-accent band) */
  .ofd7-feat{background:linear-gradient(135deg, var(--ink-deep) 0%, #131830 100%);padding:64px 0;position:relative;overflow:hidden}
  .ofd7-feat::before{content:"";position:absolute;top:-80px;right:-80px;width:280px;height:280px;background:radial-gradient(circle,rgba(255,178,55,.18) 0%,transparent 70%);border-radius:50%}
  .ofd7-feat__inner{max-width:880px;margin:0 auto;padding:0 22px;position:relative;z-index:1}
  .ofd7-feat__eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--gold);font-weight:800;font-size:11px;letter-spacing:.24em;text-transform:uppercase;margin-bottom:20px}
  .ofd7-feat__eyebrow::before{content:"★";color:var(--gold);font-size:14px;letter-spacing:0}
  .ofd7-feat__stars{color:var(--gold);font-size:22px;letter-spacing:3px;margin-bottom:20px}
  .ofd7-feat__quote{font-size:clamp(24px,3.8vw,36px);font-weight:800;line-height:1.15;letter-spacing:-.025em;color:#fff;margin:0 0 22px;max-width:820px}
  .ofd7-feat__quote::before{content:"\201C";color:var(--gold);font-size:1.1em;font-weight:800}
  .ofd7-feat__quote::after{content:"\201D";color:var(--gold);font-size:1.1em;font-weight:800}
  .ofd7-feat__body{font-size:16px;line-height:1.6;color:rgba(255,255,255,.78);max-width:680px;margin:0 0 24px}
  .ofd7-feat__attr{display:flex;align-items:center;gap:14px;border-top:1px solid rgba(255,255,255,.14);padding-top:20px}
  .ofd7-feat__avatar{width:46px;height:46px;border-radius:50%;background:var(--gold);color:var(--ink-deep);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;flex:0 0 auto}
  .ofd7-feat__name{font-size:15px;font-weight:800;color:#fff;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .ofd7-feat__verif{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:var(--green);background:rgba(62,161,147,.18);padding:3px 8px;border-radius:3px;letter-spacing:.04em;text-transform:uppercase}
  .ofd7-feat__title{font-size:12px;color:rgba(255,255,255,.62);margin:2px 0 0;letter-spacing:.04em}

  /* MEET WLP-1 — visual comparison block */
  .ofd7-meet__compare{display:grid;grid-template-columns:1fr;gap:16px;max-width:920px;margin:0 auto 36px}
  @media(min-width:720px){.ofd7-meet__compare{grid-template-columns:1fr auto 1fr;align-items:stretch}}
  .ofd7-meet__col{background:#fff;border:1px solid var(--line);border-radius:12px;padding:26px 22px;display:flex;flex-direction:column;align-items:center;text-align:center}
  .ofd7-meet__col--shot{border-top:4px solid var(--red)}
  .ofd7-meet__col--wlp{border-top:4px solid var(--brand);background:var(--paper)}
  .ofd7-meet__icon{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 0 14px}
  .ofd7-meet__col--shot .ofd7-meet__icon{background:#ffe4eb;color:var(--red)}
  .ofd7-meet__col--wlp .ofd7-meet__icon{background:var(--brand-tint);color:var(--brand)}
  .ofd7-meet__icon svg{width:32px;height:32px}
  .ofd7-meet__lbl{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;margin:0 0 8px}
  .ofd7-meet__col--shot .ofd7-meet__lbl{color:var(--red)}
  .ofd7-meet__col--wlp .ofd7-meet__lbl{color:var(--brand)}
  .ofd7-meet__h{font-size:20px;font-weight:800;letter-spacing:-.02em;color:var(--ink-deep);margin:0 0 10px;line-height:1.2}
  .ofd7-meet__p{font-size:14.5px;line-height:1.5;color:var(--ink-soft);margin:0}
  .ofd7-meet__arrow{display:flex;align-items:center;justify-content:center;color:var(--brand)}
  .ofd7-meet__arrow svg{width:38px;height:38px}
  @media(max-width:719px){.ofd7-meet__arrow{transform:rotate(90deg);padding:4px 0}}

  .ofd7-meet__why{max-width:680px;margin:0 auto;text-align:center}
  .ofd7-meet__why p{font-size:17px;line-height:1.6;color:var(--ink);margin:0}
  .ofd7-meet__why p b{color:var(--ink-deep);font-weight:700}
  .ofd7-meet__why p .blue{color:var(--brand);font-weight:700}

  /* TIMELINE — Without WLP-1 vs With WLP-1 */
  .ofd7-time{display:flex;flex-direction:column;gap:22px;max-width:1080px;margin:0 auto}
  .ofd7-time__row{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;display:grid;grid-template-columns:1fr;gap:0}
  @media(min-width:880px){.ofd7-time__row{grid-template-columns:130px 1fr auto 1fr}}
  .ofd7-time__month{background:var(--ink-deep);color:#fff;padding:20px 20px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}
  @media(min-width:880px){.ofd7-time__month{padding:24px 14px}}
  .ofd7-time__month-num{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--accent);margin-bottom:4px}
  .ofd7-time__month-big{font-size:34px;font-weight:800;letter-spacing:-.02em;line-height:1}
  .ofd7-time__month-sub{font-size:12px;font-weight:600;color:rgba(255,255,255,.7);margin-top:6px}
  .ofd7-time__side{padding:22px 22px}
  .ofd7-time__side--bad{background:#fff5f7;border-top:1px solid #ffd5de}
  .ofd7-time__side--good{background:var(--paper);border-top:1px solid var(--line-soft)}
  @media(min-width:880px){
    .ofd7-time__side--bad{border-top:0;border-right:1px dashed var(--line)}
    .ofd7-time__side--good{border-top:0}
  }
  .ofd7-time__head{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:800;margin:0 0 14px;display:flex;align-items:center;gap:8px}
  .ofd7-time__head--bad{color:var(--red)}
  .ofd7-time__head--good{color:var(--brand)}
  .ofd7-time__list{list-style:none;padding:0;margin:0;display:grid;gap:10px}
  .ofd7-time__list li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;line-height:1.45;color:var(--ink)}
  .ofd7-time__list li svg{width:20px;height:20px;flex:0 0 auto;margin-top:1px}
