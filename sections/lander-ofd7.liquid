  assign v_1mo        = section.settings.v_1mo        | default: '52472821121313'
  assign p_1mo        = section.settings.p_1mo        | default: '691162546465'
  assign price_1mo    = section.settings.price_1mo    | default: '$79.20'
  assign was_1mo      = section.settings.was_1mo      | default: '$99.00'
