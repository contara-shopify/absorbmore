      var label = e.target.closest('[data-plan]');
      if(!label) return;
      var vid   = label.getAttribute('data-variant-id');
      var pid   = label.getAttribute('data-plan-id');
      var price = label.getAttribute('data-price');
      if(variantInput) variantInput.value = vid;
      if(planInput)    planInput.value    = pid;
      if(ctaPrice)     ctaPrice.textContent = price + '/mo';
      if(stickyVariant) stickyVariant.value = vid;
      if(stickyPlan)    stickyPlan.value    = pid;
      if(stickyPrice)   stickyPrice.textContent = price + '/mo';
    });
  })();

  /* Sticky bottom ATC — reveal after scrolling past hero CTA. */
  (function(){
    var sticky = document.getElementById('ofd7Sticky');
    if(!sticky) return;
    var threshold = 520;
    var onScroll = function(){
      if(window.scrollY > threshold){ sticky.classList.add('is-on'); }
      else { sticky.classList.remove('is-on'); }
    };
    window.addEventListener('scroll', onScroll, {passive:true});
    onScroll();
  })();
</script>

