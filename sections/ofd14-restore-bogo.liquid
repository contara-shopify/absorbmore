<script>
  (function(){
    var root = document.currentScript.closest('.ofd14') || document.querySelector('.ofd14');
    if(!root) return;

    var vidRasp  = root.getAttribute('data-vid-rasp') || '';
    var vidMango = root.getAttribute('data-vid-mango') || '';
    var vidMix   = root.getAttribute('data-vid-mix') || '';
    var plan2mo  = root.getAttribute('data-plan-2mo') || '';
    var imgRasp  = root.getAttribute('data-img-rasp') || '';
    var imgMango = root.getAttribute('data-img-mango') || '';
    var imgMix   = root.getAttribute('data-img-mix') || '';

    function resolveBundle(){
      var f1 = getSlot('1'), f2 = getSlot('2');
      if(f1 === 'rasp'  && f2 === 'rasp')  return { id: vidRasp,  img: imgRasp,  title: '2 Raspberry' };
      if(f1 === 'mango' && f2 === 'mango') return { id: vidMango, img: imgMango, title: '2 Mango Lemonade' };
      return { id: vidMix, img: imgMix, title: '1 Raspberry · 1 Mango Lemonade' };
    }

    function updateBundlePreview(){
      var b = resolveBundle();
      var imgEl = root.querySelector('#ofd14-bundle-img');
      var ttlEl = root.querySelector('#ofd14-bundle-title');
      if(imgEl && b.img) imgEl.src = b.img;
      if(ttlEl) ttlEl.textContent = b.title;
    }

    // === Buybox is the source of truth for the flavor pair ===
    function getSlot(slot){
      var sel = root.querySelector('.ofd14-bb .swatch.sel[data-bb-slot="'+slot+'"]');
      return sel ? sel.getAttribute('data-bb-flavor') : (slot === '1' ? 'rasp' : 'mango');
    }

    function setBbSlot(slot, flavor){
      root.querySelectorAll('.ofd14-bb .swatch[data-bb-slot="'+slot+'"]').forEach(function(s){
        s.classList.toggle('sel', s.getAttribute('data-bb-flavor') === flavor);
      });
      updateBundlePreview();
    }

    root.querySelectorAll('.ofd14-bb .swatch').forEach(function(s){
      s.addEventListener('click', function(){
        setBbSlot(s.getAttribute('data-bb-slot'), s.getAttribute('data-bb-flavor'));
      });
    });

    // === Plan selector ===
    var planLabels = root.querySelectorAll('.ofd14-bb .plan');
    var atc = root.querySelector('#ofd14-atc');
    planLabels.forEach(function(p){
      p.addEventListener('click', function(){
        planLabels.forEach(function(x){ x.classList.remove('sel'); });
        p.classList.add('sel');
        var t = p.getAttribute('data-total');
        if(atc) atc.textContent = 'Add to Cart · $' + t;
        var input = p.querySelector('input'); if(input) input.checked = true;
      });
    });

    // === Add to cart === (subscription-only BOGO 50%)
    if(atc){
      atc.addEventListener('click', function(e){
        e.preventDefault();
        var bundle = resolveBundle();
        if(!bundle.id || !plan2mo){
          alert('Buybox is wired but a bundle variant ID or selling plan is missing.');
          return;
        }
        var item = {
          id: parseInt(bundle.id,10),
          quantity: 1,
          selling_plan: parseInt(plan2mo,10)
        };
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type':'application/json', 'Accept':'application/json' },
          body: JSON.stringify({ items: [ item ] })
        }).then(function(r){
          if(!r.ok) throw new Error('add failed');
          window.location.href = '/checkout';
        }).catch(function(){
          alert('Could not add to cart. Please try again.');
        });
      });
    }

    updateBundlePreview();
  })();
</script>

