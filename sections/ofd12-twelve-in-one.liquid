{% comment %}
  Restore — OFD12 "12 Pills in 1 Drink" lander (Pragmatic Optimizer persona).
  Page: /pages/ofd12-twelve-in-one
  Template: templates/page.ofd12-twelve-in-one.json
  Angle: stack consolidation + absorption math. Clean clinical palette (TAC Blue).
{% endcomment %}

{%- liquid
  assign restore = all_products['restore']
-%}

<style>
  .o12{
    --blue:#4659FF;
    --blue-deep:#2d3fd9;
    --blue-soft:rgba(70,89,255,0.06);
    --blue-tint:#EEF0FF;
    --ink:#0d1117;
    --ink-mute:#3a4150;
    --ink-soft:#6b7385;
    --line:#e6e9f2;
    --line-strong:#c9cee0;
    --cream:#FAFAF7;
    --warn:#E1225C;
  }
  .o12 *,.o12 *::before,.o12 *::after{box-sizing:border-box;}
  .o12{color:var(--ink);padding:0;}
  .o12 p{margin:0 0 14px;font-size:16px;line-height:1.6;color:var(--ink-mute);}
  .o12 h1,.o12 h2,.o12 h3{margin:0 0 14px;letter-spacing:-0.015em;font-weight:800;color:var(--ink);}
  .o12 h1{font-size:36px;line-height:1.05;}
  .o12 h2{font-size:28px;line-height:1.15;}
  .o12 h3{font-size:18px;line-height:1.3;}
  .o12 .eb{font-size:11px;letter-spacing:.2em;font-weight:700;color:var(--blue);margin:0 0 14px;text-transform:uppercase;}
  .o12 .blue{color:var(--blue);}
  .o12 .num{font-variant-numeric:tabular-nums;}
  .o12 .strike{text-decoration:line-through;opacity:.5;font-weight:500;margin-right:6px;}
  .o12 .inner{max-width:1140px;margin:0 auto;padding:0 20px;}
  .o12 .sec{padding:56px 0;}
  .o12 .sec--tint{background:var(--blue-soft);}
  .o12 .sec--cream{background:var(--cream);}
  .o12 .sec--ink{background:#0d1117;color:#fff;}
  .o12 .sec--ink h2,.o12 .sec--ink h3,.o12 .sec--ink p{color:#fff;}
  .o12 .center{text-align:center;}

  .o12 .btn{display:inline-block;background:var(--blue);color:#fff;font-weight:700;font-size:15px;letter-spacing:.03em;padding:16px 28px;border-radius:10px;text-decoration:none;text-align:center;border:none;cursor:pointer;transition:transform .15s;}
  .o12 .btn:hover{transform:translateY(-1px);}
  .o12 .btn--ghost{background:#fff;color:var(--ink);border:2px solid var(--ink);}
  .o12 .btn--white{background:#fff;color:var(--blue);}
  .o12 .btn.full{display:block;width:100%;}

  .o12 .stars{color:var(--blue);font-size:15px;letter-spacing:1px;display:inline-flex;align-items:center;gap:8px;}
  .o12 .stars small{color:var(--ink-mute);font-weight:600;font-size:13px;letter-spacing:0;}

  .o12 .chip{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);padding:6px 10px;border-radius:6px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:var(--ink-mute);margin:0 6px 6px 0;}
  .o12 .chip .dot{width:6px;height:6px;border-radius:50%;background:var(--blue);}

  .o12 .trust{font-size:12px;color:var(--ink-soft);margin:10px 0 0;letter-spacing:.02em;}

  /* === HERO === */
  .o12-hero{padding:36px 0 40px;background:linear-gradient(180deg,#fff 0%,var(--blue-soft) 100%);}
  .o12-hero .grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center;}
  .o12-hero .hero-img{aspect-ratio:4/5;border-radius:16px;overflow:hidden;background:#eceff5;position:relative;}
  .o12-hero .hero-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .o12-hero .hero-img::after{content:"NEW LIMITED TIME RASPBERRY FLAVOR";position:absolute;top:18px;left:18px;background:#C63947;color:#fff;font-size:10px;letter-spacing:.14em;font-weight:800;padding:7px 12px;border-radius:6px;}
  .o12-hero .qfacts{display:flex;flex-wrap:wrap;gap:6px 14px;margin:18px 0 0;padding:14px 0 0;border-top:1px solid var(--line);font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:var(--ink-mute);}
  .o12-hero .qfacts span{display:inline-flex;align-items:center;gap:8px;}
  .o12-hero .qfacts span::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--blue);}
  .o12-hero ul{list-style:none;padding:0;margin:18px 0 22px;}
  .o12-hero li{font-size:15.5px;line-height:1.5;padding:8px 0 8px 32px;position:relative;color:var(--ink);}
  .o12-hero li::before{content:"";position:absolute;left:0;top:12px;width:20px;height:20px;border-radius:6px;background:var(--blue);}
  .o12-hero li::after{content:"";position:absolute;left:6px;top:17px;width:9px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg);}

  /* === STAT GRID === */
  .o12-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border-radius:14px;overflow:hidden;border:1px solid var(--line);}
  .o12-stat{background:#fff;padding:24px 16px;text-align:center;}
  .o12-stat .n{font-size:30px;font-weight:800;line-height:1;margin:0 0 6px;color:var(--blue);}
  .o12-stat .l{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute);font-weight:700;}

  /* === THE STACK (12 PILLS BREAKDOWN) === */
  .o12-stack{display:grid;grid-template-columns:1fr;gap:24px;align-items:center;}
  .o12-stack .visual{background:#fff;border:1px solid var(--line);border-radius:18px;padding:28px 24px;text-align:center;}
  .o12-stack .visual .vs-grid{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px;margin:18px 0 0;}
  .o12-stack .pile{background:var(--blue-soft);border-radius:14px;padding:20px 12px;}
  .o12-stack .pile .big{font-size:48px;font-weight:800;line-height:1;color:var(--ink);margin:0 0 6px;font-variant-numeric:tabular-nums;}
  .o12-stack .pile .lbl{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute);font-weight:700;}
  .o12-stack .vs{font-size:13px;font-weight:800;color:var(--ink-soft);letter-spacing:.1em;}
  .o12-stack .glass{background:var(--blue);color:#fff;border-radius:14px;padding:20px 12px;}
  .o12-stack .glass .big{color:#fff;font-size:48px;font-weight:800;line-height:1;margin:0 0 6px;}
  .o12-stack .glass .lbl{color:rgba(255,255,255,0.85);font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;}

  .o12-pill-list{margin:22px 0 0;list-style:none;padding:0;border-top:1px solid var(--line);}
  .o12-pill-list li{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;padding:14px 0;border-bottom:1px solid var(--line);font-size:14.5px;}
  .o12-pill-list .role{color:var(--ink);font-weight:700;flex:1;}
  .o12-pill-list .amt{color:var(--blue);font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums;}

  /* === MECHANISM === */
  .o12-mech{display:grid;grid-template-columns:1fr;gap:14px;}
  .o12-mech .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px;}
  .o12-mech .card .n{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--blue);font-weight:800;margin:0 0 8px;}
  .o12-mech .card h3{font-size:17px;margin:0 0 8px;line-height:1.25;}
  .o12-mech .card p{margin:0;font-size:14.5px;line-height:1.6;color:var(--ink-mute);}

  /* === ABSORPTION COMPARE BARS (compact) === */
  .o12-bars{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px 22px;max-width:620px;margin:0 auto 32px;}
  .o12-bars .row{margin:0 0 18px;}
  .o12-bars .row:last-of-type{margin:0 0 6px;}
  .o12-bars .row .top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0 0 8px;}
  .o12-bars .row .lbl{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute);font-weight:800;}
  .o12-bars .row .pct{font-size:18px;font-weight:800;color:var(--ink);letter-spacing:-0.01em;font-variant-numeric:tabular-nums;}
  .o12-bars .row--us .lbl,.o12-bars .row--us .pct{color:var(--blue);}
  .o12-bars .bar{background:var(--blue-tint);border-radius:99px;height:10px;overflow:hidden;}
  .o12-bars .fill{height:100%;background:var(--ink-soft);border-radius:99px;}
  .o12-bars .row--us .fill{background:var(--blue);}
  .o12-bars .cap{font-size:13px;line-height:1.55;color:var(--ink-soft);margin:18px 0 0;padding:16px 0 0;border-top:1px solid var(--line);}
  .o12-bars .cap strong{color:var(--ink);}

  /* === DECOR (gradient blobs for personality) === */
  .o12 .decor{position:absolute;pointer-events:none;z-index:0;border-radius:50%;filter:blur(50px);opacity:.9;}
  .o12 .decor--blue{background:rgba(70,89,255,0.22);}
  .o12 .decor--rose{background:rgba(225,34,92,0.16);}
  .o12 .decor--cyan{background:rgba(70,180,255,0.16);}
  .o12 .decor--violet{background:rgba(140,90,255,0.16);}
  .o12 .sec,.o12-hero{position:relative;overflow:hidden;}
  .o12 .sec > .inner,.o12-hero > .inner{position:relative;z-index:1;}
  .o12 .sec--ink .decor--blue{background:rgba(70,89,255,0.45);}
  .o12 .sec--ink .decor--rose{background:rgba(225,34,92,0.32);}

  /* === PILLAR BAND === */
  .o12-pillars{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;}
  .o12-pillar{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 18px;display:flex;flex-direction:column;gap:10px;}
  .o12-pillar .head{display:flex;align-items:center;gap:10px;}
  .o12-pillar .num{font-size:11px;font-weight:800;color:var(--blue);letter-spacing:.1em;font-variant-numeric:tabular-nums;}
  .o12-pillar .lbl{font-size:15px;font-weight:800;letter-spacing:-0.005em;color:var(--ink);}
  .o12-pillar .why{font-size:13.5px;color:var(--ink-mute);line-height:1.5;margin:0;}
  .o12-pillar .nuts{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto;padding-top:8px;border-top:1px solid var(--line);}
  .o12-pillar .nut{font-size:11px;font-weight:700;color:var(--blue);background:var(--blue-soft);padding:4px 8px;border-radius:5px;letter-spacing:.02em;white-space:nowrap;}

  /* === SPEC TABLE === */
  .o12-spec{width:100%;border-collapse:collapse;font-size:14px;background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;}
  .o12-spec th,.o12-spec td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top;}
  .o12-spec thead th{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute);font-weight:700;background:var(--cream);}
  .o12-spec td:last-child{text-align:right;font-weight:700;color:var(--blue);font-variant-numeric:tabular-nums;white-space:nowrap;}
  .o12-spec tr:last-child td{border-bottom:none;}

  /* === COMPARISON === */
  .o12-cmp{width:100%;border-collapse:collapse;font-size:13px;background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;}
  .o12-cmp th,.o12-cmp td{padding:12px 10px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top;}
  .o12-cmp thead th{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute);font-weight:700;background:var(--cream);}
  .o12-cmp .col-us{background:var(--blue-soft);font-weight:700;}
  .o12-cmp .col-us strong{color:var(--blue);}
  .o12-cmp tr:last-child td{border-bottom:none;}

  /* === BUYBOX === */
  .o12-bb{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;display:grid;grid-template-columns:1fr;gap:22px;box-shadow:0 20px 50px rgba(13,17,23,0.06);}
  .o12-bb .prod-img{aspect-ratio:1/1;border-radius:14px;background:var(--blue-soft);overflow:hidden;}
  .o12-bb .prod-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .o12-bb .plan-wrap{border:2px solid var(--line);border-radius:12px;margin:0 0 10px;background:#fff;overflow:hidden;transition:border-color .15s,background .15s;}
  .o12-bb .plan-wrap:has(.plan.sel){border-color:var(--blue);background:var(--blue-soft);}
  .o12-bb .plan{border:none;border-radius:0;padding:16px;margin:0;cursor:pointer;display:flex;align-items:flex-start;gap:12px;position:relative;background:transparent;}
  .o12-bb .plan.sel{background:transparent;}
  .o12-bb .flavor-pick{display:none;padding:0 16px 16px;}
  .o12-bb .plan-wrap:has(.plan.sel) .flavor-pick{display:block;}
  .o12-bb .flavor-pick .pick-lbl{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute);font-weight:800;margin:0 0 10px;padding-top:14px;border-top:1px solid rgba(70,89,255,0.18);}
  .o12-bb .flavor-pick .chips{display:flex;flex-direction:column;gap:6px;}
  .o12-bb .flavor-pick .chip{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:9px 12px;cursor:pointer;transition:border-color .15s;font-size:13.5px;font-weight:600;color:var(--ink);line-height:1.3;}
  .o12-bb .flavor-pick .chip::before{content:"";width:13px;height:13px;border-radius:50%;border:1.5px solid var(--line);background:#fff;flex-shrink:0;display:inline-block;}
  .o12-bb .flavor-pick .chip.sel{border-color:var(--blue);}
  .o12-bb .flavor-pick .chip.sel::before{border-color:var(--blue);background:radial-gradient(circle, var(--blue) 0 3.5px, #fff 4.5px);}
  .o12-bb .flavor-pick .chip em{font-style:normal;color:var(--ink-mute);font-weight:500;font-size:12.5px;margin-left:auto;padding-left:10px;}
  .o12-bb .plan input{position:absolute;opacity:0;pointer-events:none;}
  .o12-bb .radio{width:20px;height:20px;border-radius:50%;border:2px solid var(--line-strong);flex-shrink:0;margin-top:2px;position:relative;}
  .o12-bb .plan.sel .radio{border-color:var(--blue);}
  .o12-bb .plan.sel .radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--blue);}
  .o12-bb .plan-body{flex:1;}
  .o12-bb .plan-title{font-weight:800;font-size:15.5px;display:flex;flex-wrap:wrap;align-items:center;gap:6px;color:var(--ink);}
  .o12-bb .plan-meta{font-size:13px;color:var(--ink-mute);margin-top:4px;line-height:1.45;}
  .o12-bb .plan-meta.small{font-size:12px;color:var(--ink-soft);margin-top:2px;}
  .o12-bb .plan-price{display:flex;flex-direction:column;align-items:flex-end;text-align:right;white-space:nowrap;flex-shrink:0;font-weight:500;}
  .o12-bb .plan-price .strike{font-size:13px;text-decoration:line-through;opacity:.55;margin:0 0 2px;}
  .o12-bb .plan-price .mo{font-weight:800;font-size:17px;color:var(--ink);line-height:1.1;font-variant-numeric:tabular-nums;}
  .o12-bb .plan-price .total{font-size:12px;color:var(--ink-mute);margin-top:2px;}
  .o12-bb .plan-price .save{font-size:12px;color:var(--blue);font-weight:700;margin-top:4px;}
  .o12-bb .badge{font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;background:var(--blue);color:#fff;padding:4px 8px;border-radius:5px;font-weight:800;}
  .o12-bb .badge--pop{background:var(--ink);}
  .o12-bb .badge--best{background:var(--blue-deep);}
  .o12-bb .reassure{font-size:12px;color:var(--ink-soft);text-align:center;margin:14px 0 0;line-height:1.5;}
  .o12-bb .prod-features{margin:14px 0 0;font-size:13px;color:var(--ink-mute);padding-left:0;}
  .o12-bb .prod-features li{padding:4px 0 4px 22px;position:relative;list-style:none;}
  .o12-bb .prod-features li::before{content:"✓";position:absolute;left:0;color:var(--blue);font-weight:800;}

  /* === REVIEW PULL === */
  .o12-pull{background:#fff;border:1px solid var(--line);border-radius:18px;padding:32px 24px;text-align:center;max-width:760px;margin:0 auto;}
  .o12-pull .qmark{font-size:32px;color:var(--blue);font-weight:800;line-height:1;margin:0 0 8px;}
  .o12-pull blockquote{margin:0 0 16px;font-size:19px;line-height:1.5;font-weight:600;color:var(--ink);}
  .o12-pull .meta{font-size:13px;color:var(--ink-mute);font-weight:700;letter-spacing:.04em;}
  .o12-pull .meta span{color:var(--ink-soft);font-weight:500;display:block;margin-top:4px;letter-spacing:0;}

  .o12-tsupport{display:grid;grid-template-columns:1fr;gap:14px;margin:28px 0 0;}
  .o12-tsupport .card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px;}
  .o12-tsupport .card .st{color:var(--blue);font-size:14px;letter-spacing:.06em;margin:0 0 10px;font-weight:800;}
  .o12-tsupport .card blockquote{margin:0 0 14px;font-size:15px;line-height:1.55;color:var(--ink);font-weight:500;}
  .o12-tsupport .card .who{font-size:12px;color:var(--ink-mute);letter-spacing:.04em;font-weight:700;text-transform:uppercase;}

  /* === CITATIONS === */
  .o12 sup.o12-cite{font-size:10px;font-weight:700;color:var(--blue);text-decoration:none;margin-left:2px;vertical-align:super;line-height:0;font-variant-numeric:tabular-nums;letter-spacing:0;text-transform:none;}
  .o12 sup.o12-cite:hover{text-decoration:underline;}
  .o12 sup.o12-cite.invert{color:#fff;}

  /* === REFERENCES === */
  .o12-refs{background:var(--cream);border:1px solid var(--line);border-radius:14px;padding:24px 22px;}
  .o12-refs summary{cursor:pointer;font-weight:800;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;}
  .o12-refs summary::-webkit-details-marker{display:none;}
  .o12-refs summary::after{content:"+";font-weight:400;font-size:22px;line-height:1;color:var(--blue);}
  .o12-refs[open] summary::after{content:"−";}
  .o12-refs ol{margin:18px 0 0;padding:0 0 0 20px;color:var(--ink-mute);font-size:13px;line-height:1.6;}
  .o12-refs ol li{margin:0 0 12px;padding-left:4px;}
  .o12-refs ol li:last-child{margin:0;}
  .o12-refs ol li strong{color:var(--ink);}
  .o12-refs .foot{font-size:11.5px;color:var(--ink-soft);margin:16px 0 0;line-height:1.55;}

  /* === FAQ === */
  .o12-faq details{border-bottom:1px solid var(--line);padding:18px 0;}
  .o12-faq summary{cursor:pointer;font-weight:700;font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:12px;color:var(--ink);}
  .o12-faq summary::-webkit-details-marker{display:none;}
  .o12-faq summary::after{content:"+";font-weight:400;font-size:22px;line-height:1;color:var(--blue);}
  .o12-faq details[open] summary::after{content:"−";}
  .o12-faq p{margin:10px 0 0;font-size:15px;color:var(--ink-mute);}

  /* === FINAL CTA === */
  .o12-final{text-align:center;}

  /* === INLINE CTA ROWS === */
  .o12-cta-row{text-align:center;margin:32px 0 0;}
  .o12-cta-row .micro{display:block;font-size:11.5px;color:var(--ink-soft);margin:10px 0 0;letter-spacing:.06em;text-transform:uppercase;font-weight:700;}
  .sec--ink .o12-cta-row .micro,.sec--tint .o12-cta-row .micro{color:var(--ink-mute);}

  /* === THIN BANNERS === */
  .o12-banner{background:#0d1117;color:#fff;padding:28px 20px;text-align:center;position:relative;overflow:hidden;}
  .o12-banner--quote blockquote{font-size:18px;line-height:1.4;font-weight:600;letter-spacing:-0.015em;margin:0 auto 10px;max-width:760px;color:#fff;font-style:normal;}
  .o12-banner--quote blockquote::before{content:"\201C";display:block;font-size:36px;line-height:0.6;color:var(--blue);font-weight:800;margin:0 0 12px;}
  .o12-banner--quote .who{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;color:rgba(255,255,255,0.7);margin:0;}
  .o12-banner--quote .who .star{color:var(--blue);letter-spacing:.04em;}
  .o12-banner--rating{background:var(--blue-tint);color:var(--ink);padding:16px 20px;border-top:1px solid rgba(70,89,255,0.18);border-bottom:1px solid rgba(70,89,255,0.18);}
  .o12-banner--rating .row{display:flex;flex-direction:column;align-items:center;gap:6px;max-width:920px;margin:0 auto;text-align:center;}
  .o12-banner--rating .stars{color:var(--blue);font-size:15px;letter-spacing:.04em;font-weight:800;display:inline-flex;align-items:center;gap:8px;}
  .o12-banner--rating .stars b{color:var(--ink);}
  .o12-banner--rating blockquote{font-size:14px;line-height:1.45;color:var(--ink);margin:0;font-style:normal;font-weight:500;}
  .o12-banner--rating blockquote::before{content:"";}
  .o12-banner--rating .who{font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--ink-soft);margin:0;}
  .o12-banner--trust{background:var(--blue);color:#fff;padding:18px 20px;}
