<script>
  (function(){
    var planEls = document.querySelectorAll('.o12-bb .plan');
    var chipEls = document.querySelectorAll('.o12-bb .flavor-pick .chip');
    var atc = document.getElementById('o12-atc');

    function syncAtc(){
      var sel = document.querySelector('.o12-bb .plan.sel');
      if(!sel) return;
      atc.textContent = 'Add to Cart · $' + sel.getAttribute('data-total');
    }

    function selectPlan(planLabel){
      planEls.forEach(function(x){ x.classList.remove('sel'); });
      planLabel.classList.add('sel');
      var input = planLabel.querySelector('input');
      if(input) input.checked = true;
      syncAtc();
    }

    planEls.forEach(function(p){
      p.addEventListener('click', function(){ selectPlan(p); });
    });

    chipEls.forEach(function(c){
      c.addEventListener('click', function(e){
        e.stopPropagation();
        var wrap = c.closest('.plan-wrap');
        wrap.querySelectorAll('.chip').forEach(function(x){ x.classList.remove('sel'); });
        c.classList.add('sel');
        var planLabel = wrap.querySelector('.plan');
        if(!planLabel.classList.contains('sel')) selectPlan(planLabel);
      });
    });

    atc.addEventListener('click', function(e){
      e.preventDefault();
      var planSel = document.querySelector('.o12-bb .plan.sel');
      if (!planSel) return;
      var chipSel = planSel.parentElement.querySelector('.chip.sel');
      if (!chipSel) return;
      var variant = parseInt(chipSel.getAttribute('data-variant'), 10);
      var sellingPlan = parseInt(chipSel.getAttribute('data-plan'), 10);
      if (!variant || !sellingPlan) return;
      var origLabel = atc.textContent;
      atc.textContent = 'Adding...';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          items: [{ id: variant, quantity: 1, selling_plan: sellingPlan }]
        })
      }).then(function(r){
        if (!r.ok) throw new Error('add failed');
        window.location.href = '/checkout';
      }).catch(function(){
        atc.textContent = 'Try again';
        setTimeout(function(){ atc.textContent = origLabel; }, 2500);
      });
    });
  })();
</script>

