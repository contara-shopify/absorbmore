{%- comment -%} OFD6 - Expensive Urine advertorial. Daily Basics Stack hero. Category-truth angle: most supplements don't absorb. No celebrity. Brand-thesis founder block. TAC Blue (#4659FF) primary + warm orange (#FF7815) accent. Hybrid format mirrors OFD3 Hollywood Secret. {%- endcomment -%}

{%- liquid
  assign hero_img    = section.settings.hero_img      | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/ofd6-hero-lineup.jpg?v=1781222471'
  assign buy_img     = section.settings.buy_img       | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/TAC_PDP-Image_Daily-Basics-Bundle.png?v=1768595621'
  assign mag_img     = section.settings.mag_img       | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/mag-pdp-launch.png?v=1762840748'
  assign dk_img      = section.settings.dk_img        | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/TAC_PDP-Image_Vitamin-D3-K2.png?v=1768595416'
  assign coq_img     = section.settings.coq_img       | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/TAC_PDP-Image_CoQ10.png?v=1768595395'
  assign cart_ot     = section.settings.cart_ot       | default: '/cart/52218076234017:1'
  assign cart_60d    = section.settings.cart_60d      | default: '/cart/52218076234017:1?selling_plan=691089047841'
  assign cart_30d    = section.settings.cart_30d      | default: '/cart/52218076234017:1?selling_plan=691101335841'
  assign price_ot_per     = section.settings.price_ot_per     | default: '$109'
  assign price_ot_total   = section.settings.price_ot_total   | default: '$109.00'
  assign price_60d_per    = section.settings.price_60d_per    | default: '$73.03'
  assign price_60d_after  = section.settings.price_60d_after  | default: '$98.10'
  assign price_60d_was    = section.settings.price_60d_was    | default: '$109.00'
  assign price_60d_save   = section.settings.price_60d_save   | default: '$35.97'
  assign price_30d_per    = section.settings.price_30d_per    | default: '$73.03'
  assign price_30d_after  = section.settings.price_30d_after  | default: '$98.10'
  assign price_30d_was    = section.settings.price_30d_was    | default: '$109.00'
  assign price_30d_save   = section.settings.price_30d_save   | default: '$35.97'
  assign rating      = section.settings.rating        | default: '4.7'
  assign review_count = section.settings.review_count | default: '2,400+'
-%}

<style>
  .ofd6 { --bg:#ffffff; --bg-soft:#f6f8ff; --bg-tint:#eef2ff; --paper:#fafbff; --ink:#0a1233; --ink-soft:#2a3260; --muted:#6b7390; --line:#dfe4f7; --line-soft:#ecf0fb; --brand:#4659FF; --brand-hover:#3a4ad9; --brand-deep:#2c39b3; --brand-tint:#e6e9ff; --accent:#FF7815; --accent-hover:#e76b0e; --accent-deep:#c25a0c; --accent-tint:#ffe9d6; --ink-deep:#080d24;
    background:var(--bg); color:var(--ink); -webkit-font-smoothing:antialiased; line-height:1.5; }
  .ofd6 *{box-sizing:border-box}
  .ofd6 img{max-width:100%;display:block}
  .ofd6 a{color:inherit;text-decoration:none}
  .ofd6 .wrap{max-width:1180px;margin:0 auto;padding:0 18px}

  /* ---------- STICKY TOP BAR ---------- */
  .ofd6-bar{position:sticky;top:0;z-index:60;background:var(--ink-deep);color:#fff;border-bottom:1px solid rgba(255,255,255,.08)}
  .ofd6-bar__row{display:flex;align-items:center;justify-content:center;gap:10px;padding:10px 14px;font-size:13px;flex-wrap:wrap;text-align:center;line-height:1.3}
  .ofd6-bar__lead{font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#fff}
  .ofd6-bar__lead em{font-style:normal;color:var(--accent);font-weight:700}
  @media(max-width:480px){.ofd6-bar__row{font-size:12px;gap:6px}}

  /* ---------- HERO ---------- */
  .ofd6-hero{background:linear-gradient(180deg,var(--bg) 0%,var(--bg-soft) 100%);position:relative;overflow:hidden;padding:32px 0 44px;color:var(--ink);border-bottom:1px solid var(--line-soft)}
  .ofd6-hero__grid{display:grid;grid-template-columns:1fr;gap:22px;align-items:center;position:relative}
  @media(min-width:880px){.ofd6-hero__grid{grid-template-columns:1.05fr .95fr;gap:48px;padding:18px 0}}
  @media(max-width:879px){
    .ofd6-hero{padding:14px 0 24px}
    .ofd6-hero__grid{gap:16px}
    .ofd6-hero__eyebrow{margin-bottom:8px}
    .ofd6-hero h1{margin-bottom:8px}
  }

  .ofd6-hero__eyebrow{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;padding:0;border-radius:0;margin-bottom:18px}
  .ofd6-hero__eyebrow svg{width:13px;height:13px;color:var(--accent)}

  .ofd6-hero h1{font-size:clamp(30px,5.6vw,50px);line-height:1.02;letter-spacing:-.035em;font-weight:800;margin:0 0 14px;color:var(--ink-deep)}
  .ofd6-hero h1 em{font-style:normal;color:var(--brand)}
  .ofd6-hero h1 .gold{color:var(--accent);font-style:normal}
  .ofd6-hero h1 .nowrap{white-space:nowrap}
  .ofd6-hero__sub{font-size:clamp(15px,2vw,18px);max-width:540px;margin:0 0 18px;color:var(--ink-soft);line-height:1.5}
  .ofd6-hero__sub b{color:var(--ink);font-weight:600}
  .ofd6-hero__tag{font-size:clamp(17px,2.2vw,22px);font-weight:700;letter-spacing:-.015em;color:var(--brand);margin:0 0 14px;line-height:1.3}

  .ofd6-hero__bullets{list-style:none;padding:0;margin:0 0 18px;display:grid;gap:8px;max-width:540px}
  .ofd6-hero__bullets li{display:flex;align-items:flex-start;gap:10px;font-size:15px;font-weight:500;color:var(--ink);line-height:1.4}
  .ofd6-hero__bullets li strong{font-weight:700;color:var(--ink-deep)}
  .ofd6-hero__bullets li svg{width:20px;height:20px;flex:0 0 auto;color:var(--brand);margin-top:2px}

  .ofd6-hero__pricing{display:flex;align-items:baseline;gap:14px;margin:14px 0 6px;flex-wrap:wrap}
  .ofd6-hero__price-now{font-weight:800;font-size:clamp(20px,3vw,26px);color:var(--ink-deep);letter-spacing:-.02em;line-height:1}
  .ofd6-hero__price-was{font-size:clamp(15px,2vw,18px);color:var(--muted);text-decoration:line-through;font-weight:500}
  .ofd6-hero__price-tag{font-weight:700;color:#fff;background:var(--accent);font-size:11px;text-transform:uppercase;letter-spacing:.06em;padding:4px 8px;border-radius:4px}

  .ofd6-hero__cta{display:inline-flex;align-items:center;justify-content:center;width:100%;max-width:440px;padding:16px 30px;background:var(--brand);color:#fff !important;font-weight:600;font-size:15px;letter-spacing:.01em;border-radius:2px;border:none;cursor:pointer;transition:background .2s ease;text-decoration:none}
  .ofd6-hero__cta *{color:#fff !important}
  .ofd6-hero__cta:hover{background:var(--brand-hover)}
  .ofd6-hero__cta:after{content:" →";margin-left:10px;color:#fff;transition:transform .2s}
  .ofd6-hero__cta:hover:after{transform:translateX(3px)}

  .ofd6-hero__guarantee{display:flex;align-items:center;gap:8px;margin-top:14px;font-size:13px;color:var(--ink-soft)}
  .ofd6-hero__guarantee svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}

  .ofd6-hero__media{position:relative;text-align:center}
  .ofd6-hero__card{background:#000;border-radius:8px;padding:0;position:relative;width:100%;max-width:420px;margin:0 auto;aspect-ratio:4/5;border:1px solid var(--line)}
  .ofd6-hero__card > img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;border-radius:8px}
  .ofd6-hero__inset{position:absolute;left:-22px;bottom:-22px;width:46%;aspect-ratio:1/1;border-radius:8px;overflow:hidden;border:4px solid var(--bg);box-shadow:0 12px 26px rgba(8,13,36,.22);background:#fff;z-index:3;transform:rotate(-3deg)}
  .ofd6-hero__inset img{width:100%;height:100%;object-fit:cover;object-position:center;display:block}
  @media(max-width:760px){.ofd6-hero__inset{width:44%;left:-12px;bottom:-14px;border-width:3px}}
  .ofd6-hero__badge{position:absolute;top:-40px;right:20px;background:var(--accent);color:#fff;border-radius:999px;width:124px;height:124px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:700;line-height:1;transform:rotate(-8deg);border:4px solid var(--bg);box-shadow:0 10px 22px rgba(8,13,36,.24);z-index:4}
  .ofd6-hero__badge big{font-size:30px;color:#fff;letter-spacing:-.02em}
  .ofd6-hero__badge span{font-size:11px;text-transform:uppercase;letter-spacing:.1em;margin-top:4px;color:#fff;font-weight:700}
  @media(max-width:760px){.ofd6-hero__badge{top:-28px;right:14px;width:104px;height:104px}.ofd6-hero__badge big{font-size:25px}.ofd6-hero__badge span{font-size:10px}}
  @media(max-width:879px){
    .ofd6-hero__card{max-width:340px;aspect-ratio:1/1}
  }

  /* ---------- TRUST STRIP ---------- */
  .ofd6-trust{background:var(--bg-soft);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:14px 0}
  .ofd6-trust__row{display:grid;grid-template-columns:1fr;gap:10px 16px;text-align:left;font-size:13px;font-weight:500;color:var(--ink)}
  @media(min-width:520px){.ofd6-trust__row{grid-template-columns:1fr 1fr;text-align:center}}
  @media(min-width:720px){.ofd6-trust__row{grid-template-columns:repeat(5,1fr);font-size:13px}}
  .ofd6-trust__cell{display:flex;align-items:center;justify-content:flex-start;gap:8px}
  @media(min-width:520px){.ofd6-trust__cell{justify-content:center}}
  .ofd6-trust__cell svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}
  .ofd6-trust__stars{color:var(--accent);letter-spacing:1px;font-size:14px}

  /* ---------- URGENCY BAND (Expensive Urine callout) ---------- */
  .ofd6-urg{background:var(--ink-deep);color:#fff;padding:48px 0;position:relative;overflow:hidden}
  .ofd6-urg__inner{text-align:center;position:relative;max-width:900px;margin:0 auto}
  .ofd6-urg__chip{display:inline-flex;align-items:center;gap:10px;background:transparent;color:#fff;font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;padding:0;border-radius:0;margin-bottom:18px}
  .ofd6-urg__chip::before{content:"";display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%}
  .ofd6-urg__head{font-size:clamp(26px,4.6vw,42px);line-height:1.02;letter-spacing:-.035em;font-weight:800;margin:0 0 14px;color:#fff;max-width:920px;margin-left:auto;margin-right:auto}
  .ofd6-urg__head em{font-style:normal;color:var(--accent)}
  .ofd6-urg__body{text-align:left;max-width:680px;margin:0 auto 22px}
  .ofd6-urg__body p{font-size:clamp(15px,1.8vw,17px);color:rgba(255,255,255,.85);margin:0 0 14px;line-height:1.6}
  .ofd6-urg__body p b{color:#fff;font-weight:600}
  .ofd6-urg__cta{display:inline-flex;align-items:center;justify-content:center;padding:16px 30px;background:var(--accent);color:#fff !important;font-weight:600;font-size:14.5px;letter-spacing:.01em;border-radius:2px;text-decoration:none;transition:background .2s}
  .ofd6-urg__cta:hover{background:var(--accent-hover)}
  .ofd6-urg__cta:after{content:" →";margin-left:10px;color:#fff}
  .ofd6-urg__sub{max-width:720px;margin:0 auto 30px;text-align:center;font-size:clamp(15px,1.6vw,17px);line-height:1.6;color:rgba(255,255,255,.78)}
  .ofd6-urg__sub b{color:#fff;font-weight:600}
  .ofd6-urg__cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0 0 32px}
  .ofd6-urg__card{padding:24px 20px;border:1px solid rgba(255,255,255,.12);border-radius:10px;background:rgba(255,255,255,.03);text-align:left}
  .ofd6-urg__icon{width:30px;height:30px;color:var(--accent);margin-bottom:14px;display:block}
  .ofd6-urg__card-h{font-size:16px;font-weight:700;letter-spacing:-.01em;color:#fff;margin-bottom:8px;line-height:1.25}
  .ofd6-urg__card-p{font-size:14px;line-height:1.55;color:rgba(255,255,255,.72)}
  @media(max-width:760px){
    .ofd6-urg__cards{grid-template-columns:1fr;gap:10px;margin-bottom:26px}
    .ofd6-urg__card{padding:18px 16px}
  }
  .ofd6-urg__rotator{display:flex;align-items:baseline;justify-content:center;flex-wrap:wrap;gap:8px;margin:0 auto 24px;max-width:720px;font-size:clamp(18px,3vw,26px);font-weight:700;letter-spacing:-.02em;line-height:1.2;color:#fff}
  .ofd6-urg__rotator .static{color:rgba(255,255,255,.85)}
  .ofd6-urg__rotator .dynamic{color:var(--accent);font-weight:800;display:inline-block;min-width:160px;text-align:left;transition:opacity .35s ease, transform .35s ease}
  .ofd6-urg__rotator .dynamic.is-out{opacity:0;transform:translateY(8px)}
  @media(max-width:520px){
    .ofd6-urg__rotator{gap:4px}
    .ofd6-urg__rotator .dynamic{min-width:0}
  }

  /* ---------- SECTION BASE ---------- */
  .ofd6-sec{padding:56px 0}
  .ofd6-sec--blue{background:var(--bg-tint)}
  .ofd6-sec--soft{background:var(--bg-soft)}
  .ofd6-sec--ink{background:var(--ink-deep);color:#fff}
  .ofd6-sec--ink h2,.ofd6-sec--ink h3{color:#fff}
  .ofd6-sec__eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.24em;font-weight:700;color:var(--ink);margin:0 0 12px;display:inline-flex;align-items:center;gap:10px}
  .ofd6-sec__eyebrow::before{content:"";display:inline-block;width:6px;height:6px;background:var(--brand);border-radius:50%}
  .ofd6-sec__title{font-size:clamp(26px,4.5vw,38px);font-weight:800;letter-spacing:-.035em;color:var(--ink-deep);margin:0 0 10px;line-height:1.05}
  .ofd6-sec__title em{font-style:normal;color:var(--brand)}
  .ofd6-sec__sub{font-size:16px;color:var(--ink-soft);max-width:680px;margin:0 0 28px;line-height:1.55}
  .ofd6-sec--ink .ofd6-sec__title{color:#fff}
  .ofd6-sec--ink .ofd6-sec__sub{color:rgba(255,255,255,.82)}
  .ofd6-sec--ink .ofd6-sec__eyebrow{color:rgba(255,255,255,.85)}
  .ofd6-sec--ink .ofd6-sec__eyebrow::before{background:var(--accent)}

  /* ---------- STATS DASHBOARD ---------- */
  .ofd6-benefits{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  @media(min-width:720px){.ofd6-benefits{grid-template-columns:repeat(4,1fr);gap:14px}}
  .ofd6-benefit{background:#fff;border:1px solid var(--line);border-radius:8px;padding:20px 14px;text-align:center;position:relative;overflow:hidden}
  .ofd6-benefit__num{font-size:clamp(28px,4.5vw,40px);font-weight:800;color:var(--ink-deep);letter-spacing:-.035em;line-height:1}
  .ofd6-benefit__num em{font-style:normal;color:var(--brand)}
  .ofd6-benefit__lbl{font-size:13px;font-weight:500;color:var(--ink-soft);margin-top:8px;line-height:1.3}
  .ofd6-benefit__ref{display:block;font-size:10px;color:var(--muted);margin-top:6px}

  .ofd6-benefit-list{display:grid;grid-template-columns:repeat(1,1fr);gap:10px;margin-top:28px;max-width:720px;margin-left:auto;margin-right:auto}
  @media(min-width:600px){.ofd6-benefit-list{grid-template-columns:repeat(2,1fr)}}
  .ofd6-bl-item{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px 16px;display:flex;align-items:center;gap:12px}
  .ofd6-bl-item__ico{width:38px;height:38px;border-radius:8px;background:var(--brand-tint);color:var(--brand-deep);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
  .ofd6-bl-item__ico svg{width:22px;height:22px}
  .ofd6-bl-item__txt{font-size:14px;font-weight:600;color:var(--ink);line-height:1.3}
  .ofd6-bl-item__txt small{display:block;font-weight:400;color:var(--ink-soft);font-size:12px;margin-top:2px}

  /* ---------- REVIEWS ---------- */
  .ofd6-quotes{display:grid;grid-template-columns:1fr;gap:14px;margin-top:26px}
  @media(min-width:720px){.ofd6-quotes{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:1024px){.ofd6-quotes{grid-template-columns:repeat(4,1fr)}}
  .ofd6-quote{background:#fff;border-radius:8px;padding:20px;border:1px solid var(--line);display:flex;flex-direction:column}
  .ofd6-quote__stars{color:var(--accent);font-size:14px;letter-spacing:1px;margin-bottom:8px}
  .ofd6-quote__txt{font-size:14px;color:var(--ink);line-height:1.55;margin:0 0 12px}
  .ofd6-quote__name{font-size:13px;font-weight:600;color:var(--ink-deep)}
  .ofd6-quote__verif{font-size:11px;color:var(--brand-deep);display:flex;align-items:center;gap:4px;margin-top:2px;font-weight:600}
  .ofd6-quote__verif svg{width:11px;height:11px}
  .ofd6-quote__spacer{flex:1}
  .ofd6-quote__product{display:flex;align-items:center;gap:10px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line-soft);text-decoration:none;transition:opacity .15s}
  .ofd6-quote__product:hover{opacity:.85}
  .ofd6-quote__product:hover .ofd6-quote__shop{color:var(--brand-hover)}
  .ofd6-quote__product:hover .ofd6-quote__shop:after{transform:translateX(3px)}
  .ofd6-quote__product-img{width:48px;height:48px;border-radius:6px;background:var(--bg-soft);border:1px solid var(--line);flex:0 0 auto;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:4px}
  .ofd6-quote__product-img img{max-width:100%;max-height:100%;object-fit:contain}
  .ofd6-quote__product-meta{font-size:12px;line-height:1.3;flex:1;min-width:0}
  .ofd6-quote__product-meta small{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.14em;font-weight:600;margin-bottom:2px}
  .ofd6-quote__product-meta b{display:block;font-weight:700;color:var(--ink-deep);font-size:13px}
  .ofd6-quote__shop{font-size:12px;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:.08em;white-space:nowrap;transition:color .15s}
  .ofd6-quote__shop:after{content:" \2192";margin-left:4px;display:inline-block;transition:transform .15s}

  /* ---------- BUY BOX ---------- */
  .ofd6-buy{background:#fff;border:1px solid var(--line);border-radius:8px;padding:26px;max-width:600px;margin:0 auto;box-shadow:0 6px 30px rgba(70,89,255,.06)}
  .ofd6-buy__flag{display:inline-flex;align-items:center;gap:10px;background:transparent;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;padding:0;border-radius:0;margin-bottom:14px}
  .ofd6-buy__flag::before{content:"";display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%}
  .ofd6-buy__hero{background:var(--bg-soft);border:1px solid var(--line-soft);border-radius:8px;padding:14px;margin:0 0 18px;display:flex;align-items:center;justify-content:center;aspect-ratio:16/9;overflow:hidden}
  .ofd6-buy__hero img{max-width:80%;max-height:100%;width:auto;height:auto;object-fit:contain}
  .ofd6-buy h3{font-size:24px;font-weight:800;color:var(--ink-deep);margin:0 0 6px;letter-spacing:-.02em}
  .ofd6-buy__stars{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink-soft);margin:0 0 18px}
  .ofd6-buy__stars b{color:var(--accent);letter-spacing:1px}

  .ofd6-buy__sub{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.24em;color:var(--ink);margin:0 0 14px}

  .ofd6-opts{display:grid;grid-template-columns:1fr;gap:10px;margin:0 0 18px}
  .ofd6-opt{display:flex;align-items:flex-start;gap:12px;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:16px;cursor:pointer;transition:border-color .15s, background .15s;position:relative}
  .ofd6-opt input{position:absolute;opacity:0;pointer-events:none}
  .ofd6-opt__bullet{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--line);flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:#fff;transition:border-color .15s;margin-top:2px}
  .ofd6-opt__bullet::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--accent);transform:scale(0);transition:transform .15s}
  .ofd6-opt__main{flex:1;min-width:0}
  .ofd6-opt__title{font-size:15px;font-weight:700;color:var(--ink-deep);display:flex;align-items:center;gap:6px;flex-wrap:wrap;line-height:1.25}
  .ofd6-opt__chip{display:inline-block;background:var(--accent);color:#fff;font-weight:600;font-size:10px;text-transform:uppercase;letter-spacing:.08em;padding:3px 8px;border-radius:2px}
  .ofd6-opt__chip--blue{background:var(--brand);color:#fff}
  .ofd6-opt__meta{font-size:12px;color:var(--ink-soft);margin-top:4px;line-height:1.4}
