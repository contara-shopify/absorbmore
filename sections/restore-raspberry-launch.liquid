      {%- comment -%} === STUDIO GALLERY === {%- endcomment -%}
      <div class="rrl-gallery">
        <div class="tile">
          <img src="{{ 'restore-studio-splash.jpg' | asset_url }}" alt="Restore Raspberry splash" loading="lazy">
          <span class="cap">The pour</span>
        </div>
        <div class="tile">
          <img src="{{ 'restore-studio-glass-ice.jpg' | asset_url }}" alt="Restore Raspberry over ice with raspberries" loading="lazy">
          <span class="cap">Over ice</span>
        </div>
        <div class="tile">
          <img src="{{ 'restore-studio-bag-glass.jpg' | asset_url }}" alt="Restore Raspberry bag and glass" loading="lazy">
          <span class="cap">28 servings</span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} === BUYBOX === {%- endcomment -%}
  <section class="sec sec--cream" id="buybox">
    <div class="inner">
      <div class="rrl-bb">
        <div class="prod-img">
          <img src="{{ 'restore-studio-bag-glass.jpg' | asset_url }}" alt="Restore Raspberry bag and pink drink" loading="lazy">
        </div>
