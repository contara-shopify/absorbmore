          <p style="margin-top:14px;"><a href="#buybox" class="btn">Try Today For $50.25</a></p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} === BENEFIT STRIP === {%- endcomment -%}
  <section class="sec sec--pink">
    <div class="inner">
      <div class="center" style="max-width:640px;margin:0 auto 22px;">
        <p class="eb">One drink. Six daily wins.</p>
        <h2>Why you shouldn't <span class="ital">skip a day</span>.</h2>
      </div>
      <div class="rrl-ben">
        <div class="card"><div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5c3.5 4.5 6.5 8.2 6.5 11.8a6.5 6.5 0 0 1-13 0c0-3.6 3-7.3 6.5-11.8Z"/><path d="M8.5 14.5a3.5 3.5 0 0 0 3 3"/></svg></div><div class="lbl">Hydration</div><div class="sub">900mg+ balanced electrolytes</div></div>
        <div class="card"><div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 5.5v6c0 4.4 3.1 8.2 7.5 9.5 4.4-1.3 7.5-5.1 7.5-9.5v-6L12 3Z"/><path d="m9 12 2 2 4-4"/></svg></div><div class="lbl">Immunity</div><div class="sub">Vitamin C + zinc support</div></div>
        <div class="card"><div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 2 4.5 13.5h6L10 22l9-11.5h-6L13.5 2Z"/></svg></div><div class="lbl">Energy</div><div class="sub">B-complex, methylfolate</div></div>
        <div class="card"><div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"/></svg></div><div class="lbl">Focus</div><div class="sub">Steady, no caffeine spike</div></div>
        <div class="card"><div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20c0-8 5.5-14 16-15-.5 9.5-6.5 15-15 15Z"/><path d="M4 20c3-4 7-8 14-11"/></svg></div><div class="lbl">Recovery</div><div class="sub">Magnesium for muscle recovery</div></div>
        <div class="card"><div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12c1.5 2 6.5 2 8 0"/><path d="M9.5 9.5v.5M14.5 9.5v.5"/></svg></div><div class="lbl">Detox</div><div class="sub">Glutathione + antioxidants</div></div>
