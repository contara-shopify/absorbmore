<script>
  (function(){
    var root = document.currentScript.closest('.rrl') || document.querySelector('.rrl');
    if(!root) return;

    // === Buybox plan selector ===
    var opts = root.querySelectorAll('.rrl-bb .plan');
    var atc = root.querySelector('#rrl-atc');
    opts.forEach(function(o){
      o.addEventListener('click', function(){
        opts.forEach(function(x){ x.classList.remove('sel'); });
        o.classList.add('sel');
        var total = o.getAttribute('data-total');
        if(atc) atc.textContent = 'Try Today For $' + total;
      });
    });
    if(atc){
      atc.addEventListener('click', function(e){
        e.preventDefault();
        e.stopPropagation();
        if(atc.getAttribute('aria-busy') === 'true') return;
        var selected = root.querySelector('.rrl-bb .plan.sel');
        if(!selected) return;
        var variantId = selected.getAttribute('data-variant');
        var sellingPlan = selected.getAttribute('data-selling-plan');
        if(!variantId){
          alert('Variant not configured.');
          return;
        }
        var body = { items: [ { id: parseInt(variantId, 10), quantity: 1 } ] };
        if(sellingPlan && sellingPlan.length > 0){
          body.items[0].selling_plan = parseInt(sellingPlan, 10);
        }
        var prevText = atc.textContent;
        atc.setAttribute('aria-busy','true');
        atc.disabled = true;
        atc.textContent = 'Adding to cart…';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        }).then(function(r){
          if(!r.ok){ return r.json().then(function(j){ throw new Error(j.description || j.message || 'Add to cart failed'); }); }
          atc.textContent = 'Going to checkout…';
          window.location.href = '/checkout';
        }).catch(function(err){
          atc.removeAttribute('aria-busy');
          atc.disabled = false;
          atc.textContent = prevText;
          alert(err.message || 'Could not add to cart. Please try again.');
        });
      });
    }

  })();
</script>

