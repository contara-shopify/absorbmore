{% comment %}
  Restore Raspberry — Public Launch lander.
  Duplicated from 06-restore-vip-early-access.liquid with all VIP/early-access
  elements removed: sticky countdown bar, 24h timer, "VIP Early Access" copy,
  "Why VIP first" section, VIP-only FAQ items, locked-price buybox banner.
  Page: /pages/restore-raspberry-launch
  Template: templates/page.restore-raspberry-launch.json
{% endcomment %}

<style>
  .rrl{
    /* Campaign palette — #C63947 leads. Cream + white only support, no competing accents. */
    --rasp:#C63947;
    --rasp-bright:#D8505E;
    --rasp-deep:#9E2B38;
    --rasp-darker:#7A1E2A;
    --rasp-soft:rgba(198,57,71,0.08);
    --rasp-glass:rgba(255,255,255,0.14);
    --cream:#FFF7F1;
    --cream-deep:#FBE9D9;
    --pink-wash:#FBECEE;
    --pink-tint:#F4CCD3;
    --white:#ffffff;
    --ink:#1a1814;
    --ink-mute:#5a554d;
    --ink-soft:#9a958d;
    --line:#ecd2d6;
  }
  .rrl *,.rrl *::before,.rrl *::after{box-sizing:border-box;}
  .rrl{color:var(--ink);padding:0;}
  .rrl p{margin:0 0 14px;font-size:16px;line-height:1.6;color:var(--ink-mute);}
  .rrl h1,.rrl h2,.rrl h3{margin:0 0 14px;letter-spacing:-0.01em;font-weight:800;color:var(--ink);}
  .rrl h1{font-size:36px;line-height:1.05;}
  .rrl h2{font-size:28px;line-height:1.15;}
  .rrl h3{font-size:18px;line-height:1.3;}
  .rrl .eb{font-size:11px;letter-spacing:.22em;font-weight:800;color:var(--rasp);margin:0 0 12px;text-transform:uppercase;}
  .rrl .rasp{color:var(--rasp);}
  .rrl .cream{color:var(--cream);}
  .rrl .underlined{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:6px;text-decoration-color:rgba(255,247,241,0.6);}
  .rrl .ital{font-style:italic;font-weight:800;color:var(--rasp);}
  .rrl .strike{text-decoration:line-through;opacity:.5;font-weight:500;margin-right:6px;}
  .rrl .inner{max-width:1140px;margin:0 auto;padding:0 20px;}
  .rrl .sec{padding:48px 0;}
  .rrl .sec--pink{background:var(--pink-wash);}
  .rrl .sec--cream{background:var(--cream);}
  .rrl .center{text-align:center;}

  .rrl .btn{display:inline-block;background:var(--rasp);color:#fff;font-weight:700;font-size:15px;letter-spacing:.04em;padding:16px 28px;border-radius:999px;text-decoration:none;text-align:center;border:none;cursor:pointer;transition:transform .15s, background .15s;font-family:inherit;line-height:1.2;}
  .rrl .btn:disabled,.rrl .btn[aria-busy="true"]{opacity:.7;cursor:wait;}
  .rrl .btn:hover{transform:translateY(-1px);background:var(--rasp-deep);}
  .rrl .btn--cream{background:var(--cream);color:var(--rasp-deep);}
  .rrl .btn--cream:hover{background:var(--white);}
  .rrl .btn--ink{background:var(--ink);color:#fff;}
  .rrl .btn.full{display:block;width:100%;}

  .rrl .stars{color:var(--rasp);font-size:16px;letter-spacing:1px;display:inline-flex;align-items:center;gap:8px;}
  .rrl .stars small{color:var(--ink-mute);font-weight:600;font-size:13px;letter-spacing:0;}
  .rrl .trust{font-size:12px;color:var(--ink-mute);margin:10px 0 0;letter-spacing:.02em;}

  /* === HERO === */
  .rrl-hero{position:relative;padding:48px 0 48px;background:#fff;color:var(--ink);overflow:hidden;}
  .rrl-hero .inner{position:relative;}
  .rrl-hero h1{color:var(--ink);}
  .rrl-hero h1 .cream{color:var(--rasp);}
  .rrl-hero h1 .underlined{text-decoration-color:rgba(198,57,71,0.35);}
  .rrl-hero p{color:var(--ink-mute);}
  .rrl-hero .chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px;}
  .rrl-hero .new-chip{display:inline-flex;align-items:center;gap:8px;background:var(--rasp);color:#fff;border:none;padding:8px 16px;border-radius:999px;font-size:11px;letter-spacing:.22em;font-weight:800;text-transform:uppercase;margin:0;box-shadow:0 4px 14px rgba(198,57,71,0.25);}
  .rrl-hero .new-chip::before{content:"";width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 8px rgba(255,255,255,0.6);}
  .rrl-hero .le-chip{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--rasp-deep);border:1px solid var(--rasp);padding:7px 15px;border-radius:999px;font-size:11px;letter-spacing:.22em;font-weight:800;text-transform:uppercase;margin:0;}
  .rrl-hero .le-chip::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--rasp);}
  .rrl-hero .grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center;}
  .rrl-hero .hero-img{aspect-ratio:4/5;border-radius:24px;overflow:hidden;background:#fff;position:relative;border:6px solid var(--rasp);padding:14px;box-shadow:0 24px 60px rgba(122,30,42,0.22);}
  .rrl-hero .hero-img img{width:100%;height:100%;object-fit:cover;display:block;border-radius:14px;}
  .rrl-hero .hero-img::after{content:"NEW · RASPBERRY";position:absolute;top:26px;left:26px;background:var(--rasp);color:#fff;font-size:10px;letter-spacing:.18em;font-weight:800;padding:7px 12px;border-radius:999px;box-shadow:0 4px 10px rgba(0,0,0,0.18);}
  .rrl-hero .insider{font-size:15px;line-height:1.55;color:var(--ink-mute);margin:8px 0 18px;}
  .rrl-hero .insider strong{color:var(--ink);}
  .rrl-hero .proof{font-size:13px;letter-spacing:.06em;font-weight:700;text-transform:uppercase;color:var(--rasp);margin:0 0 16px;display:flex;flex-wrap:wrap;gap:6px 14px;}
  .rrl-hero .proof span{position:relative;padding-left:14px;}
  .rrl-hero .proof span::before{content:"";position:absolute;left:0;top:50%;width:5px;height:5px;border-radius:50%;background:var(--rasp);transform:translateY(-50%);}
  .rrl-hero ul.feats{list-style:none;padding:0;margin:0 0 22px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .rrl-hero ul.feats li{font-size:15px;line-height:1.4;padding:12px 0 12px 30px;position:relative;color:var(--ink);border-bottom:1px solid var(--line);}
  .rrl-hero ul.feats li:last-child{border-bottom:none;}
  .rrl-hero ul.feats li strong{color:var(--ink);font-weight:800;}
  .rrl-hero ul.feats li::before{content:"";position:absolute;left:0;top:14px;width:18px;height:18px;border-radius:50%;background:var(--rasp);}
  .rrl-hero ul.feats li::after{content:"";position:absolute;left:5px;top:18px;width:8px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg);}

  /* === FLAVOR REVEAL === */
  .rrl-flavor{background:#fff;}
  .rrl-flavor .grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center;}
  .rrl-flavor .img{aspect-ratio:1/1;border-radius:24px;overflow:hidden;background:#fff;position:relative;border:6px solid var(--rasp);padding:14px;box-shadow:0 18px 40px rgba(122,30,42,0.18);}
  .rrl-flavor .img img{width:100%;height:100%;object-fit:cover;display:block;border-radius:14px;}
  .rrl-flavor .img::after{content:"REPLACES 12 DAILY VITAMINS · 1 DELICIOUS DRINK";position:absolute;bottom:26px;left:26px;right:26px;background:rgba(255,255,255,0.96);color:var(--rasp-deep);font-size:10px;letter-spacing:.14em;font-weight:800;padding:9px 14px;border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,0.22);text-align:center;line-height:1.3;}

  /* === STUDIO GALLERY === */
  .rrl-gallery{display:grid;grid-template-columns:1fr;gap:14px;margin:22px 0 0;}
  .rrl-gallery .tile{aspect-ratio:3/4;border-radius:20px;overflow:hidden;background:var(--pink-wash);position:relative;}
  .rrl-gallery .tile img{width:100%;height:100%;object-fit:cover;display:block;}
  .rrl-gallery .tile .cap{position:absolute;left:14px;bottom:14px;background:#fff;color:var(--rasp);font-size:10px;letter-spacing:.18em;font-weight:800;padding:7px 11px;border-radius:999px;text-transform:uppercase;}

  /* === CLOSER IMAGE === */
  .rrl-closer{aspect-ratio:16/10;border-radius:24px;overflow:hidden;background:var(--pink-wash);margin:0 0 26px;max-width:520px;margin-left:auto;margin-right:auto;}
  .rrl-closer img{width:100%;height:100%;object-fit:cover;display:block;}
  .rrl-flavor ul{list-style:none;padding:0;margin:18px 0 22px;}
  .rrl-flavor li{font-size:15px;line-height:1.5;padding:10px 0 10px 30px;position:relative;color:var(--ink);}
  .rrl-flavor li strong{color:var(--rasp);font-weight:800;}
  .rrl-flavor li::before{content:"";position:absolute;left:2px;top:13px;width:14px;height:18px;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23C63947'><path d='M12 2.5c3.5 4.5 6.5 8.2 6.5 11.8a6.5 6.5 0 0 1-13 0c0-3.6 3-7.3 6.5-11.8Z'/></svg>");background-size:contain;background-repeat:no-repeat;background-position:center;}

  /* === BENEFIT STRIP === */
  .rrl-ben{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border-radius:20px;overflow:hidden;}
  .rrl-ben .card{background:#fff;padding:22px 14px;text-align:center;}
  .rrl-ben .ico{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0 auto 10px;border-radius:50%;background:var(--rasp-soft);color:var(--rasp);}
  .rrl-ben .ico svg{width:22px;height:22px;display:block;}
  .rrl-ben .lbl{font-size:13px;font-weight:800;color:var(--ink);letter-spacing:.02em;margin:0 0 4px;}
  .rrl-ben .sub{font-size:12px;color:var(--ink-soft);line-height:1.4;}

  /* === BUYBOX === */
  .rrl-bb{background:#fff;border:2px solid var(--rasp);border-radius:24px;padding:24px;display:grid;grid-template-columns:1fr;gap:22px;box-shadow:0 20px 50px rgba(198,57,71,0.14);position:relative;}
  .rrl-bb .prod-img{aspect-ratio:1/1;border-radius:18px;background:var(--pink-wash);overflow:hidden;}
  .rrl-bb .prod-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .rrl-bb .plan{border:2px solid var(--line);border-radius:14px;padding:16px;margin:0 0 10px;cursor:pointer;display:flex;align-items:flex-start;gap:12px;position:relative;background:#fff;}
  .rrl-bb .plan.sel{border-color:var(--rasp);background:var(--rasp-soft);}
  .rrl-bb .plan input{position:absolute;opacity:0;pointer-events:none;}
  .rrl-bb .radio{width:20px;height:20px;border-radius:50%;border:2px solid #c5cbd9;flex-shrink:0;margin-top:2px;position:relative;}
  .rrl-bb .plan.sel .radio{border-color:var(--rasp);}
  .rrl-bb .plan.sel .radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--rasp);}
  .rrl-bb .plan-body{flex:1;}
  .rrl-bb .plan-title{font-weight:800;font-size:16px;display:flex;flex-wrap:wrap;align-items:center;gap:6px;color:var(--ink);}
  .rrl-bb .plan-meta{font-size:13px;color:var(--ink-mute);margin-top:4px;line-height:1.45;}
  .rrl-bb .plan-meta.small{font-size:12px;color:var(--ink-soft);margin-top:2px;}
  .rrl-bb .plan-price{display:flex;flex-direction:column;align-items:flex-end;text-align:right;white-space:nowrap;flex-shrink:0;font-weight:500;}
  .rrl-bb .plan-price .strike{font-size:13px;text-decoration:line-through;opacity:.55;margin:0 0 2px;}
  .rrl-bb .plan-price .mo{font-weight:800;font-size:18px;color:var(--ink);line-height:1.1;}
  .rrl-bb .plan-price .total{font-size:12px;color:var(--ink-mute);margin-top:2px;}
  .rrl-bb .plan-price .save{font-size:12px;color:var(--rasp-deep);font-weight:700;margin-top:4px;}
  .rrl-bb .badge{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;background:var(--rasp);color:#fff;padding:4px 9px;border-radius:6px;font-weight:800;box-shadow:0 2px 6px rgba(198,57,71,0.28);}
  .rrl-bb .badge--pop{background:var(--rasp-deep);color:#fff;box-shadow:0 2px 6px rgba(122,30,42,0.3);}
  .rrl-bb .badge--best{background:var(--ink);color:#fff;box-shadow:0 2px 6px rgba(26,24,20,0.25);}
  .rrl-bb .reassure{font-size:12px;color:var(--ink-soft);text-align:center;margin:14px 0 0;line-height:1.5;}
  .rrl-bb .prod-features{margin:14px 0 0;font-size:13px;color:var(--ink-mute);padding-left:0;}
  .rrl-bb .prod-features li{padding:4px 0 4px 22px;position:relative;list-style:none;}
  .rrl-bb .prod-features li::before{content:"✓";position:absolute;left:0;color:var(--rasp);font-weight:800;}
  .rrl-bb .plan-gift{display:inline-flex;align-items:center;gap:5px;background:var(--rasp-soft);color:var(--rasp-deep);font-size:12px;font-weight:800;padding:4px 9px;border-radius:6px;margin:8px 0 0;letter-spacing:.01em;line-height:1.2;}
  .rrl-bb .plan-gift svg{width:13px;height:13px;flex-shrink:0;}

  /* === FAQ === */
  .rrl-faq details{border-bottom:1px solid var(--line);padding:16px 0;}
  .rrl-faq summary{cursor:pointer;font-weight:700;font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:12px;color:var(--ink);}
  .rrl-faq summary::-webkit-details-marker{display:none;}
  .rrl-faq summary::after{content:"+";font-weight:400;font-size:22px;line-height:1;color:var(--rasp);}
  .rrl-faq details[open] summary::after{content:"−";}
  .rrl-faq p{margin:10px 0 0;font-size:15px;color:var(--ink-mute);}

  /* === FINAL CTA === */
  .rrl-final{background:var(--rasp);color:#fff;text-align:center;position:relative;overflow:hidden;}
  .rrl-final::before{content:"";position:absolute;inset:0;background:radial-gradient(80% 60% at 90% 10%,var(--rasp-bright),transparent 60%),radial-gradient(70% 60% at 10% 100%,var(--rasp-deep),transparent 65%);pointer-events:none;}
  .rrl-final h2,.rrl-final p{color:#fff;}
  .rrl-final .inner{position:relative;}

  /* === DESKTOP === */
  @media (min-width:768px){
    .rrl p{font-size:17px;}
    .rrl h1{font-size:60px;}
    .rrl h2{font-size:42px;}
    .rrl .sec{padding:72px 0;}
    .rrl-hero{padding:72px 0 72px;}
    .rrl-hero .grid{grid-template-columns:1.1fr 1fr;gap:56px;}
    .rrl-hero .hero-img{aspect-ratio:4/5;}
    .rrl-flavor .grid{grid-template-columns:1fr 1.05fr;gap:48px;}
    .rrl-gallery{grid-template-columns:repeat(3,1fr);gap:18px;}
    .rrl-ben{grid-template-columns:repeat(6,1fr);}
    .rrl-ben .card{padding:28px 14px;}
    .rrl-bb{grid-template-columns:0.9fr 1.1fr;padding:36px;gap:36px;}
  }
</style>

