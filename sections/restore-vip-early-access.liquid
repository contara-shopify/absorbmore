<script>
  (function(){
    var root = document.currentScript.closest('.rvip') || document.querySelector('.rvip');
    if(!root) return;

    // === Countdown ===
    var deadlineStr = root.getAttribute('data-deadline') || '';
    var deadline = deadlineStr ? new Date(deadlineStr).getTime() : 0;
    // Fallback: if deadline missing or already past, use 24h-from-first-visit (stored in localStorage).
    if(!deadline || isNaN(deadline) || deadline < Date.now()){
      var stored = parseInt(localStorage.getItem('rvipDeadline') || '0', 10);
      if(!stored || stored < Date.now()){
        stored = Date.now() + 24*60*60*1000;
        localStorage.setItem('rvipDeadline', String(stored));
      }
      deadline = stored;
    }

    var clocks = root.querySelectorAll('[data-clock]');
    function pad(n){ n = Math.max(0, n|0); return n < 10 ? '0'+n : ''+n; }
    function tick(){
      var ms = deadline - Date.now();
      if(ms <= 0){
        clocks.forEach(function(c){ c.classList.add('is-ended'); });
        ['[data-d]','[data-h]','[data-m]','[data-s]'].forEach(function(sel){
          root.querySelectorAll(sel).forEach(function(el){ el.textContent = '00'; });
        });
        return;
      }
      var s = Math.floor(ms/1000);
      var d = Math.floor(s/86400); s -= d*86400;
      var h = Math.floor(s/3600);  s -= h*3600;
      var m = Math.floor(s/60);    s -= m*60;
      root.querySelectorAll('[data-d]').forEach(function(el){ el.textContent = pad(d); });
      root.querySelectorAll('[data-h]').forEach(function(el){ el.textContent = pad(h); });
      root.querySelectorAll('[data-m]').forEach(function(el){ el.textContent = pad(m); });
      root.querySelectorAll('[data-s]').forEach(function(el){ el.textContent = pad(s); });
    }
    tick();
    setInterval(tick, 1000);

    // === Buybox plan selector ===
    var opts = root.querySelectorAll('.rvip-bb .plan');
    var atc = root.querySelector('#rvip-atc');
    opts.forEach(function(o){
      o.addEventListener('click', function(){
        opts.forEach(function(x){ x.classList.remove('sel'); });
        o.classList.add('sel');
        var total = o.getAttribute('data-total');
        if(atc) atc.textContent = 'Try Today For $' + total;
      });
    });
    if(atc){
      atc.addEventListener('click', function(e){
        e.preventDefault();
        e.stopPropagation();
        if(atc.getAttribute('aria-busy') === 'true') return;
        var selected = root.querySelector('.rvip-bb .plan.sel');
        if(!selected) return;
        var variantId = selected.getAttribute('data-variant');
        var sellingPlan = selected.getAttribute('data-selling-plan');
        if(!variantId){
          alert('Variant not configured.');
          return;
        }
        var body = { items: [ { id: parseInt(variantId, 10), quantity: 1 } ] };
        if(sellingPlan && sellingPlan.length > 0){
          body.items[0].selling_plan = parseInt(sellingPlan, 10);
        }
        var prevText = atc.textContent;
        atc.setAttribute('aria-busy','true');
        atc.disabled = true;
        atc.textContent = 'Adding to cart…';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        }).then(function(r){
          if(!r.ok){ return r.json().then(function(j){ throw new Error(j.description || j.message || 'Add to cart failed'); }); }
          atc.textContent = 'Going to checkout…';
          window.location.href = '/checkout';
        }).catch(function(err){
          atc.removeAttribute('aria-busy');
          atc.disabled = false;
          atc.textContent = prevText;
          alert(err.message || 'Could not add to cart. Please try again.');
        });
      });
    }

  })();
</script>

