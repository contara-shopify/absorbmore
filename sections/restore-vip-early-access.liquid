{% comment %}
  Restore Raspberry — VIP Early Access lander.
  Phase 2 of the Restore Raspberry launch (subscribers + waitlist, 24hr window).
  Page: /pages/restore-vip-access
  Template: templates/page.restore-vip-access.json
  Visual DNA inherits from restore-summer-lander but pivots to "insider" framing
  with a prominent 24-hour countdown.
{% endcomment %}

<style>
  .rvip{
    /* Campaign palette — #C63947 leads. Cream + white only support, no competing accents. */
    --rasp:#C63947;
    --rasp-bright:#D8505E;
    --rasp-deep:#9E2B38;
    --rasp-darker:#7A1E2A;
    --rasp-soft:rgba(198,57,71,0.08);
    --rasp-glass:rgba(255,255,255,0.14);
    --cream:#FFF7F1;
    --cream-deep:#FBE9D9;
    --pink-wash:#FBECEE;
    --pink-tint:#F4CCD3;
    --white:#ffffff;
    --ink:#1a1814;
    --ink-mute:#5a554d;
    --ink-soft:#9a958d;
    --line:#ecd2d6;
  }
  .rvip *,.rvip *::before,.rvip *::after{box-sizing:border-box;}
  .rvip{color:var(--ink);padding:0;}
  .rvip p{margin:0 0 14px;font-size:16px;line-height:1.6;color:var(--ink-mute);}
  .rvip h1,.rvip h2,.rvip h3{margin:0 0 14px;letter-spacing:-0.01em;font-weight:800;color:var(--ink);}
  .rvip h1{font-size:36px;line-height:1.05;}
  .rvip h2{font-size:28px;line-height:1.15;}
  .rvip h3{font-size:18px;line-height:1.3;}
  .rvip .eb{font-size:11px;letter-spacing:.22em;font-weight:800;color:var(--rasp);margin:0 0 12px;text-transform:uppercase;}
  .rvip .rasp{color:var(--rasp);}
  .rvip .cream{color:var(--cream);}
  .rvip .underlined{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:6px;text-decoration-color:rgba(255,247,241,0.6);}
  .rvip .ital{font-style:italic;font-weight:800;color:var(--rasp);}
  .rvip .strike{text-decoration:line-through;opacity:.5;font-weight:500;margin-right:6px;}
  .rvip .inner{max-width:1140px;margin:0 auto;padding:0 20px;}
  .rvip .sec{padding:48px 0;}
  .rvip .sec--pink{background:var(--pink-wash);}
  .rvip .sec--cream{background:var(--cream);}
  .rvip .center{text-align:center;}

  .rvip .btn{display:inline-block;background:var(--rasp);color:#fff;font-weight:700;font-size:15px;letter-spacing:.04em;padding:16px 28px;border-radius:999px;text-decoration:none;text-align:center;border:none;cursor:pointer;transition:transform .15s, background .15s;font-family:inherit;line-height:1.2;}
  .rvip .btn:disabled,.rvip .btn[aria-busy="true"]{opacity:.7;cursor:wait;}
  .rvip .btn:hover{transform:translateY(-1px);background:var(--rasp-deep);}
  .rvip .btn--cream{background:var(--cream);color:var(--rasp-deep);}
  .rvip .btn--cream:hover{background:var(--white);}
  .rvip .btn--ink{background:var(--ink);color:#fff;}
  .rvip .btn.full{display:block;width:100%;}

  .rvip .stars{color:var(--rasp);font-size:16px;letter-spacing:1px;display:inline-flex;align-items:center;gap:8px;}
  .rvip .stars small{color:var(--ink-mute);font-weight:600;font-size:13px;letter-spacing:0;}
  .rvip .trust{font-size:12px;color:var(--ink-mute);margin:10px 0 0;letter-spacing:.02em;}

  /* === VIP HERO === */
  .rvip-hero{position:relative;padding:48px 0 48px;background:#fff;color:var(--ink);overflow:hidden;}
  .rvip-hero .inner{position:relative;}
  .rvip-hero h1{color:var(--ink);}
  .rvip-hero h1 .cream{color:var(--rasp);}
  .rvip-hero h1 .underlined{text-decoration-color:rgba(198,57,71,0.35);}
  .rvip-hero p{color:var(--ink-mute);}
  .rvip-hero .chips{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px;}
  .rvip-hero .vip-chip{display:inline-flex;align-items:center;gap:8px;background:var(--rasp);color:#fff;border:none;padding:8px 16px;border-radius:999px;font-size:11px;letter-spacing:.22em;font-weight:800;text-transform:uppercase;margin:0;box-shadow:0 4px 14px rgba(198,57,71,0.25);}
  .rvip-hero .vip-chip::before{content:"";width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 8px rgba(255,255,255,0.6);}
  .rvip-hero .le-chip{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--rasp-deep);border:1px solid var(--rasp);padding:7px 15px;border-radius:999px;font-size:11px;letter-spacing:.22em;font-weight:800;text-transform:uppercase;margin:0;}
  .rvip-hero .le-chip::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--rasp);}
  .rvip-hero .grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center;}
  .rvip-hero .hero-img{aspect-ratio:4/5;border-radius:24px;overflow:hidden;background:#fff;position:relative;border:6px solid var(--rasp);padding:14px;box-shadow:0 24px 60px rgba(122,30,42,0.22);}
  .rvip-hero .hero-img img{width:100%;height:100%;object-fit:cover;display:block;border-radius:14px;}
  .rvip-hero .hero-img::after{content:"NEW · RASPBERRY";position:absolute;top:26px;left:26px;background:var(--rasp);color:#fff;font-size:10px;letter-spacing:.18em;font-weight:800;padding:7px 12px;border-radius:999px;box-shadow:0 4px 10px rgba(0,0,0,0.18);}
  .rvip-hero .insider{font-size:15px;line-height:1.55;color:var(--ink-mute);margin:8px 0 18px;}
  .rvip-hero .insider strong{color:var(--ink);}
  .rvip-hero .proof{font-size:13px;letter-spacing:.06em;font-weight:700;text-transform:uppercase;color:var(--rasp);margin:0 0 16px;display:flex;flex-wrap:wrap;gap:6px 14px;}
  .rvip-hero .proof span{position:relative;padding-left:14px;}
  .rvip-hero .proof span::before{content:"";position:absolute;left:0;top:50%;width:5px;height:5px;border-radius:50%;background:var(--rasp);transform:translateY(-50%);}
  .rvip-hero ul.feats{list-style:none;padding:0;margin:0 0 22px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .rvip-hero ul.feats li{font-size:15px;line-height:1.4;padding:12px 0 12px 30px;position:relative;color:var(--ink);border-bottom:1px solid var(--line);}
  .rvip-hero ul.feats li:last-child{border-bottom:none;}
  .rvip-hero ul.feats li strong{color:var(--ink);font-weight:800;}
  .rvip-hero ul.feats li::before{content:"";position:absolute;left:0;top:14px;width:18px;height:18px;border-radius:50%;background:var(--rasp);}
  .rvip-hero ul.feats li::after{content:"";position:absolute;left:5px;top:18px;width:8px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg);}

  /* === STICKY COUNTDOWN BAR === */
  .rvip-bar{position:sticky;top:0;z-index:50;background:var(--rasp);color:#fff;padding:10px 16px;text-align:center;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--rasp-deep);box-shadow:0 2px 10px rgba(122,30,42,0.18);line-height:1.2;}
  .rvip-bar .lbl{font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:800;color:rgba(255,247,241,0.92);display:inline-flex;align-items:center;gap:8px;}
  .rvip-bar .lbl::before{content:"";width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 0 0 rgba(255,255,255,0.55);animation:rvipPulse 1.6s ease-in-out infinite;}
  .rvip-bar .time{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:.04em;}
  .rvip-bar .time .sep{opacity:.55;margin:0 1px;}
  .rvip-bar .time .u{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.7;margin-right:6px;margin-left:1px;}
  .rvip-bar .ended-text{display:none;font-size:13px;font-weight:700;}
  .rvip-bar.is-ended{background:var(--ink);}
  .rvip-bar.is-ended .time,.rvip-bar.is-ended .lbl{display:none;}
  .rvip-bar.is-ended .ended-text{display:inline;}
  @media (max-width:480px){
    .rvip-bar{padding:8px 12px;gap:6px;}
    .rvip-bar .lbl{font-size:10px;letter-spacing:.16em;}
    .rvip-bar .time{font-size:13px;}
  }

  /* === COUNTDOWN (legacy, retained for back-compat if reintroduced) === */
  .rvip-clock{background:rgba(255,247,241,0.12);backdrop-filter:blur(10px);border:1px solid rgba(255,247,241,0.32);border-radius:18px;padding:18px;margin:22px 0 18px;}
  .rvip-clock .lbl{font-size:11px;letter-spacing:.22em;font-weight:800;color:#fff;text-transform:uppercase;margin:0 0 12px;display:flex;align-items:center;gap:8px;}
  .rvip-clock .lbl::before{content:"";width:8px;height:8px;border-radius:50%;background:#fff;animation:rvipPulse 1.6s ease-in-out infinite;}
  @keyframes rvipPulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(255,255,255,0.55);}50%{opacity:.5;box-shadow:0 0 0 8px rgba(255,255,255,0);}}
  .rvip-clock .digits{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
  .rvip-clock .cell{background:var(--white);border:none;border-radius:12px;padding:12px 6px;text-align:center;box-shadow:0 6px 18px rgba(122,30,42,0.18);}
  .rvip-clock .n{font-size:30px;font-weight:800;line-height:1;color:var(--rasp-deep);font-variant-numeric:tabular-nums;letter-spacing:-0.01em;}
  .rvip-clock .u{display:block;margin-top:6px;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);font-weight:700;}
  .rvip-clock .ended{display:none;font-size:13px;color:#fff;margin:10px 0 0;font-weight:700;text-align:center;}
  .rvip-clock.is-ended .digits{opacity:.5;}
  .rvip-clock.is-ended .ended{display:block;}

  /* === FLAVOR REVEAL === */
  .rvip-flavor{background:#fff;}
  .rvip-flavor .grid{display:grid;grid-template-columns:1fr;gap:28px;align-items:center;}
  .rvip-flavor .img{aspect-ratio:1/1;border-radius:24px;overflow:hidden;background:#fff;position:relative;border:6px solid var(--rasp);padding:14px;box-shadow:0 18px 40px rgba(122,30,42,0.18);}
  .rvip-flavor .img img{width:100%;height:100%;object-fit:cover;display:block;border-radius:14px;}
  .rvip-flavor .img::after{content:"REPLACES 12 DAILY VITAMINS · 1 DELICIOUS DRINK";position:absolute;bottom:26px;left:26px;right:26px;background:rgba(255,255,255,0.96);color:var(--rasp-deep);font-size:10px;letter-spacing:.14em;font-weight:800;padding:9px 14px;border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,0.22);text-align:center;line-height:1.3;}

  /* === STUDIO GALLERY === */
  .rvip-gallery{display:grid;grid-template-columns:1fr;gap:14px;margin:22px 0 0;}
  .rvip-gallery .tile{aspect-ratio:3/4;border-radius:20px;overflow:hidden;background:var(--pink-wash);position:relative;}
  .rvip-gallery .tile img{width:100%;height:100%;object-fit:cover;display:block;}
  .rvip-gallery .tile .cap{position:absolute;left:14px;bottom:14px;background:#fff;color:var(--rasp);font-size:10px;letter-spacing:.18em;font-weight:800;padding:7px 11px;border-radius:999px;text-transform:uppercase;}

  /* === CLOSER IMAGE === */
  .rvip-closer{aspect-ratio:16/10;border-radius:24px;overflow:hidden;background:var(--pink-wash);margin:0 0 26px;max-width:520px;margin-left:auto;margin-right:auto;}
  .rvip-closer img{width:100%;height:100%;object-fit:cover;display:block;}
  .rvip-flavor ul{list-style:none;padding:0;margin:18px 0 22px;}
  .rvip-flavor li{font-size:15px;line-height:1.5;padding:10px 0 10px 30px;position:relative;color:var(--ink);}
  .rvip-flavor li strong{color:var(--rasp);font-weight:800;}
  .rvip-flavor li::before{content:"";position:absolute;left:2px;top:13px;width:14px;height:18px;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23C63947'><path d='M12 2.5c3.5 4.5 6.5 8.2 6.5 11.8a6.5 6.5 0 0 1-13 0c0-3.6 3-7.3 6.5-11.8Z'/></svg>");background-size:contain;background-repeat:no-repeat;background-position:center;}

  /* === BENEFIT STRIP === */
  .rvip-ben{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border-radius:20px;overflow:hidden;}
  .rvip-ben .card{background:#fff;padding:22px 14px;text-align:center;}
  .rvip-ben .ico{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin:0 auto 10px;border-radius:50%;background:var(--rasp-soft);color:var(--rasp);}
  .rvip-ben .ico svg{width:22px;height:22px;display:block;}
  .rvip-ben .lbl{font-size:13px;font-weight:800;color:var(--ink);letter-spacing:.02em;margin:0 0 4px;}
  .rvip-ben .sub{font-size:12px;color:var(--ink-soft);line-height:1.4;}

  /* === BUYBOX === */
  .rvip-bb{background:#fff;border:2px solid var(--rasp);border-radius:24px;padding:24px;display:grid;grid-template-columns:1fr;gap:22px;box-shadow:0 20px 50px rgba(198,57,71,0.14);position:relative;}
  .rvip-bb .vip-banner{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--rasp);color:#fff;border:none;font-size:11px;letter-spacing:.22em;font-weight:800;text-transform:uppercase;padding:7px 16px;border-radius:999px;white-space:nowrap;box-shadow:0 6px 18px rgba(198,57,71,0.35);}
  .rvip-bb .prod-img{aspect-ratio:1/1;border-radius:18px;background:var(--pink-wash);overflow:hidden;}
  .rvip-bb .prod-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .rvip-bb .plan{border:2px solid var(--line);border-radius:14px;padding:16px;margin:0 0 10px;cursor:pointer;display:flex;align-items:flex-start;gap:12px;position:relative;background:#fff;}
  .rvip-bb .plan.sel{border-color:var(--rasp);background:var(--rasp-soft);}
  .rvip-bb .plan input{position:absolute;opacity:0;pointer-events:none;}
  .rvip-bb .radio{width:20px;height:20px;border-radius:50%;border:2px solid #c5cbd9;flex-shrink:0;margin-top:2px;position:relative;}
  .rvip-bb .plan.sel .radio{border-color:var(--rasp);}
  .rvip-bb .plan.sel .radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--rasp);}
  .rvip-bb .plan-body{flex:1;}
  .rvip-bb .plan-title{font-weight:800;font-size:16px;display:flex;flex-wrap:wrap;align-items:center;gap:6px;color:var(--ink);}
  .rvip-bb .plan-meta{font-size:13px;color:var(--ink-mute);margin-top:4px;line-height:1.45;}
  .rvip-bb .plan-meta.small{font-size:12px;color:var(--ink-soft);margin-top:2px;}
  .rvip-bb .plan-price{display:flex;flex-direction:column;align-items:flex-end;text-align:right;white-space:nowrap;flex-shrink:0;font-weight:500;}
  .rvip-bb .plan-price .strike{font-size:13px;text-decoration:line-through;opacity:.55;margin:0 0 2px;}
  .rvip-bb .plan-price .mo{font-weight:800;font-size:18px;color:var(--ink);line-height:1.1;}
  .rvip-bb .plan-price .total{font-size:12px;color:var(--ink-mute);margin-top:2px;}
  .rvip-bb .plan-price .save{font-size:12px;color:var(--rasp-deep);font-weight:700;margin-top:4px;}
  .rvip-bb .badge{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;background:var(--rasp);color:#fff;padding:4px 9px;border-radius:6px;font-weight:800;box-shadow:0 2px 6px rgba(198,57,71,0.28);}
  .rvip-bb .badge--vip{background:var(--ink);color:var(--cream);box-shadow:0 2px 6px rgba(26,24,20,0.25);}
  .rvip-bb .badge--pop{background:var(--rasp-deep);color:#fff;box-shadow:0 2px 6px rgba(122,30,42,0.3);}
  .rvip-bb .badge--best{background:var(--ink);color:#fff;box-shadow:0 2px 6px rgba(26,24,20,0.25);}
  .rvip-bb .reassure{font-size:12px;color:var(--ink-soft);text-align:center;margin:14px 0 0;line-height:1.5;}
  .rvip-bb .prod-features{margin:14px 0 0;font-size:13px;color:var(--ink-mute);padding-left:0;}
  .rvip-bb .prod-features li{padding:4px 0 4px 22px;position:relative;list-style:none;}
  .rvip-bb .prod-features li::before{content:"✓";position:absolute;left:0;color:var(--rasp);font-weight:800;}
  .rvip-bb .plan-gift{display:inline-flex;align-items:center;gap:5px;background:var(--rasp-soft);color:var(--rasp-deep);font-size:12px;font-weight:800;padding:4px 9px;border-radius:6px;margin:8px 0 0;letter-spacing:.01em;line-height:1.2;}
  .rvip-bb .plan-gift svg{width:13px;height:13px;flex-shrink:0;}

  /* === WHY VIP === */
  .rvip-why{display:grid;grid-template-columns:1fr;gap:14px;margin:24px 0 0;}
  .rvip-why .card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;}
  .rvip-why .card .n{font-size:11px;letter-spacing:.22em;font-weight:800;color:var(--rasp);text-transform:uppercase;margin:0 0 8px;}
  .rvip-why .card h3{font-size:17px;margin:0 0 8px;}
  .rvip-why .card p{margin:0;font-size:14.5px;color:var(--ink-mute);line-height:1.55;}

  /* === FAQ === */
  .rvip-faq details{border-bottom:1px solid var(--line);padding:16px 0;}
  .rvip-faq summary{cursor:pointer;font-weight:700;font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:12px;color:var(--ink);}
  .rvip-faq summary::-webkit-details-marker{display:none;}
  .rvip-faq summary::after{content:"+";font-weight:400;font-size:22px;line-height:1;color:var(--rasp);}
  .rvip-faq details[open] summary::after{content:"−";}
  .rvip-faq p{margin:10px 0 0;font-size:15px;color:var(--ink-mute);}

  /* === FINAL CTA === */
  .rvip-final{background:var(--rasp);color:#fff;text-align:center;position:relative;overflow:hidden;}
  .rvip-final::before{content:"";position:absolute;inset:0;background:radial-gradient(80% 60% at 90% 10%,var(--rasp-bright),transparent 60%),radial-gradient(70% 60% at 10% 100%,var(--rasp-deep),transparent 65%);pointer-events:none;}
  .rvip-final h2,.rvip-final p{color:#fff;}
  .rvip-final .inner{position:relative;}
  .rvip-final .rvip-clock{max-width:420px;margin:22px auto;}

  /* === DESKTOP === */
  @media (min-width:768px){
    .rvip p{font-size:17px;}
    .rvip h1{font-size:60px;}
    .rvip h2{font-size:42px;}
    .rvip .sec{padding:72px 0;}
    .rvip-hero{padding:72px 0 72px;}
    .rvip-hero .grid{grid-template-columns:1.1fr 1fr;gap:56px;}
    .rvip-hero .hero-img{aspect-ratio:4/5;}
    .rvip-clock .digits{gap:14px;}
    .rvip-clock .cell{padding:18px 8px;}
    .rvip-clock .n{font-size:48px;}
    .rvip-flavor .grid{grid-template-columns:1fr 1.05fr;gap:48px;}
    .rvip-gallery{grid-template-columns:repeat(3,1fr);gap:18px;}
    .rvip-ben{grid-template-columns:repeat(6,1fr);}
    .rvip-ben .card{padding:28px 14px;}
    .rvip-bb{grid-template-columns:0.9fr 1.1fr;padding:36px;gap:36px;}
    .rvip-why{grid-template-columns:repeat(3,1fr);}
  }
</style>

<div class="rvip" data-deadline="{{ section.settings.deadline_iso }}">

  {%- comment -%} === STICKY COUNTDOWN BAR === {%- endcomment -%}
  <div class="rvip-bar" data-clock>
    <span class="lbl">VIP Early Access Ends In</span>
    <span class="time"><span data-d>00</span><span class="u">d</span><span data-h>00</span><span class="u">h</span><span data-m>00</span><span class="u">m</span><span data-s>00</span><span class="u">s</span></span>
    <span class="ended-text">Public launch is live. Grab your bag before stock runs out.</span>
  </div>

  {%- comment -%} === VIP HERO === {%- endcomment -%}
  <section class="rvip-hero">
    <div class="inner">
      <div class="grid">
        <div>
          <div class="chips">
            <span class="vip-chip">{{ section.settings.chip_label }}</span>
            <span class="le-chip">Limited Edition · Summer Drop</span>
          </div>
          <h1>Meet Restore <span class="cream underlined">Raspberry</span>. The new pink drink.</h1>
          <p class="insider"><strong>The daily electrolyte + multivitamin drink, now in juicy raspberry.</strong> A limited edition summer flavor. Gone when it's gone.</p>
          <p class="proof"><span>Limited edition</span><span>Multivitamin drink</span><span>Zero sugar</span></p>

          <ul class="feats">
            <li><strong>All-day hydration.</strong> 900mg+ balanced electrolytes, no bloat.</li>
            <li><strong>Full multivitamin in every sip.</strong> No morning pill stack.</li>
            <li><strong>Daily detox support.</strong> Glutathione + vitamin C clear the load.</li>
            <li><strong>Juicy raspberry. Zero sugar.</strong> 28 delicious servings per bag.</li>
          </ul>

          <p style="margin-top:8px;"><a href="#buybox" class="btn">Try Today For $50.25</a></p>
          <p class="trust" style="color:var(--ink-mute);">Free shipping on $50+ · 30-day money-back guarantee · 25% off first sub</p>
        </div>
        <div class="hero-img">
          <img src="{{ 'restore-studio-splash.jpg' | asset_url }}" alt="Restore Raspberry splashing into the glass" loading="eager">
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} === FLAVOR REVEAL === {%- endcomment -%}
  <section class="rvip-flavor sec">
    <div class="inner">
