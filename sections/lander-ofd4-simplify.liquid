  .adv4-cat{font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:var(--accent-deep);margin-bottom:14px}
  .adv4-h1{font-size:clamp(28px,5vw,42px);line-height:1.12;font-weight:700;color:var(--ink);letter-spacing:-.015em;margin:0 0 14px}
  .adv4-h1 em{font-style:italic;color:var(--ink)}
  .adv4-deck{font-size:18px;line-height:1.42;color:var(--ink-soft);font-weight:400;margin:0 0 18px;font-style:italic}
  .adv4-meta{display:flex;align-items:center;gap:12px;font-size:12.5px;color:var(--muted);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0;margin-bottom:18px;flex-wrap:wrap}
