{% comment %}
  Restore Raspberry — Hot Girl Summer (OFD11) lander.
  Page: /pages/restore-summer
  Template: templates/page.restore-summer.json
  Layout adapted from /pages/ofd3-hollywood-secret-wlp-1.
  Color palette: TAC Blue + Raspberry (brand magenta) + pink/cream washes.
{% endcomment %}

{%- liquid
  assign restore = all_products['restore']
-%}

<style>
  /* Suppress site-wide popups on this lander (Klaviyo signup, etc.) */
  body .klaviyo-form,
  body div[class*="klaviyo-form-"],
  body div[data-testid="klaviyo-form"],
  body .needsclick[class*="kl-private-reset-css"]{display:none !important;visibility:hidden !important;}
  .rsum{
    --blue:#4659FF;
    --blue-soft:rgba(70,89,255,0.08);
    --rasp:#E1225C;
    --rasp-soft:rgba(225,34,92,0.08);
    --pink-wash:#FFEEF3;
    --cream:#FFF7F1;
    --ink:#0d1117;
    --ink-mute:#3a4150;
    --ink-soft:#7a8298;
    --line:#f1d6df;
  }
  .rsum *,.rsum *::before,.rsum *::after{box-sizing:border-box;}
  .rsum{color:var(--ink);padding:0;}
  .rsum p{margin:0 0 14px;font-size:16px;line-height:1.6;color:var(--ink-mute);}
  .rsum h1,.rsum h2,.rsum h3{margin:0 0 14px;letter-spacing:-0.01em;font-weight:800;color:var(--ink);}
  .rsum h1{font-size:34px;line-height:1.08;}
  .rsum h2{font-size:28px;line-height:1.15;}
  .rsum h3{font-size:18px;line-height:1.3;}
  .rsum .eb{font-size:11px;letter-spacing:.18em;font-weight:700;color:var(--rasp);margin:0 0 12px;text-transform:uppercase;}
  .rsum .eb--blue{color:var(--blue);}
  .rsum .blue{color:var(--blue);}
  .rsum .rasp{color:var(--rasp);}
  .rsum .ital{font-style:italic;font-weight:800;color:var(--rasp);}
  .rsum .strike{text-decoration:line-through;opacity:.5;font-weight:500;margin-right:6px;}
  .rsum .inner{max-width:1140px;margin:0 auto;padding:0 20px;}
  .rsum .sec{padding:48px 0;}
  .rsum .sec--pink{background:var(--pink-wash);}
  .rsum .sec--cream{background:var(--cream);}
  .rsum .sec--rasp{background:linear-gradient(135deg,#FF3D7F 0%,#E1225C 100%);color:#fff;}
  .rsum .sec--rasp h2,.rsum .sec--rasp h3,.rsum .sec--rasp p{color:#fff;}
  .rsum .center{text-align:center;}

  .rsum .btn{display:inline-block;background:var(--rasp);color:#fff;font-weight:700;font-size:15px;letter-spacing:.04em;padding:16px 28px;border-radius:999px;text-decoration:none;text-align:center;border:none;cursor:pointer;transition:transform .15s;}
  .rsum .btn:hover{transform:translateY(-1px);}
  .rsum .btn--blue{background:var(--blue);}
  .rsum .btn--ghost{background:#fff;color:var(--ink);border:2px solid var(--ink);}
  .rsum .btn--white{background:#fff;color:var(--rasp);}
  .rsum .btn.full{display:block;width:100%;}

  .rsum .stars{color:var(--rasp);font-size:16px;letter-spacing:1px;display:inline-flex;align-items:center;gap:8px;}
  .rsum .stars small{color:var(--ink-mute);font-weight:600;font-size:13px;letter-spacing:0;}

  .rsum .trust{font-size:12px;color:var(--ink-mute);margin:10px 0 0;letter-spacing:.02em;}

  /* === HERO === */
  .rsum-hero{padding:32px 0 36px;background:linear-gradient(180deg,var(--pink-wash) 0%,#fff 100%);}
  .rsum-hero .grid{display:grid;grid-template-columns:1fr;gap:24px;align-items:center;}
  .rsum-hero .hero-img{aspect-ratio:4/5;border-radius:24px;overflow:hidden;background:#eceff5;position:relative;}
  .rsum-hero .hero-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .rsum-hero .hero-img::after{content:"NEW LIMITED TIME RASPBERRY FLAVOR";position:absolute;top:18px;left:18px;background:var(--rasp);color:#fff;font-size:10px;letter-spacing:.16em;font-weight:800;padding:7px 12px;border-radius:999px;}
  .rsum-hero ul{list-style:none;padding:0;margin:18px 0 22px;}
  .rsum-hero li{font-size:15px;line-height:1.5;padding:8px 0 8px 32px;position:relative;color:var(--ink);}
  .rsum-hero li::before{content:"";position:absolute;left:0;top:12px;width:20px;height:20px;border-radius:50%;background:var(--rasp);}
  .rsum-hero li::after{content:"";position:absolute;left:6px;top:17px;width:9px;height:5px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg);}

  /* === STAT GRID === */
  .rsum-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--pink-wash);border-radius:20px;overflow:hidden;}
  .rsum-stat{background:#fff;padding:24px 16px;text-align:center;}
  .rsum-stat .n{font-size:30px;font-weight:800;line-height:1;margin:0 0 6px;}
  .rsum-stat:nth-child(odd) .n{color:var(--blue);}
  .rsum-stat:nth-child(even) .n{color:var(--rasp);}
  .rsum-stat .l{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute);}
  .rsum-stats-blurb{margin:24px 0 0;font-size:15px;color:var(--ink-mute);text-align:center;line-height:1.55;}

  /* === FEATURED TESTIMONIAL === */
  .rsum-pull{background:#fff;border:2px solid var(--rasp);border-radius:24px;padding:32px 24px;text-align:center;max-width:720px;margin:0 auto;position:relative;}
  .rsum-pull::before{content:"\201C";position:absolute;top:-30px;left:50%;transform:translateX(-50%);width:60px;height:60px;background:var(--rasp);color:#fff;font-size:60px;line-height:1;border-radius:50%;display:flex;align-items:center;justify-content:center;padding-top:22px;}
  .rsum-pull blockquote{margin:0 0 16px;font-size:20px;line-height:1.4;font-weight:600;color:var(--ink);}
  .rsum-pull .meta{font-size:13px;color:var(--ink-mute);font-weight:700;letter-spacing:.04em;}
  .rsum-pull .meta span{color:var(--ink-soft);font-weight:500;display:block;margin-top:4px;letter-spacing:0;}
  .rsum-tsupport{display:grid;grid-template-columns:1fr;gap:14px;margin:32px 0 0;}
  .rsum-tsupport .card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;}
  .rsum-tsupport .card .st{color:var(--rasp);font-size:14px;letter-spacing:.06em;margin:0 0 10px;font-weight:800;}
  .rsum-tsupport .card blockquote{margin:0 0 14px;font-size:15.5px;line-height:1.55;color:var(--ink);font-weight:500;}
  .rsum-tsupport .card .who{font-size:12.5px;color:var(--ink-mute);letter-spacing:.04em;font-weight:700;text-transform:uppercase;}

  /* === BUYBOX === */
  .rsum-bb{background:#fff;border:1px solid var(--line);border-radius:24px;padding:24px;display:grid;grid-template-columns:1fr;gap:22px;box-shadow:0 20px 50px rgba(225,34,92,0.08);}
  .rsum-bb .prod-wrap{position:relative;}
  .rsum-bb .prod-flag{position:absolute;top:14px;left:14px;z-index:2;background:var(--rasp);color:#fff;font-size:10.5px;letter-spacing:.14em;font-weight:800;padding:7px 11px;border-radius:999px;text-transform:uppercase;box-shadow:0 6px 16px rgba(225,34,92,0.28);}
  .rsum-bb .prod-img{aspect-ratio:1/1;border-radius:18px;background:#fff;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:18px;}
  .rsum-bb .prod-img img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block;}
  .rsum-bb .plan{border:2px solid var(--line);border-radius:14px;padding:16px;margin:0 0 10px;cursor:pointer;display:flex;align-items:flex-start;gap:12px;position:relative;background:#fff;}
  .rsum-bb .plan.sel{border-color:var(--rasp);background:var(--rasp-soft);}
  .rsum-bb .plan input{position:absolute;opacity:0;pointer-events:none;}
  .rsum-bb .radio{width:20px;height:20px;border-radius:50%;border:2px solid #c5cbd9;flex-shrink:0;margin-top:2px;position:relative;}
  .rsum-bb .plan.sel .radio{border-color:var(--rasp);}
  .rsum-bb .plan.sel .radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--rasp);}
  .rsum-bb .plan-body{flex:1;}
  .rsum-bb .plan-title{font-weight:800;font-size:16px;display:flex;flex-wrap:wrap;align-items:center;gap:6px;color:var(--ink);}
  .rsum-bb .plan-meta{font-size:13px;color:var(--ink-mute);margin-top:4px;line-height:1.45;}
  .rsum-bb .plan-meta.small{font-size:12px;color:var(--ink-soft);margin-top:2px;}
  .rsum-bb .plan-price{display:flex;flex-direction:column;align-items:flex-end;text-align:right;white-space:nowrap;flex-shrink:0;font-weight:500;}
  .rsum-bb .plan-price .strike{font-size:13px;text-decoration:line-through;opacity:.55;margin:0 0 2px;}
  .rsum-bb .plan-price .mo{font-weight:800;font-size:18px;color:var(--ink);line-height:1.1;}
  .rsum-bb .plan-price .total{font-size:12px;color:var(--ink-mute);margin-top:2px;}
  .rsum-bb .plan-price .save{font-size:12px;color:var(--blue);font-weight:700;margin-top:4px;}
  .rsum-bb .badge{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;background:var(--rasp);color:#fff;padding:4px 9px;border-radius:6px;font-weight:800;box-shadow:0 2px 6px rgba(225,34,92,0.25);}
  .rsum-bb .badge--pop{background:var(--blue);color:#fff;box-shadow:0 2px 6px rgba(70,89,255,0.25);}
  .rsum-bb .badge--best{background:#1d2230;color:#fff;box-shadow:0 2px 6px rgba(29,34,48,0.25);}
  .rsum-bb .reassure{font-size:12px;color:var(--ink-soft);text-align:center;margin:14px 0 0;line-height:1.5;}
  .rsum-bb .prod-features{margin:14px 0 0;font-size:13px;color:var(--ink-mute);padding-left:0;}
  .rsum-bb .prod-features li{padding:4px 0 4px 22px;position:relative;list-style:none;}
  .rsum-bb .prod-features li::before{content:"✓";position:absolute;left:0;color:var(--rasp);font-weight:800;}

  /* === BRAND STORY === */
  .rsum-story{display:grid;grid-template-columns:1fr;gap:24px;align-items:center;}
  .rsum-story .img{aspect-ratio:4/3;border-radius:20px;overflow:hidden;background:#eceff5;}
  .rsum-story .img img{width:100%;height:100%;object-fit:cover;display:block;}

  /* === INGREDIENT CARDS === */
  .rsum-ing{display:grid;grid-template-columns:1fr;gap:14px;margin:22px 0 0;}
  .rsum-ing .card{background:#fff;border-radius:18px;padding:24px;border:1px solid var(--line);}
  .rsum-ing .card:nth-child(even){border-color:#cdd3ff;}
  .rsum-ing .card .n{font-size:22px;font-weight:800;line-height:1;margin:0 0 10px;color:var(--rasp);}
  .rsum-ing .card:nth-child(even) .n{color:var(--blue);}
  .rsum-ing .card h3{font-size:17px;margin:0 0 6px;line-height:1.25;}
  .rsum-ing p{margin:6px 0 0;font-size:14.5px;color:var(--ink-mute);line-height:1.55;}

  /* === COMPARISON === */
  .rsum-cmp{width:100%;border-collapse:collapse;font-size:13px;margin:22px 0 0;background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 8px 24px rgba(225,34,92,0.06);}
  .rsum-cmp th,.rsum-cmp td{padding:12px 8px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top;}
  .rsum-cmp thead th{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mute);font-weight:700;background:var(--pink-wash);}
  .rsum-cmp .col-us{background:var(--rasp-soft);font-weight:700;}
  .rsum-cmp .col-us strong{color:var(--rasp);}

  /* === MBG === */
  .rsum-mbg{border-radius:24px;padding:40px 24px;text-align:center;color:#fff;background:linear-gradient(135deg,#FF3D7F 0%,#E1225C 100%);}
  .rsum-mbg h2,.rsum-mbg p{color:#fff;}
  .rsum-mbg .eb{color:rgba(255,255,255,0.85);}

  /* === FAQ === */
  .rsum-faq details{border-bottom:1px solid var(--line);padding:16px 0;}
  .rsum-faq summary{cursor:pointer;font-weight:700;font-size:16px;list-style:none;display:flex;justify-content:space-between;gap:12px;color:var(--ink);}
  .rsum-faq summary::-webkit-details-marker{display:none;}
  .rsum-faq summary::after{content:"+";font-weight:400;font-size:22px;line-height:1;color:var(--rasp);}
  .rsum-faq details[open] summary::after{content:"−";}
  .rsum-faq p{margin:10px 0 0;font-size:15px;color:var(--ink-mute);}

  /* === FINAL CTA === */
  .rsum-final{text-align:center;}

  /* === KLAVIYO REVIEWS WIDGET WRAP === */
  .rsum-kr{background:#fff;border-radius:20px;padding:24px;border:1px solid var(--line);}
  .rsum-kr-head{display:flex;flex-direction:column;align-items:center;gap:8px;margin:0 0 18px;text-align:center;}
  .rsum-kr-stars{font-size:22px;color:var(--rasp);letter-spacing:2px;}
  .rsum-kr-rating{font-size:14px;color:var(--ink-mute);font-weight:600;}

  /* === GALLERY === */
  .rsum-gal{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:22px 0 0;}
  .rsum-gal .tile{aspect-ratio:1/1;border-radius:14px;background:var(--pink-wash);overflow:hidden;}
  .rsum-gal .tile img{width:100%;height:100%;object-fit:cover;display:block;}
  .rsum-gal .tile.ph{display:flex;align-items:center;justify-content:center;color:var(--ink-soft);font-size:11px;letter-spacing:.06em;text-transform:uppercase;text-align:center;padding:8px;}

  /* === DESKTOP === */
  @media (min-width:768px){
    .rsum p{font-size:17px;}
    .rsum h1{font-size:56px;}
    .rsum h2{font-size:40px;}
    .rsum .sec{padding:72px 0;}
    .rsum-hero{padding:56px 0 72px;}
    .rsum-hero .grid{grid-template-columns:1.05fr 1fr;gap:48px;}
    .rsum-hero .hero-img{aspect-ratio:4/5;}
    .rsum-stats{grid-template-columns:repeat(4,1fr);}
    .rsum-stat{padding:36px 16px;}
    .rsum-stat .n{font-size:42px;}
    .rsum-pull{padding:48px 40px;}
    .rsum-pull blockquote{font-size:26px;}
    .rsum-tsupport{grid-template-columns:repeat(3,1fr);}
    .rsum-bb{grid-template-columns:0.9fr 1.1fr;padding:36px;gap:36px;}
    .rsum-story{grid-template-columns:1fr 1.1fr;gap:48px;}
    .rsum-ing{grid-template-columns:repeat(3,1fr);}
    .rsum-cmp{font-size:15px;}
    .rsum-cmp th,.rsum-cmp td{padding:16px 14px;}
    .rsum-mbg{padding:64px 32px;}
    .rsum-gal{grid-template-columns:repeat(6,1fr);}
    .rsum-kr{padding:36px;}
  }
</style>

<div class="rsum">

  {%- comment -%} === HERO === {%- endcomment -%}
  <section class="rsum-hero">
    <div class="inner">
      <div class="grid">
        <div>
          <p class="eb">{{ section.settings.eyebrow }}</p>
