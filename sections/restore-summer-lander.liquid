<script>
  /* Suppress Klaviyo signup popup on this lander */
  (function(){
    try {
      window._klOnsite = window._klOnsite || [];
      window._klOnsite.push(['openForm', '']);
      var killPopups = function(){
        document.querySelectorAll('.klaviyo-form, [data-testid="klaviyo-form"], div[class*="klaviyo-form-"]').forEach(function(el){
          el.style.display = 'none';
        });
      };
      killPopups();
      var obs = new MutationObserver(killPopups);
      obs.observe(document.body, {childList:true, subtree:true});
      setTimeout(function(){ obs.disconnect(); }, 15000);
    } catch(e) {}
  })();
  (function(){
    var PLANS = {
      '1mo': { variant: 52876415992097, selling_plan: 690941395233 },
      '2mo': { variant: 52876416024865, selling_plan: 690941559073 },
      '3mo': { variant: 52876416385313, selling_plan: 690975899937 }
    };
    var opts = document.querySelectorAll('.rsum-bb .plan');
    var atc = document.getElementById('rsum-atc');
    var selected = '1mo';
    opts.forEach(function(o){
      o.addEventListener('click', function(){
        opts.forEach(function(x){ x.classList.remove('sel'); });
        o.classList.add('sel');
        selected = o.getAttribute('data-plan');
        var total = o.getAttribute('data-total');
        atc.textContent = 'Add to Cart · $' + total;
      });
    });
    atc.addEventListener('click', function(e){
      e.preventDefault();
      var plan = PLANS[selected];
      if (!plan) return;
      atc.textContent = 'Adding...';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          items: [{ id: plan.variant, quantity: 1, selling_plan: plan.selling_plan }]
        })
      }).then(function(r){
        if (!r.ok) throw new Error('add failed');
        window.location.href = '/checkout';
      }).catch(function(){
        atc.textContent = 'Try again';
      });
    });
  })();
</script>

