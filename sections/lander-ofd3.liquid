<script>
(function(){
  var root = document.querySelector('.ofd3');
  if(!root) return;

  // Buy box option selector
  var opts = root.querySelectorAll('[data-opt]');
  var buyCta = root.querySelector('[data-buy-cta]');
  var stickCta = root.querySelector('[data-stick-cta]');
  var stickPrice = root.querySelector('[data-stick-price]');

  opts.forEach(function(opt){
    opt.addEventListener('click', function(){
      opts.forEach(function(o){ o.classList.remove('is-on'); });
      opt.classList.add('is-on');
      var radio = opt.querySelector('input');
      if(radio) radio.checked = true;
      var cart = opt.getAttribute('data-cart');
      var price = opt.getAttribute('data-price');
      var period = opt.getAttribute('data-period');
      if(buyCta && cart) buyCta.setAttribute('href', cart);
      if(stickCta && cart) stickCta.setAttribute('href', cart);
      if(stickPrice && price){
        stickPrice.innerHTML = price + ' <small>' + (period || '') + '</small>';
      }
    });
  });

  // ATC handler — POST to /cart/add.js so the selling_plan actually attaches
  // (cart permalinks like /cart/X:1?selling_plan=Y silently drop the plan on absorbmore.com,
  // so without this the subscription discount never applies).
  function parseCart(url){
    var m = (url || '').match(/\/cart\/(\d+):(\d+)(?:\?selling_plan=(\d+))?/);
    if(!m) return null;
    return { id: m[1], quantity: parseInt(m[2], 10) || 1, selling_plan: m[3] || null };
  }
  function atcClick(e){
    var cta = e.currentTarget;
    var url = cta.getAttribute('href') || '';
    var parsed = parseCart(url);
    if(!parsed){ return; }
    e.preventDefault();
    var origLabel = cta.innerHTML;
    cta.setAttribute('aria-busy','true');
    cta.innerHTML = 'Adding…';
    var body = { id: parsed.id, quantity: parsed.quantity };
    if(parsed.selling_plan) body.selling_plan = parsed.selling_plan;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    }).then(function(){ window.location.href = '/checkout'; })
      .catch(function(){ window.location.href = url; })
      .finally(function(){ cta.innerHTML = origLabel; cta.removeAttribute('aria-busy'); });
  }
  root.querySelectorAll('[data-atc]').forEach(function(c){ c.addEventListener('click', atcClick); });

  // Sticky mobile CTA reveal after hero
  var stick = root.querySelector('[data-stick]');
  var hero = root.querySelector('.ofd3-hero');
  if(stick && hero){
    var heroBottom = function(){ return hero.getBoundingClientRect().bottom; };
    var onScroll = function(){
      if(heroBottom() < 60){ stick.classList.add('is-on'); }
      else { stick.classList.remove('is-on'); }
    };
    window.addEventListener('scroll', onScroll, {passive:true});
    onScroll();
  }
})();
</script>

