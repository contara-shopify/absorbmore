{%- comment -%} OFD3 - Hollywood Secret WLP-1 lander. Ian Somerhalder celebrity-co-founder angle. "How do you think we stay in this shape?" / "The medicine Hollywood doesn't want you to have." TAC Blue (#4659FF) primary + warm orange (#FF7815) accent. Same format as OFF2 + WLP-1 MD lander. {%- endcomment -%}

{%- liquid
  assign hero_img    = section.settings.hero_img      | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/ian-wlp-lander.jpg'
  assign bottle_img  = section.settings.bottle_img    | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/wlp1-hero-jar.jpg'
  assign buy_img     = section.settings.buy_img       | default: 'https://www.absorbmore.com/cdn/shop/files/TAC_PDP-Image_WLP1.png?v=1774483977&width=960'
  assign video_src    = section.settings.video_src     | default: ''
  assign video_poster = section.settings.video_poster  | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/ian-wlp-lander.jpg'
  assign cart_1mo    = section.settings.cart_1mo      | default: '/cart/52472821121313:1?selling_plan=691162546465'
  assign cart_3mo    = section.settings.cart_3mo      | default: '/cart/52472821154081:1?selling_plan=691162579233'
  assign cart_6mo    = section.settings.cart_6mo      | default: '/cart/52472821186849:1?selling_plan=691166544161'
  assign price_1mo_per = section.settings.price_1mo_per | default: '$79.20/mo'
  assign price_1mo_total = section.settings.price_1mo_total | default: '$79.20'
  assign price_1mo_was = section.settings.price_1mo_was | default: '$99.20'
  assign price_1mo_save = section.settings.price_1mo_save | default: '$20.00'
  assign price_3mo_per = section.settings.price_3mo_per | default: '$69.00/mo'
  assign price_3mo_total = section.settings.price_3mo_total | default: '$207.00'
  assign price_3mo_was = section.settings.price_3mo_was | default: '$296.00'
  assign price_3mo_save = section.settings.price_3mo_save | default: '$89.00'
  assign price_6mo_per = section.settings.price_6mo_per | default: '$64.00/mo'
  assign price_6mo_total = section.settings.price_6mo_total | default: '$384.00'
  assign price_6mo_was = section.settings.price_6mo_was | default: '$594.00'
  assign price_6mo_save = section.settings.price_6mo_save | default: '$210.00'
  assign rating      = section.settings.rating        | default: '4.5'
  assign review_count = section.settings.review_count | default: '1,200+'
-%}

<style>
  .ofd3 { --bg:#ffffff; --bg-soft:#f6f8ff; --bg-tint:#eef2ff; --paper:#fafbff; --ink:#0a1233; --ink-soft:#2a3260; --muted:#6b7390; --line:#dfe4f7; --line-soft:#ecf0fb; --brand:#4659FF; --brand-hover:#3a4ad9; --brand-deep:#2c39b3; --brand-tint:#e6e9ff; --accent:#FF7815; --accent-hover:#e76b0e; --accent-deep:#c25a0c; --accent-tint:#ffe9d6; --gold:#FF7815; --ink-deep:#080d24;
    background:var(--bg); color:var(--ink); font-family:'Inter','Helvetica Neue',Arial,sans-serif; -webkit-font-smoothing:antialiased; line-height:1.5; }
  .ofd3 *{box-sizing:border-box}
  .ofd3 img{max-width:100%;display:block}
  .ofd3 a{color:inherit;text-decoration:none}
  .ofd3 .wrap{max-width:1180px;margin:0 auto;padding:0 18px}

  /* ---------- STICKY TOP BAR ---------- */
  .ofd3-bar{position:sticky;top:0;z-index:60;background:var(--ink-deep);color:#fff;border-bottom:1px solid rgba(255,255,255,.08)}
  .ofd3-bar__row{display:flex;align-items:center;justify-content:center;gap:10px;padding:10px 14px;font-size:13px;flex-wrap:wrap;text-align:center;line-height:1.3}
  .ofd3-bar__lead{font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#fff}
  .ofd3-bar__lead em{font-style:normal;color:var(--accent);font-weight:700}
  .ofd3-bar__sep{opacity:.5;color:#fff}
  @media(max-width:480px){.ofd3-bar__row{font-size:12px;gap:6px}.ofd3-bar__sep{display:none}}

  /* ---------- HERO ---------- */
  .ofd3-hero{background:linear-gradient(180deg,var(--bg) 0%,var(--bg-soft) 100%);position:relative;overflow:hidden;padding:32px 0 44px;color:var(--ink);border-bottom:1px solid var(--line-soft)}
  .ofd3-hero__grid{display:grid;grid-template-columns:1fr;gap:22px;align-items:center;position:relative}
  @media(min-width:880px){.ofd3-hero__grid{grid-template-columns:1.05fr .95fr;gap:48px;padding:18px 0}}
  @media(max-width:879px){
    .ofd3-hero{padding:14px 0 24px}
    .ofd3-hero__grid{gap:16px}
    .ofd3-hero__eyebrow{margin-bottom:8px}
    .ofd3-hero h1{margin-bottom:8px}
    .ofd3-hero__quote-attr{margin-bottom:10px}
  }

  .ofd3-hero__eyebrow{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;padding:0;border-radius:0;margin-bottom:18px}
  .ofd3-hero__eyebrow svg{width:13px;height:13px;color:var(--accent)}

  .ofd3-hero h1{font-size:clamp(30px,5.6vw,50px);line-height:1.02;letter-spacing:-.035em;font-weight:800;margin:0 0 14px;color:var(--ink-deep)}
  .ofd3-hero h1 em{font-style:normal;color:var(--brand)}
  .ofd3-hero h1 .gold{color:var(--accent);font-style:normal}
  .ofd3-hero h1 .nowrap{white-space:nowrap}
  .ofd3-hero__sub{font-size:clamp(15px,2vw,18px);max-width:540px;margin:0 0 18px;color:var(--ink-soft);line-height:1.5}
  .ofd3-hero__sub b{color:var(--ink);font-weight:600}

  .ofd3-hero__quote-attr{display:inline-flex;align-items:center;gap:6px;background:var(--brand-tint);border:1px solid var(--line);border-radius:999px;padding:5px 11px;margin:0 0 14px;font-size:12px;color:var(--ink);letter-spacing:.02em}
  .ofd3-hero__quote-attr svg{width:13px;height:13px;color:var(--brand);flex:0 0 auto}
  .ofd3-hero__quote-attr b{color:var(--ink);font-weight:700}

  .ofd3-hero__bullets{list-style:none;padding:0;margin:0 0 18px;display:grid;gap:8px;max-width:540px}
  .ofd3-hero__bullets li{display:flex;align-items:flex-start;gap:10px;font-size:15px;font-weight:500;color:var(--ink);line-height:1.4}
  .ofd3-hero__bullets li strong{font-weight:700;color:var(--ink-deep)}
  .ofd3-hero__bullets li svg{width:20px;height:20px;flex:0 0 auto;color:var(--brand);margin-top:2px}

  .ofd3-hero__pricing{display:flex;align-items:baseline;gap:14px;margin:14px 0 6px;flex-wrap:wrap}
  .ofd3-hero__price-now{font-weight:800;font-size:clamp(26px,4vw,36px);color:var(--ink-deep);letter-spacing:-.02em;line-height:1}
  .ofd3-hero__price-was{font-size:clamp(15px,2vw,18px);color:var(--muted);text-decoration:line-through;font-weight:500}
  .ofd3-hero__price-tag{font-weight:700;color:#fff;background:var(--accent);font-size:11px;text-transform:uppercase;letter-spacing:.06em;padding:4px 8px;border-radius:4px}

  .ofd3-hero__cta{display:inline-flex;align-items:center;justify-content:center;width:100%;max-width:440px;padding:16px 30px;background:var(--brand);color:#fff !important;font-weight:600;font-size:15px;letter-spacing:.01em;border-radius:2px;border:none;cursor:pointer;transition:background .2s ease;text-decoration:none}
  .ofd3-hero__cta *{color:#fff !important}
  .ofd3-hero__cta:hover{background:var(--brand-hover)}
  .ofd3-hero__cta:after{content:" →";margin-left:10px;color:#fff;transition:transform .2s}
  .ofd3-hero__cta:hover:after{transform:translateX(3px)}

  .ofd3-hero__guarantee{display:flex;align-items:center;gap:8px;margin-top:14px;font-size:13px;color:var(--ink-soft)}
  .ofd3-hero__guarantee svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}

  .ofd3-hero__media{position:relative;text-align:center}
  .ofd3-hero__card{background:var(--bg-soft);border-radius:8px;padding:0;position:relative;width:100%;max-width:380px;margin:0 auto;aspect-ratio:4/5;border:1px solid var(--line)}
  .ofd3-hero__card>.ofd3-hero__frame{position:absolute;inset:0;border-radius:8px;overflow:hidden}
  .ofd3-hero__card video, .ofd3-hero__card img.ofd3-hero__poster{width:100%;height:100%;object-fit:cover;object-position:center center;display:block;cursor:pointer}
  .ofd3-hero__play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,rgba(0,0,0,0) 40%,rgba(0,0,0,.35) 100%);cursor:pointer;border:0;padding:0;width:100%;height:100%}
  .ofd3-hero__play__btn{width:64px;height:64px;background:rgba(255,255,255,.96);border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(0,0,0,.3);transition:transform .2s}
  .ofd3-hero__play:hover .ofd3-hero__play__btn{transform:scale(1.08)}
  .ofd3-hero__play__btn svg{width:22px;height:22px;color:var(--ink-deep);margin-left:3px}
  .ofd3-hero__playing .ofd3-hero__play{display:none}
  .ofd3-hero__cap{position:absolute;left:14px;top:14px;background:rgba(8,13,36,.78);color:#fff;border-radius:4px;padding:6px 10px;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;backdrop-filter:blur(6px);z-index:3;max-width:calc(100% - 110px)}
  .ofd3-hero__cap em{font-style:normal;color:var(--accent)}
  .ofd3-hero__badge{position:absolute;top:-12px;right:-12px;background:var(--accent);color:#fff;border-radius:999px;width:96px;height:96px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:700;line-height:1;transform:rotate(-8deg);border:3px solid var(--bg);box-shadow:0 6px 14px rgba(8,13,36,.18);z-index:4}
  .ofd3-hero__badge big{font-size:22px;color:#fff;letter-spacing:-.01em}
  .ofd3-hero__badge span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin-top:2px;color:#fff}
  .ofd3-hero__inset{position:absolute;bottom:-18px;left:-18px;width:42%;aspect-ratio:1/1;background:var(--bg-tint);border-radius:6px;overflow:hidden;border:4px solid var(--bg);box-shadow:0 8px 20px rgba(8,13,36,.18);z-index:3}
  .ofd3-hero__inset img{width:100%;height:100%;object-fit:cover;display:block}
  @media(max-width:879px){
    .ofd3-hero__card{max-width:320px}
    .ofd3-hero__inset{width:44%;bottom:-14px;left:-12px}
  }

  /* ---------- TRUST STRIP ---------- */
  .ofd3-trust{background:var(--bg-soft);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:14px 0}
  .ofd3-trust__row{display:grid;grid-template-columns:1fr;gap:10px 16px;text-align:left;font-size:13px;font-weight:500;color:var(--ink)}
  @media(min-width:520px){.ofd3-trust__row{grid-template-columns:1fr 1fr;text-align:center}}
  @media(min-width:720px){.ofd3-trust__row{grid-template-columns:repeat(5,1fr);font-size:13px}}
  .ofd3-trust__cell{display:flex;align-items:center;justify-content:flex-start;gap:8px}
  @media(min-width:520px){.ofd3-trust__cell{justify-content:center}}
  .ofd3-trust__cell svg{width:18px;height:18px;color:var(--brand);flex:0 0 auto}
  .ofd3-trust__stars{color:var(--accent);letter-spacing:1px;font-size:14px}

  /* ---------- URGENCY BAND (Hollywood callout) ---------- */
  .ofd3-urg{background:var(--ink-deep);color:#fff;padding:48px 0;position:relative;overflow:hidden}
  .ofd3-urg__inner{text-align:center;position:relative;max-width:900px;margin:0 auto}
  .ofd3-urg__chip{display:inline-flex;align-items:center;gap:10px;background:transparent;color:#fff;font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;padding:0;border-radius:0;margin-bottom:18px}
  .ofd3-urg__chip::before{content:"";display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%}
  .ofd3-urg__head{font-size:clamp(26px,4.6vw,42px);line-height:.98;letter-spacing:-.035em;font-weight:800;margin:0 0 14px;color:#fff;max-width:920px;margin-left:auto;margin-right:auto}
  .ofd3-urg__head em{font-style:normal;color:var(--accent)}
  .ofd3-urg__sub{font-size:clamp(14px,1.8vw,17px);color:rgba(255,255,255,.82);margin:0 0 22px;max-width:680px;margin-left:auto;margin-right:auto;line-height:1.55}
  .ofd3-urg__cta{display:inline-flex;align-items:center;justify-content:center;padding:16px 30px;background:var(--accent);color:#fff !important;font-weight:600;font-size:14.5px;letter-spacing:.01em;border-radius:2px;text-decoration:none;transition:background .2s}
  .ofd3-urg__cta:hover{background:var(--accent-hover)}
  .ofd3-urg__cta:after{content:" →";margin-left:10px;color:#fff}

  /* ---------- SECTION BASE ---------- */
  .ofd3-sec{padding:56px 0}
  .ofd3-sec--blue{background:var(--bg-tint)}
  .ofd3-sec--soft{background:var(--bg-soft)}
  .ofd3-sec--ink{background:var(--ink-deep);color:#fff}
  .ofd3-sec--ink h2,.ofd3-sec--ink h3{color:#fff}
  .ofd3-sec__eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.24em;font-weight:700;color:var(--ink);margin:0 0 12px;display:inline-flex;align-items:center;gap:10px}
  .ofd3-sec__eyebrow::before{content:"";display:inline-block;width:6px;height:6px;background:var(--brand);border-radius:50%}
  .ofd3-sec__title{font-size:clamp(26px,4.5vw,38px);font-weight:800;letter-spacing:-.035em;color:var(--ink-deep);margin:0 0 10px;line-height:1}
  .ofd3-sec__sub{font-size:16px;color:var(--ink-soft);max-width:680px;margin:0 0 28px;line-height:1.55}
  .ofd3-sec--ink .ofd3-sec__title{color:#fff}
  .ofd3-sec--ink .ofd3-sec__sub{color:rgba(255,255,255,.82)}
  .ofd3-sec--ink .ofd3-sec__eyebrow{color:rgba(255,255,255,.85)}
  .ofd3-sec--ink .ofd3-sec__eyebrow::before{background:var(--accent)}

  /* ---------- BENEFITS NUMBERS ---------- */
  .ofd3-benefits{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  @media(min-width:720px){.ofd3-benefits{grid-template-columns:repeat(4,1fr);gap:14px}}
  .ofd3-benefit{background:#fff;border:1px solid var(--line);border-radius:8px;padding:20px 14px;text-align:center;position:relative;overflow:hidden}
  .ofd3-benefit__num{font-size:clamp(28px,4.5vw,40px);font-weight:800;color:var(--ink-deep);letter-spacing:-.035em;line-height:1}
  .ofd3-benefit__num em{font-style:normal;color:var(--brand)}
  .ofd3-benefit__lbl{font-size:13px;font-weight:500;color:var(--ink-soft);margin-top:8px;line-height:1.3}
  .ofd3-benefit__ref{display:block;font-size:10px;color:var(--muted);margin-top:6px}

  .ofd3-benefit-list{display:grid;grid-template-columns:repeat(1,1fr);gap:10px;margin-top:28px;max-width:720px;margin-left:auto;margin-right:auto}
  @media(min-width:600px){.ofd3-benefit-list{grid-template-columns:repeat(2,1fr)}}
  .ofd3-bl-item{background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px 16px;display:flex;align-items:center;gap:12px}
  .ofd3-bl-item__ico{width:38px;height:38px;border-radius:8px;background:var(--brand-tint);color:var(--brand-deep);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
  .ofd3-bl-item__ico svg{width:22px;height:22px}
  .ofd3-bl-item__txt{font-size:14px;font-weight:600;color:var(--ink);line-height:1.3}
  .ofd3-bl-item__txt small{display:block;font-weight:400;color:var(--ink-soft);font-size:12px;margin-top:2px}

  /* ---------- FEATURED TESTIMONIAL ---------- */
  .ofd3-feat{background:#fff;border:1px solid var(--line);border-radius:8px;padding:32px 28px;max-width:820px;margin:0 auto;position:relative}
  .ofd3-feat__stars{color:var(--accent);font-size:18px;letter-spacing:2px;margin-bottom:12px;text-align:center}
  .ofd3-feat__quote{font-size:clamp(20px,2.6vw,26px);line-height:1.3;font-weight:500;color:var(--ink-deep);text-align:center;margin:0 0 20px;letter-spacing:-.02em}
  .ofd3-feat__quote span{color:var(--brand)}
  .ofd3-feat__attrib{text-align:center;font-size:13px;color:var(--ink-soft)}
  .ofd3-feat__attrib b{color:var(--ink);font-weight:600}
  .ofd3-feat__verif{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--brand-deep);font-weight:600;margin-left:6px}
  .ofd3-feat__verif svg{width:12px;height:12px}

  .ofd3-quotes{display:grid;grid-template-columns:1fr;gap:14px;margin-top:26px}
  @media(min-width:720px){.ofd3-quotes{grid-template-columns:repeat(3,1fr)}}
  .ofd3-quote{background:#fff;border-radius:8px;padding:20px;border:1px solid var(--line)}
  .ofd3-quote__stars{color:var(--accent);font-size:14px;letter-spacing:1px;margin-bottom:8px}
  .ofd3-quote__txt{font-size:14px;color:var(--ink);line-height:1.55;margin:0 0 12px}
  .ofd3-quote__name{font-size:13px;font-weight:600;color:var(--ink-deep)}
  .ofd3-quote__verif{font-size:11px;color:var(--brand-deep);display:flex;align-items:center;gap:4px;margin-top:2px;font-weight:600}
  .ofd3-quote__verif svg{width:11px;height:11px}

  /* ---------- BUY BOX ---------- */
  .ofd3-buy{background:#fff;border:1px solid var(--line);border-radius:8px;padding:26px;max-width:600px;margin:0 auto;box-shadow:0 6px 30px rgba(70,89,255,.06)}
  .ofd3-buy__flag{display:inline-flex;align-items:center;gap:10px;background:transparent;color:var(--ink);font-weight:700;font-size:11px;letter-spacing:.24em;text-transform:uppercase;padding:0;border-radius:0;margin-bottom:14px}
  .ofd3-buy__flag::before{content:"";display:inline-block;width:6px;height:6px;background:var(--accent);border-radius:50%}
  .ofd3-buy__hero{background:var(--bg-soft);border:1px solid var(--line-soft);border-radius:8px;padding:14px;margin:0 0 18px;display:flex;align-items:center;justify-content:center;aspect-ratio:16/9;overflow:hidden}
  .ofd3-buy__hero img{max-width:80%;max-height:100%;width:auto;height:auto}
  .ofd3-buy h3{font-size:24px;font-weight:800;color:var(--ink-deep);margin:0 0 6px;letter-spacing:-.02em}
  .ofd3-buy__stars{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink-soft);margin:0 0 18px}
  .ofd3-buy__stars b{color:var(--accent);letter-spacing:1px}

  .ofd3-buy__sub{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.24em;color:var(--ink);margin:0 0 14px}

  .ofd3-opts{display:grid;grid-template-columns:1fr;gap:10px;margin:0 0 18px}
  .ofd3-opt{display:flex;align-items:flex-start;gap:12px;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:16px;cursor:pointer;transition:border-color .15s, background .15s;position:relative}
  .ofd3-opt input{position:absolute;opacity:0;pointer-events:none}
  .ofd3-opt__bullet{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--line);flex:0 0 auto;display:flex;align-items:center;justify-content:center;background:#fff;transition:border-color .15s;margin-top:2px}
  .ofd3-opt__bullet::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--accent);transform:scale(0);transition:transform .15s}
  .ofd3-opt__main{flex:1;min-width:0}
  .ofd3-opt__title{font-size:15px;font-weight:700;color:var(--ink-deep);display:flex;align-items:center;gap:6px;flex-wrap:wrap;line-height:1.25}
  .ofd3-opt__chip{display:inline-block;background:var(--accent);color:#fff;font-weight:600;font-size:10px;text-transform:uppercase;letter-spacing:.08em;padding:3px 8px;border-radius:2px}
  .ofd3-opt__chip--blue{background:var(--brand);color:#fff}
  .ofd3-opt__meta{font-size:12px;color:var(--ink-soft);margin-top:4px;line-height:1.4}
  .ofd3-opt__gift{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:var(--accent-deep);background:var(--accent-tint);border-radius:3px;padding:3px 7px;margin-top:6px;line-height:1.2}
  .ofd3-opt__gift svg{width:13px;height:13px;flex:0 0 auto}
  .ofd3-opt__gift b{color:var(--ink-deep);font-weight:700}
  .ofd3-opt__fine{font-size:11px;color:var(--muted);margin-top:6px}
  .ofd3-opt__price{text-align:right;flex:0 0 auto;line-height:1.2;margin-left:8px}
  .ofd3-opt__price b{display:block;font-size:18px;font-weight:800;color:var(--ink-deep);letter-spacing:-.02em}
  .ofd3-opt__price-row{display:block;font-size:11px;color:var(--ink-soft);font-weight:500;margin-top:3px}
  .ofd3-opt__price-row s{color:var(--muted);font-weight:400;margin-right:3px}
  .ofd3-opt__save{display:block;font-size:11px;color:var(--brand-deep);font-weight:600;margin-top:2px}
  .ofd3-opt.is-on{border-color:var(--accent);background:var(--accent-tint)}
  .ofd3-opt.is-on .ofd3-opt__bullet{border-color:var(--accent)}
