<script>
  (function() {
    function ctrPbvFactory(el) {
      var dataTag = document.getElementById('ctr-pbv-data-' + el.getAttribute('data-section-id'));
      if (!dataTag) return {};
      var DATA = JSON.parse(dataTag.textContent);
      var VARIANT_IDS = DATA.variantIds;
      var VARIANT_DATA = DATA.variantData;
      var RASPBERRY_EXISTS = DATA.raspberryExists;
      var RASPBERRY_AVAILABLE = DATA.raspberryAvailable;
      var TIERS = DATA.tiers;

    return {
      /* state */
      format: 'bag',
      selectedTier: 'sub-1m',
      bagFlavors: ['mango', 'mango', 'mango'],
      buyOnceQty: 1,
      isAdding: false,
      galleryIndex: 0,
      mobileStickyVisible: false,
      giftModalOpen: false,

      /* consts */
      VARIANT_IDS,
      VARIANT_DATA,
      RASPBERRY_EXISTS,
      RASPBERRY_AVAILABLE,
      TIERS,

      /* -- computed -- */
      get currentBagCount() {
        return this.selectedTier === 'one-time' ? 1 : TIERS[this.selectedTier].bagCount;
      },

      get isSubscription() {
        return this.selectedTier !== 'one-time';
      },

      /* -- helpers -- */
      getVariantId(format, flavor) {
        return VARIANT_IDS[format]?.[flavor] || VARIANT_IDS[format]?.mango;
      },

      getSellingPlanId(tier, format, flavor) {
        const variantId = this.getVariantId(format, flavor);
        const planKey = TIERS[tier]?.planKey;
        if (!planKey || !variantId) return undefined;
        return VARIANT_DATA[variantId]?.sellingPlans?.[planKey] || undefined;
      },

      getTierPrice(tier) {
        const variantId = this.getVariantId(this.format, 'mango');
        if (!variantId || !VARIANT_DATA[variantId]) return 0;
        if (tier === 'one-time') return VARIANT_DATA[variantId].prices.regular;
        return VARIANT_DATA[variantId].prices[tier]?.price || 0;
      },

      getTierCompareAt(tier) {
        if (tier === 'one-time') return 0;
        const variantId = this.getVariantId(this.format, 'mango');
        if (!variantId || !VARIANT_DATA[variantId]) return 0;
        return VARIANT_DATA[variantId].prices[tier]?.compareAt || 0;
      },

      formatMoney(cents) {
        if (typeof window.utils?.formatMoney === 'function') return window.utils.formatMoney(cents);
        return '$' + (cents / 100).toFixed(2).replace(/\.00$/, '');
      },

      /* -- actions -- */
      setFormat(fmt) {
        this.format = fmt;
        if (fmt === 'sticks') {
          this.bagFlavors = ['mango', 'mango', 'mango'];
        }
      },

      setFlavor(bagIndex, flavor) {
        const next = [...this.bagFlavors];
        next[bagIndex] = flavor;
        this.bagFlavors = next;
      },

      adjustQty(delta) {
        this.buyOnceQty = Math.max(1, this.buyOnceQty + delta);
      },

      /* -- Gallery -- */
      onMobileGalleryScroll(el) {
        const slides = el.querySelectorAll('.ctr-pbv__gallery-mobile-slide');
        if (!slides.length) return;
        const slideWidth = slides[0].offsetWidth + 12;
        const index = Math.min(Math.round(el.scrollLeft / slideWidth), slides.length - 1);
        if (index !== this.galleryIndex) this.galleryIndex = index;
      },

      scrollMobileGallery(index) {
        const el = this.$refs.mobileGallery;
        if (!el) return;
        const slides = el.querySelectorAll('.ctr-pbv__gallery-mobile-slide');
        if (!slides[index]) return;
        el.scrollTo({ left: slides[index].offsetLeft - 20, behavior: 'smooth' });
        this.galleryIndex = index;
      },

      /* -- Add to Cart -- */
      async addToCart() {
        if (this.isAdding) return;
        this.isAdding = true;

        try {
          const items = [];

          if (this.selectedTier === 'one-time') {
            const variantId = this.getVariantId(this.format, this.bagFlavors[0] || 'mango');
            items.push({ id: variantId, quantity: this.buyOnceQty });
          } else {
            const tier = TIERS[this.selectedTier];
            for (let i = 0; i < tier.bagCount; i++) {
              const flavor = this.bagFlavors[i] || 'mango';
              const variantId = this.getVariantId(this.format, flavor);
              const sellingPlanId = this.getSellingPlanId(this.selectedTier, this.format, flavor);
              const item = { id: variantId, quantity: 1 };
              if (sellingPlanId) item.selling_plan = sellingPlanId;
              items.push(item);
            }
          }

          if (typeof window._cart?.add === 'function') {
            const data = await window._cart.add({ items });
            if (!data?.cart_error && typeof window._stores?.modal?.setId === 'function') {
              window._stores.modal.setId('modal--cart-drawer');
            }
          } else {
            const response = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
              body: JSON.stringify({ items })
            });
            if (!response.ok) throw new Error('Cart error');
            document.dispatchEvent(new CustomEvent('cart:refresh'));
            const drawer = document.querySelector('[data-cart-drawer], cart-drawer, #CartDrawer');
            if (drawer?.open) {
              drawer.open();
            } else if (typeof window.theme?.openCartDrawer === 'function') {
              window.theme.openCartDrawer();
            } else {
              window.location.href = '/cart';
            }
          }
        } catch (err) {
          console.error('[ctr-pbv] Cart add failed:', err);
        } finally {
          this.isAdding = false;
        }
      },

      /* -- Mobile sticky observer -- */
      init() {
        if (!window.matchMedia('(max-width: 767px)').matches || !('IntersectionObserver' in window) || !this.$refs.primaryCta) return;
        const observer = new IntersectionObserver(
          ([entry]) => { this.mobileStickyVisible = !entry.isIntersecting; },
          { threshold: 0.2 }
        );
        observer.observe(this.$refs.primaryCta);
      }
    };
  }
  window.ctrPbvFactory = ctrPbvFactory;
  })();
</script>

<section
  class="ctr-pbv {{ section.settings.container_spacing }}"
  id="{{ product_form_id }}"
  data-section-id="{{ section.id }}"
  x-data="ctrPbvFactory($el)"
>
  <div class="ctr-pbv__inner">

    {%- comment -%} ==== MOBILE: title + rating (above gallery, hidden on desktop) ==== {%- endcomment -%}
    <div class="ctr-pbv__mobile-header">
      <div class="ctr-pbv__title-row">
        <h2 class="ctr-pbv__title">{{ title | escape }}</h2>
        {%- if section.settings.clinicians_badge_image != blank -%}
          <img
            src="{{ section.settings.clinicians_badge_image | image_url: width: 300 }}"
            alt="{{ section.settings.clinicians_badge_image.alt | default: 'Clinicians Choice' }}"
            width="150" height="30" loading="lazy"
            class="ctr-pbv__clinicians-badge"
          >
        {%- endif -%}
      </div>
      <div class="ctr-pbv__rating-row">
        <span class="ctr-pbv__stars" aria-hidden="true">
          {% for _ in (1..5) %}
            <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true"><path d="M10 1.2l2.57 5.2 5.74.84-4.16 4.06.98 5.72L10 14.3l-5.13 2.72.98-5.72L1.7 7.24l5.74-.84L10 1.2z"/></svg>
          {% endfor %}
        </span>
        <span><strong>{{ reviews_rating | round: 2 }}</strong>{% if section.settings.show_review_count %} ({{ reviews_count }}){% endif %}</span>
      </div>
    </div>

    {%- comment -%} ==== LEFT: Gallery (desktop) ==== {%- endcomment -%}
    <div class="ctr-pbv__gallery-layout">
      <div class="ctr-pbv__thumbs" aria-label="Product images">
        {% if image_1 != blank %}
          <button type="button" class="ctr-pbv__thumb is-active" :class="{ 'is-active': galleryIndex === 0 }" @click="galleryIndex = 0" aria-label="View image 1">
            {{ image_1 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', sizes: '70px', alt: title }}
          </button>
        {% endif %}
        {% if image_2 != blank %}
          <button type="button" class="ctr-pbv__thumb" :class="{ 'is-active': galleryIndex === 1 }" @click="galleryIndex = 1" aria-label="View image 2">
            {{ image_2 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', sizes: '70px', alt: title }}
          </button>
        {% endif %}
        {% if image_3 != blank %}
          <button type="button" class="ctr-pbv__thumb" :class="{ 'is-active': galleryIndex === 2 }" @click="galleryIndex = 2" aria-label="View image 3">
            {{ image_3 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', sizes: '70px', alt: title }}
          </button>
        {% endif %}
        {% if image_4 != blank %}
          <button type="button" class="ctr-pbv__thumb" :class="{ 'is-active': galleryIndex === 3 }" @click="galleryIndex = 3" aria-label="View image 4">
            {{ image_4 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', sizes: '70px', alt: title }}
          </button>
        {% endif %}
        {% if image_5 != blank %}
          <button type="button" class="ctr-pbv__thumb" :class="{ 'is-active': galleryIndex === 4 }" @click="galleryIndex = 4" aria-label="View image 5">
            {{ image_5 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', sizes: '70px', alt: title }}
          </button>
        {% endif %}
      </div>

      <div class="ctr-pbv__hero-image">
        {% if image_1 != blank %}
          <div x-show="galleryIndex === 0">
            {{ image_1 | image_url: width: 1200 | image_tag: loading: 'eager', widths: '480,720,960,1200', sizes: '(max-width: 989px) 100vw, 50vw', alt: title }}
          </div>
        {% endif %}
        {% if image_2 != blank %}
          <div x-cloak x-show="galleryIndex === 1">
            {{ image_2 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480,720,960,1200', sizes: '(max-width: 989px) 100vw, 50vw', alt: title }}
          </div>
        {% endif %}
        {% if image_3 != blank %}
          <div x-cloak x-show="galleryIndex === 2">
            {{ image_3 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480,720,960,1200', sizes: '(max-width: 989px) 100vw, 50vw', alt: title }}
          </div>
        {% endif %}
        {% if image_4 != blank %}
          <div x-cloak x-show="galleryIndex === 3">
            {{ image_4 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480,720,960,1200', sizes: '(max-width: 989px) 100vw, 50vw', alt: title }}
          </div>
        {% endif %}
        {% if image_5 != blank %}
          <div x-cloak x-show="galleryIndex === 4">
            {{ image_5 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480,720,960,1200', sizes: '(max-width: 989px) 100vw, 50vw', alt: title }}
          </div>
        {% endif %}
      </div>

      {%- if section.settings.frontrow_product_id != blank -%}
        {%- assign _fr_iframe_id = 'iframe-frontrow-quant-' | append: section.id -%}
        {% render 'ctr-frontrow-widget',
          product_id: section.settings.frontrow_product_id,
          wrapper_class: 'ctr-pbv__frontrow',
          iframe_id: _fr_iframe_id
        %}
      {%- endif -%}
    </div>

    {%- comment -%} ==== Mobile gallery ==== {%- endcomment -%}
    <div class="ctr-pbv__gallery-mobile" @scroll.passive="onMobileGalleryScroll($event.target)" x-ref="mobileGallery">
      {% if image_1 != blank %}
        <div class="ctr-pbv__gallery-mobile-slide">
          {{ image_1 | image_url: width: 900 | image_tag: loading: 'eager', widths: '480,720,900', sizes: '90vw', alt: title }}
        </div>
      {% endif %}
      {% if image_2 != blank %}
        <div class="ctr-pbv__gallery-mobile-slide">
          {{ image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,720,900', sizes: '90vw', alt: title }}
        </div>
      {% endif %}
      {% if image_3 != blank %}
        <div class="ctr-pbv__gallery-mobile-slide">
          {{ image_3 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,720,900', sizes: '90vw', alt: title }}
        </div>
      {% endif %}
      {% if image_4 != blank %}
        <div class="ctr-pbv__gallery-mobile-slide">
          {{ image_4 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,720,900', sizes: '90vw', alt: title }}
        </div>
      {% endif %}
      {% if image_5 != blank %}
        <div class="ctr-pbv__gallery-mobile-slide">
          {{ image_5 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,720,900', sizes: '90vw', alt: title }}
        </div>
      {% endif %}
    </div>

    <div class="ctr-pbv__gallery-dots">
      {% if image_1 != blank %}<button type="button" class="ctr-pbv__gallery-dot" :class="{ 'is-active': galleryIndex === 0 }" @click="scrollMobileGallery(0)" aria-label="Slide 1"></button>{% endif %}
      {% if image_2 != blank %}<button type="button" class="ctr-pbv__gallery-dot" :class="{ 'is-active': galleryIndex === 1 }" @click="scrollMobileGallery(1)" aria-label="Slide 2"></button>{% endif %}
      {% if image_3 != blank %}<button type="button" class="ctr-pbv__gallery-dot" :class="{ 'is-active': galleryIndex === 2 }" @click="scrollMobileGallery(2)" aria-label="Slide 3"></button>{% endif %}
      {% if image_4 != blank %}<button type="button" class="ctr-pbv__gallery-dot" :class="{ 'is-active': galleryIndex === 3 }" @click="scrollMobileGallery(3)" aria-label="Slide 4"></button>{% endif %}
      {% if image_5 != blank %}<button type="button" class="ctr-pbv__gallery-dot" :class="{ 'is-active': galleryIndex === 4 }" @click="scrollMobileGallery(4)" aria-label="Slide 5"></button>{% endif %}
    </div>

    {%- comment -%} ==== MOBILE: Ingredients/Benefits below gallery (hidden on desktop) ==== {%- endcomment -%}
    <div class="ctr-pbv__mobile-links">
      {% if section.settings.ingredients_link_text != blank %}
        <a href="{{ section.settings.ingredients_link_url | default: '#ingredients' }}">{{ section.settings.ingredients_link_text | escape }}</a>
      {% endif %}
      {% if section.settings.ingredients_link_text != blank and section.settings.benefits_link_text != blank %}
        <span class="ctr-pbv__links-sep" aria-hidden="true">&middot;</span>
      {% endif %}
      {% if section.settings.benefits_link_text != blank %}
        <a href="{{ section.settings.benefits_link_url | default: '#benefits' }}">{{ section.settings.benefits_link_text | escape }}</a>
      {% endif %}
    </div>

    {%- comment -%} ==== RIGHT: Copy + Purchase UI ==== {%- endcomment -%}
    <div class="ctr-pbv__copy">

      {%- comment -%} == DEBUG -- remove before launch == {%- endcomment -%}
      {% comment %} <div style="background:#ffeb3b;color:#000;padding:10px 14px;font:11px/1.7 monospace;border:2px solid red;border-radius:8px;">
        <strong>DEBUG</strong><br>
        raspberry_variant_id setting: <b>{{ section.settings.bag_raspberry_variant_id }}</b><br>
        bag_raspberry_variant found: <b>{{ raspberry_exists }}</b><br>
        bag_raspberry_variant.id: <b>{{ bag_raspberry_variant.id }}</b><br>
        bag_raspberry_variant.available: <b>{{ bag_raspberry_variant.available }}</b><br>
        bag_raspberry_variant.inventory_quantity: <b>{{ bag_raspberry_variant.inventory_quantity }}</b><br>
        raspberry_available: <b>{{ raspberry_available }}</b><br>
        all variants:
        {% for v in product.variants %}id={{ v.id }} | {{ v.title }} | available={{ v.available }}<br>{% endfor %}
      </div> {% endcomment %}

      {%- comment -%} Title row - title + Clinicians' Choice badge {%- endcomment -%}
      <div class="ctr-pbv__title-row">
        <h2 class="ctr-pbv__title">{{ title | escape }}</h2>
        {%- if section.settings.clinicians_badge_image != blank -%}
          <img
            src="{{ section.settings.clinicians_badge_image | image_url: width: 300 }}"
            alt="{{ section.settings.clinicians_badge_image.alt | default: 'Clinicians Choice' }}"
            width="150"
            height="30"
            loading="lazy"
            class="ctr-pbv__clinicians-badge"
          >
        {%- endif -%}
      </div>

      {%- comment -%} Star rating row - rating + count + links {%- endcomment -%}
      <div class="ctr-pbv__rating-row">
        <span class="ctr-pbv__stars" aria-hidden="true">
          {% for _ in (1..5) %}
            <svg viewBox="0 0 20 20" focusable="false" aria-hidden="true">
              <path d="M10 1.2l2.57 5.2 5.74.84-4.16 4.06.98 5.72L10 14.3l-5.13 2.72.98-5.72L1.7 7.24l5.74-.84L10 1.2z"/>
            </svg>
          {% endfor %}
        </span>
        <span>
          <strong>{{ reviews_rating | round: 2 }}</strong>
          {% if section.settings.show_review_count %}({{ reviews_count }}){% endif %}
        </span>
        <div class="ctr-pbv__rating-links">
          {% if section.settings.ingredients_link_text != blank %}
            <a href="{{ section.settings.ingredients_link_url | default: '#ingredients' }}">{{ section.settings.ingredients_link_text | escape }}</a>
          {% endif %}
          {% if section.settings.benefits_link_text != blank %}
            <a href="{{ section.settings.benefits_link_url | default: '#benefits' }}">{{ section.settings.benefits_link_text | escape }}</a>
          {% endif %}
        </div>
      </div>

      {%- comment -%} Description - shown when set {%- endcomment -%}
      {%- if section.settings.description != blank -%}
        <p class="ctr-pbv__description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- comment -%} Benefits bullet list (gold dots) {%- endcomment -%}
      {%- assign has_benefits = false -%}
      {%- for i in (1..6) -%}
        {%- assign _bkey = 'benefit_' | append: i -%}
        {%- if section.settings[_bkey] != blank -%}{%- assign has_benefits = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_benefits -%}
        <ul class="ctr-pbv__benefits">
          {% for i in (1..6) %}
            {%- assign bkey = 'benefit_' | append: i -%}
            {% if section.settings[bkey] != blank %}
              <li>
                {%- if section.settings.benefit_icon != blank -%}
                  <img
                    src="{{ section.settings.benefit_icon | image_url: width: 32 }}"
                    alt=""
                    aria-hidden="true"
                    class="ctr-pbv__benefit-dot"
                    width="16"
                    height="16"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="ctr-pbv__benefit-dot" aria-hidden="true"></span>
                {%- endif -%}
                <span>{{ section.settings[bkey] | escape }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {%- endif -%}

      {%- comment -%} -- BAG / STICKS format toggle -- {%- endcomment -%}
      {%- if section.settings.show_format_toggle -%}
        <div class="ctr-pbv__format-toggle" role="group" aria-label="Product format">
          <button
            type="button"
            class="ctr-pbv__format-btn"
            :class="{ 'is-active': format === 'bag' }"
            @click="setFormat('bag')"
          >{{ section.settings.format_bag_label | default: 'BAG' | escape }}</button>
          <button
            type="button"
            class="ctr-pbv__format-btn"
            :class="{ 'is-active': format === 'sticks' }"
            @click="setFormat('sticks')"
          >{{ section.settings.format_sticks_label | default: 'STICKS' | escape }}</button>
        </div>
      {%- endif -%}

      {%- comment -%} ==== Tier cards ==== {%- endcomment -%}
      <div class="ctr-pbv__tiers" role="radiogroup" aria-label="Purchase option">

        {%- comment -%} - 1 Month Supply (sub-1m) - {%- endcomment -%}
        <div
          class="ctr-pbv__tier-card"
          :class="{ 'is-selected': selectedTier === 'sub-1m' }"
          @click="selectedTier = 'sub-1m'"
          role="radio"
          :aria-checked="selectedTier === 'sub-1m'"
          tabindex="0"
          @keydown.enter="selectedTier = 'sub-1m'"
          @keydown.space.prevent="selectedTier = 'sub-1m'"
        >
          <div class="ctr-pbv__tier-head">
            <span class="ctr-pbv__tier-radio" aria-hidden="true"></span>
            <span class="ctr-pbv__tier-label">{{ section.settings.tier1_label | default: '1 Month Supply' | escape }}</span>
            {%- if section.settings.tier1_badge != blank -%}
              <span class="ctr-pbv__tier-badge">{{ section.settings.tier1_badge | default: '25% OFF' | escape }}</span>
            {%- else -%}
              <span class="ctr-pbv__tier-badge">25% OFF</span>
            {%- endif -%}
            <div class="ctr-pbv__tier-pricing">
              <span
                class="ctr-pbv__tier-compare"
                x-show="getTierCompareAt('sub-1m') > getTierPrice('sub-1m')"
                x-text="formatMoney(getTierCompareAt('sub-1m'))"
              ></span>
              <span class="ctr-pbv__tier-price" x-text="formatMoney(getTierPrice('sub-1m'))">{{ bag_mango_variant.selling_plan_allocations.first.price | default: bag_mango_variant.price | money }}</span>
            </div>
          </div>
          <ul class="ctr-pbv__perks ctr-pbv__perks--always">
            {% if section.settings.tier1_perk_1 != blank %}<li>{{ section.settings.tier1_perk_1 | escape }}</li>{% endif %}
            {% if section.settings.tier1_perk_2 != blank %}<li>{{ section.settings.tier1_perk_2 | escape }}</li>{% endif %}
            {% if section.settings.tier1_perk_3 != blank %}<li>{{ section.settings.tier1_perk_3 | escape }}</li>{% endif %}
          </ul>
          <div class="ctr-pbv__tier-body" x-show="selectedTier === 'sub-1m'" x-cloak>
            {%- comment -%} Flavor selector - Bag 1 only {%- endcomment -%}
            <div class="ctr-pbv__flavor-blocks">
              <div class="ctr-pbv__flavor-row">
                <div class="ctr-pbv__flavor-left">
                  <p class="ctr-pbv__flavor-label">{{ section.settings.flavor_select_label | default: 'Select Flavor' | escape }} - {{ section.settings.bag_label | default: 'Bag' | escape }} 1</p>
                  <div class="ctr-pbv__flavor-pills">
                    <button
                      type="button"
                      class="ctr-pbv__flavor-pill"
                      :class="{ 'is-selected': bagFlavors[0] === 'mango' }"
                      @click.stop="setFlavor(0, 'mango')"
                    >
                      <span class="ctr-pbv__flavor-swatch" style="background: #F5A623;" aria-hidden="true"></span>
                      {{ section.settings.flavor_mango_label | default: 'Mango' | escape }}
                    </button>
                    <button
                      type="button"
                      class="ctr-pbv__flavor-pill"
                      :class="{ 'is-selected': bagFlavors[0] === 'raspberry', 'is-sold-out': RASPBERRY_EXISTS && !RASPBERRY_AVAILABLE }"
                      x-show="format === 'bag' && RASPBERRY_EXISTS"
                      @click.stop="RASPBERRY_AVAILABLE && setFlavor(0, 'raspberry')"
                    >
                      <span class="ctr-pbv__flavor-swatch" style="background: #C0392B;" aria-hidden="true"></span>
                      {{ section.settings.flavor_raspberry_label | default: 'Raspberry' | escape }}
                      <template x-if="RASPBERRY_EXISTS && !RASPBERRY_AVAILABLE"><span> - Sold Out</span></template>
                    </button>
                  </div>
                </div>
                <div class="ctr-pbv__flavor-thumb">
                  <div x-show="bagFlavors[0] !== 'raspberry'">
                    {% if bag_mango_variant.featured_image != blank %}
                      {{ bag_mango_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                    {% elsif image_1 != blank %}
                      {{ image_1 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                    {% endif %}
                  </div>
                  {% if bag_raspberry_variant.featured_image != blank %}
                    <div x-show="bagFlavors[0] === 'raspberry'" x-cloak>
                      {{ bag_raspberry_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} - 2 Months Supply (sub-2m) - {%- endcomment -%}
        <div
          class="ctr-pbv__tier-card"
          :class="{ 'is-selected': selectedTier === 'sub-2m' }"
          @click="selectedTier = 'sub-2m'"
          role="radio"
          :aria-checked="selectedTier === 'sub-2m'"
          tabindex="0"
          @keydown.enter="selectedTier = 'sub-2m'"
          @keydown.space.prevent="selectedTier = 'sub-2m'"
        >
          <div class="ctr-pbv__tier-head">
            <span class="ctr-pbv__tier-radio" aria-hidden="true"></span>
            <span class="ctr-pbv__tier-label">{{ section.settings.tier2_label | default: '2 Months Supply' | escape }}</span>
            {%- if section.settings.tier2_badge != blank -%}
              <span class="ctr-pbv__tier-badge">{{ section.settings.tier2_badge | escape }}</span>
            {%- else -%}
              <span class="ctr-pbv__tier-badge">30% OFF</span>
            {%- endif -%}
            <div class="ctr-pbv__tier-pricing">
              <span
                class="ctr-pbv__tier-compare"
                x-show="getTierCompareAt('sub-2m') > getTierPrice('sub-2m')"
                x-text="formatMoney(getTierCompareAt('sub-2m'))"
              ></span>
              <span class="ctr-pbv__tier-price" x-text="formatMoney(getTierPrice('sub-2m'))">{{ bag_mango_variant.price | money }}</span>
            </div>
          </div>
          <ul class="ctr-pbv__perks ctr-pbv__perks--always">
            {% if section.settings.tier2_perk_1 != blank %}<li>{{ section.settings.tier2_perk_1 | escape }}</li>{% endif %}
            {% if section.settings.tier2_perk_2 != blank %}<li>{{ section.settings.tier2_perk_2 | escape }}</li>{% endif %}
            {% if section.settings.tier2_perk_3 != blank %}<li>{{ section.settings.tier2_perk_3 | escape }}</li>{% endif %}
          </ul>
          <div class="ctr-pbv__tier-body" x-show="selectedTier === 'sub-2m'" x-cloak>
            {%- comment -%} Bag 1 & Bag 2 flavor selectors {%- endcomment -%}
            <div class="ctr-pbv__flavor-blocks">
              {% for bag_num in (1..2) %}
                {%- assign bag_idx = bag_num | minus: 1 -%}
                <div class="ctr-pbv__flavor-row">
                  <div class="ctr-pbv__flavor-left">
                    <p class="ctr-pbv__flavor-label">{{ section.settings.flavor_select_label | default: 'Select Flavor' | escape }} - {{ section.settings.bag_label | default: 'Bag' | escape }} {{ bag_num }}</p>
                    <div class="ctr-pbv__flavor-pills">
                      <button
                        type="button"
                        class="ctr-pbv__flavor-pill"
                        :class="{ 'is-selected': bagFlavors[{{ bag_idx }}] === 'mango' }"
                        @click.stop="setFlavor({{ bag_idx }}, 'mango')"
                      >
                        <span class="ctr-pbv__flavor-swatch" style="background: #F5A623;" aria-hidden="true"></span>
                        {{ section.settings.flavor_mango_label | default: 'Mango' | escape }}
                      </button>
                      <button
                        type="button"
                        class="ctr-pbv__flavor-pill"
                        :class="{ 'is-selected': bagFlavors[{{ bag_idx }}] === 'raspberry', 'is-sold-out': RASPBERRY_EXISTS && !RASPBERRY_AVAILABLE }"
                        x-show="format === 'bag' && RASPBERRY_EXISTS"
                        @click.stop="RASPBERRY_AVAILABLE && setFlavor({{ bag_idx }}, 'raspberry')"
                      >
                        <span class="ctr-pbv__flavor-swatch" style="background: #C0392B;" aria-hidden="true"></span>
                        {{ section.settings.flavor_raspberry_label | default: 'Raspberry' | escape }}
                      </button>
                    </div>
                  </div>
                  <div class="ctr-pbv__flavor-thumb">
                    <div x-show="bagFlavors[{{ bag_idx }}] !== 'raspberry'">
                      {% if bag_mango_variant.featured_image != blank %}
                        {{ bag_mango_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                      {% elsif image_1 != blank %}
                        {{ image_1 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                      {% endif %}
                    </div>
                    {% if bag_raspberry_variant.featured_image != blank %}
                      <div x-show="bagFlavors[{{ bag_idx }}] === 'raspberry'" x-cloak>
                        {{ bag_raspberry_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        {%- comment -%} - 3 Months Supply (sub-3m) - {%- endcomment -%}
        <div
          class="ctr-pbv__tier-card"
          :class="{ 'is-selected': selectedTier === 'sub-3m' }"
          @click="selectedTier = 'sub-3m'"
          role="radio"
          :aria-checked="selectedTier === 'sub-3m'"
          tabindex="0"
          @keydown.enter="selectedTier = 'sub-3m'"
          @keydown.space.prevent="selectedTier = 'sub-3m'"
        >
          <div class="ctr-pbv__tier-head">
            <span class="ctr-pbv__tier-radio" aria-hidden="true"></span>
            <span class="ctr-pbv__tier-label">{{ section.settings.tier3_label | default: '3 Months Supply' | escape }}</span>
            {%- if section.settings.tier3_badge != blank -%}
              <span class="ctr-pbv__tier-badge">{{ section.settings.tier3_badge | escape }}</span>
            {%- else -%}
              <span class="ctr-pbv__tier-badge">35% OFF</span>
            {%- endif -%}
            <div class="ctr-pbv__tier-pricing">
              <span
                class="ctr-pbv__tier-compare"
                x-show="getTierCompareAt('sub-3m') > getTierPrice('sub-3m')"
                x-text="formatMoney(getTierCompareAt('sub-3m'))"
              ></span>
              <span class="ctr-pbv__tier-price" x-text="formatMoney(getTierPrice('sub-3m'))">{{ bag_mango_variant.price | money }}</span>
            </div>
          </div>
          <ul class="ctr-pbv__perks ctr-pbv__perks--always">
            {% if section.settings.tier3_perk_1 != blank %}<li>{{ section.settings.tier3_perk_1 | escape }}</li>{% endif %}
            {% if section.settings.tier3_perk_2 != blank %}<li>{{ section.settings.tier3_perk_2 | escape }}</li>{% endif %}
            {% if section.settings.tier3_perk_3 != blank %}<li>{{ section.settings.tier3_perk_3 | escape }}</li>{% endif %}
          </ul>
          <div class="ctr-pbv__tier-body" x-show="selectedTier === 'sub-3m'" x-cloak>
            {%- comment -%} Bag 1, 2 & 3 flavor selectors {%- endcomment -%}
            <div class="ctr-pbv__flavor-blocks">
              {% for bag_num in (1..3) %}
                {%- assign bag_idx = bag_num | minus: 1 -%}
                <div class="ctr-pbv__flavor-row">
                  <div class="ctr-pbv__flavor-left">
                    <p class="ctr-pbv__flavor-label">{{ section.settings.flavor_select_label | default: 'Select Flavor' | escape }} - {{ section.settings.bag_label | default: 'Bag' | escape }} {{ bag_num }}</p>
                    <div class="ctr-pbv__flavor-pills">
                      <button
                        type="button"
                        class="ctr-pbv__flavor-pill"
                        :class="{ 'is-selected': bagFlavors[{{ bag_idx }}] === 'mango' }"
                        @click.stop="setFlavor({{ bag_idx }}, 'mango')"
                      >
                        <span class="ctr-pbv__flavor-swatch" style="background: #F5A623;" aria-hidden="true"></span>
                        {{ section.settings.flavor_mango_label | default: 'Mango' | escape }}
                      </button>
                      <button
                        type="button"
                        class="ctr-pbv__flavor-pill"
                        :class="{ 'is-selected': bagFlavors[{{ bag_idx }}] === 'raspberry', 'is-sold-out': RASPBERRY_EXISTS && !RASPBERRY_AVAILABLE }"
                        x-show="format === 'bag' && RASPBERRY_EXISTS"
                        @click.stop="RASPBERRY_AVAILABLE && setFlavor({{ bag_idx }}, 'raspberry')"
                      >
                        <span class="ctr-pbv__flavor-swatch" style="background: #C0392B;" aria-hidden="true"></span>
                        {{ section.settings.flavor_raspberry_label | default: 'Raspberry' | escape }}
                      </button>
                    </div>
                  </div>
                  <div class="ctr-pbv__flavor-thumb">
                    <div x-show="bagFlavors[{{ bag_idx }}] !== 'raspberry'">
                      {% if bag_mango_variant.featured_image != blank %}
                        {{ bag_mango_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                      {% elsif image_1 != blank %}
                        {{ image_1 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                      {% endif %}
                    </div>
                    {% if bag_raspberry_variant.featured_image != blank %}
                      <div x-show="bagFlavors[{{ bag_idx }}] === 'raspberry'" x-cloak>
                        {{ bag_raspberry_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        {%- comment -%} - Buy Once - {%- endcomment -%}
        <div
          class="ctr-pbv__tier-card ctr-pbv__tier-card--buyonce"
          :class="{ 'is-selected': selectedTier === 'one-time' }"
          @click="selectedTier = 'one-time'"
          role="radio"
          :aria-checked="selectedTier === 'one-time'"
          tabindex="0"
          @keydown.enter="selectedTier = 'one-time'"
          @keydown.space.prevent="selectedTier = 'one-time'"
        >
          <div class="ctr-pbv__tier-head">
            <span class="ctr-pbv__tier-radio" aria-hidden="true"></span>
            <span class="ctr-pbv__tier-label">{{ section.settings.tier4_label | default: 'Buy Once' | escape }}</span>
            <div class="ctr-pbv__tier-pricing">
              <span class="ctr-pbv__tier-price" x-text="formatMoney(getTierPrice('one-time'))">{{ bag_mango_variant.price | money }}</span>
            </div>
          </div>
          {%- if section.settings.tier4_perk_1 != blank -%}
            <ul class="ctr-pbv__perks ctr-pbv__perks--always">
              <li>{{ section.settings.tier4_perk_1 | escape }}</li>
            </ul>
          {%- endif -%}
          <div class="ctr-pbv__buyonce-body" x-show="selectedTier === 'one-time'" x-cloak>

            {%- comment -%} - Section 2: Flavor selector - {%- endcomment -%}
            <div class="ctr-pbv__buyonce-section ctr-pbv__buyonce-section--sep">
              <p class="ctr-pbv__flavor-label">{{ section.settings.buyonce_flavor_label | default: 'Select Flavor' | escape }}</p>
              <div class="ctr-pbv__buyonce-flavor-row">
                <div class="ctr-pbv__flavor-pills">
                  <button
                    type="button"
                    class="ctr-pbv__flavor-pill"
                    :class="{ 'is-selected': bagFlavors[0] === 'mango' }"
                    @click="setFlavor(0, 'mango')"
                  >
                    <span class="ctr-pbv__flavor-swatch" style="background:#F5A623;" aria-hidden="true"></span>
                    {{ section.settings.flavor_mango_label | default: 'Mango' | escape }}
                  </button>
                  <button
                    type="button"
                    class="ctr-pbv__flavor-pill"
                    :class="{ 'is-selected': bagFlavors[0] === 'raspberry', 'is-sold-out': RASPBERRY_EXISTS && !RASPBERRY_AVAILABLE }"
                    x-show="format === 'bag' && RASPBERRY_EXISTS"
                    @click="RASPBERRY_AVAILABLE && setFlavor(0, 'raspberry')"
                  >
                    <span class="ctr-pbv__flavor-swatch" style="background:#C0392B;" aria-hidden="true"></span>
                    {{ section.settings.flavor_raspberry_label | default: 'Raspberry' | escape }}
                    <template x-if="RASPBERRY_EXISTS && !RASPBERRY_AVAILABLE"><span> - Sold Out</span></template>
                  </button>
                </div>
                <div class="ctr-pbv__flavor-thumb">
                  <div x-show="bagFlavors[0] !== 'raspberry'">
                    {% if bag_mango_variant.featured_image != blank %}
                      {{ bag_mango_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                    {% elsif image_1 != blank %}
                      {{ image_1 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                    {% endif %}
                  </div>
                  {% if bag_raspberry_variant.featured_image != blank %}
                    <div x-show="bagFlavors[0] === 'raspberry'" x-cloak>
                      {{ bag_raspberry_variant.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '64px', alt: title }}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>

            {%- comment -%} - Section 3: Quantity stepper - {%- endcomment -%}
            <div class="ctr-pbv__buyonce-section ctr-pbv__buyonce-section--sep">
              <p class="ctr-pbv__flavor-label">{{ section.settings.qty_label | default: 'Add Quantity' | escape }}</p>
              <div class="ctr-pbv__qty-stepper">
                <button
                  type="button"
                  class="ctr-pbv__qty-btn"
                  @click="adjustQty(-1)"
                  :disabled="buyOnceQty <= 1"
                  aria-label="Decrease quantity"
                >-</button>
                <span class="ctr-pbv__qty-value" x-text="buyOnceQty">1</span>
                <button
                  type="button"
                  class="ctr-pbv__qty-btn"
                  @click="adjustQty(1)"
                  aria-label="Increase quantity"
                >+</button>
              </div>
            </div>

          </div>
        </div>

      </div>
      {%- comment -%} /tiers {%- endcomment -%}

      {%- comment -%} - Gift promo banner - {%- endcomment -%}
      {%- if section.settings.gift_callout_heading != blank -%}
        <div class="ctr-pbv__gift-card">
          <div>
            <p class="ctr-pbv__gift-heading">{{ section.settings.gift_callout_heading | escape }}</p>
            <p class="ctr-pbv__gift-copy">
              {{ section.settings.gift_callout_text | escape }}
              {% if section.settings.gift_callout_link_text != blank %}
                <a
                  href="{{ section.settings.gift_callout_link_url | default: '#' }}"
                  @click.prevent="giftModalOpen = true"
                >{{ section.settings.gift_callout_link_text | escape }}</a>
              {% endif %}
            </p>
          </div>
          <div class="ctr-pbv__gift-images">
            {% if section.settings.gift_image_1 != blank %}
              <div class="ctr-pbv__gift-image">
                {{ section.settings.gift_image_1 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '48px', alt: section.settings.gift_callout_heading }}
              </div>
            {% endif %}
            {% if section.settings.gift_image_2 != blank %}
              <div class="ctr-pbv__gift-image">
                {{ section.settings.gift_image_2 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '48px', alt: section.settings.gift_callout_heading }}
              </div>
            {% endif %}
            {% if section.settings.gift_image_3 != blank %}
              <div class="ctr-pbv__gift-image">
                {{ section.settings.gift_image_3 | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,150,200', sizes: '48px', alt: section.settings.gift_callout_heading }}
              </div>
            {% endif %}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} - Add to Cart CTA - {%- endcomment -%}
      <button
        type="button"
        class="ctr-pbv__cta"
        x-ref="primaryCta"
        :disabled="isAdding"
        @click="addToCart()"
        :aria-label="isAdding ? 'Adding to cart...' : '{{ section.settings.cta_text | default: 'Add To Cart' | escape }}'"
      >
        <template x-if="isAdding">
          <span class="ctr-pbv__cta-spinner" aria-hidden="true"></span>
        </template>
        <template x-if="!isAdding">
          <span>
            {{ section.settings.cta_text | default: 'Add To Cart' | escape }}
            <span x-show="selectedTier !== 'one-time'"> - </span>
            <span
              x-show="selectedTier !== 'one-time'"
              x-text="formatMoney(getTierPrice(selectedTier))"
            ></span>
            <span
              x-show="getTierCompareAt(selectedTier) > getTierPrice(selectedTier) && selectedTier !== 'one-time'"
              class="ctr-pbv__cta-compare"
              x-text="formatMoney(getTierCompareAt(selectedTier))"
            ></span>
          </span>
        </template>
      </button>

      {%- comment -%} - Trust row - {%- endcomment -%}
      <div class="ctr-pbv__trust-row">
        {% if section.settings.trust_badge_1 != blank %}
          <span class="ctr-pbv__trust-item">{{ section.settings.trust_badge_1 | escape }}</span>
        {% endif %}
        {% if section.settings.trust_badge_2 != blank %}
          <span class="ctr-pbv__trust-item">{{ section.settings.trust_badge_2 | escape }}</span>
        {% endif %}
        {% if section.settings.trust_badge_3 != blank %}
          <span class="ctr-pbv__trust-item">{{ section.settings.trust_badge_3 | escape }}</span>
        {% endif %}
      </div>

      {%- comment -%} MOBILE: FrontRow widget + clinicians (after trust row, hidden on desktop) {%- endcomment -%}
      {%- if section.settings.frontrow_product_id != blank -%}
        {%- assign _fr_mobile_id = 'iframe-frontrow-mobile-' | append: section.id -%}
        <div class="ctr-pbv__mobile-clinicians">
          {% render 'ctr-frontrow-widget',
            product_id: section.settings.frontrow_product_id,
            wrapper_class: 'ctr-pbv__frontrow-mobile',
            iframe_id: _fr_mobile_id
          %}
        </div>
      {%- endif -%}

      {%- comment -%} - Gift Modal - {%- endcomment -%}
      <div
        class="ctr-pbv__modal-overlay"
        x-cloak
        x-show="giftModalOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @click.self="giftModalOpen = false"
        @keydown.escape.window="giftModalOpen = false"
        role="dialog"
        aria-modal="true"
        :aria-label="'{{ section.settings.modal_heading | default: 'Free gifts' | escape }}'"
      >
        <div class="ctr-pbv__modal">
          <button type="button" class="ctr-pbv__modal-close" @click="giftModalOpen = false" aria-label="Close">
            <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>

          {% if section.settings.modal_heading != blank %}
            <p class="ctr-pbv__modal-heading">{{ section.settings.modal_heading }}</p>
          {% endif %}

          {% if section.settings.modal_description != blank %}
            <div class="ctr-pbv__modal-desc">{{ section.settings.modal_description }}</div>
          {% endif %}

          {%- assign has_modal_gifts = false -%}
          {%- for i in (1..4) -%}
            {%- assign mgk = 'modal_gift_image_' | append: i -%}
            {%- if section.settings[mgk] != blank -%}{%- assign has_modal_gifts = true -%}{%- endif -%}
          {%- endfor -%}

          {%- if has_modal_gifts -%}
            <div class="ctr-pbv__modal-gifts">
              {% for i in (1..4) %}
                {%- assign mgi = 'modal_gift_image_' | append: i -%}
                {%- assign mgl = 'modal_gift_label_' | append: i -%}
                {% if section.settings[mgi] != blank or section.settings[mgl] != blank %}
                  <div class="ctr-pbv__modal-gift">
                    {% if section.settings[mgi] != blank %}
                      {{ section.settings[mgi] | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', sizes: '64px' }}
                    {% endif %}
                    {% if section.settings[mgl] != blank %}
                      <div class="ctr-pbv__modal-gift-label">{{ section.settings[mgl] }}</div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {%- endif -%}

          {% if section.settings.modal_footer != blank %}
            <div style="font-size:12px;color:rgba(17,17,17,0.55);margin-top:16px;line-height:1.45;">{{ section.settings.modal_footer }}</div>
          {% endif %}
        </div>
      </div>

      {%- comment -%} - Mobile sticky CTA - {%- endcomment -%}
      <div class="ctr-pbv__sticky" x-cloak x-show="mobileStickyVisible">
        <button
          type="button"
          class="ctr-pbv__cta ctr-pbv__sticky-btn"
          :disabled="isAdding"
          @click="addToCart()"
        >
          <span x-text="isAdding ? 'Adding...' : '{{ section.settings.cta_text | default: 'Add To Cart' | escape }} - ' + formatMoney(getTierPrice(selectedTier))">
            {{ section.settings.cta_text | default: 'Add To Cart' | escape }}
          </span>
        </button>
      </div>

    </div>
    {%- comment -%} /copy {%- endcomment -%}

  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "CTR Purchase Box Variants",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Variant IDs"
    },
    {
      "type": "number",
      "id": "bag_mango_variant_id",
      "label": "BAG - Mango variant ID",
      "info": "Copy from Shopify Admin -> Products -> Restore -> Variants"
    },
    {
      "type": "number",
      "id": "bag_raspberry_variant_id",
      "label": "BAG - Raspberry variant ID"
    },
    {
      "type": "number",
      "id": "sticks_mango_variant_id",
      "label": "STICKS - Mango variant ID"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_spacing",
      "label": "Container spacing",
      "default": "px-container-md",
      "options": [
        { "value": "px-container-xs", "label": "Extra Small" },
        { "value": "px-container-sm", "label": "Small" },
        { "value": "px-container-md", "label": "Medium" },
        { "value": "px-container-lg", "label": "Large" },
        { "value": "px-container-gutter", "label": "Gutter Only" },
        { "value": "px-container-fullwidth", "label": "Full Width" }
      ]
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f8f3ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop)",
      "min": 0, "max": 160, "step": 4, "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0, "max": 160, "step": 4, "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0, "max": 120, "step": 4, "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0, "max": 120, "step": 4, "default": 32
    },
    {
      "type": "header",
      "content": "Gallery Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product title override",
      "info": "Leave blank to use the product's title"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_review_count",
      "label": "Show review count",
      "default": true
    },
    {
      "type": "text",
      "id": "ingredients_link_text",
      "label": "Ingredients link text",
      "default": "Ingredients"
    },
    {
      "type": "url",
      "id": "ingredients_link_url",
      "label": "Ingredients link URL"
    },
    {
      "type": "text",
      "id": "benefits_link_text",
      "label": "Benefits link text",
      "default": "Benefits"
    },
    {
      "type": "url",
      "id": "benefits_link_url",
      "label": "Benefits link URL"
    },
    {
      "type": "image_picker",
      "id": "clinicians_badge_image",
      "label": "Clinicians badge image",
      "info": "Displayed at 150x30px next to the product title"
    },
    {
      "type": "header",
      "content": "Description & Benefits"
    },
    {
      "type": "image_picker",
      "id": "benefit_icon",
      "label": "Benefit icon (replaces dot)",
      "info": "Recommended: 32x32px SVG or PNG with transparent background"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Rapidly hydrates, supports immunity, and promotes detoxification. Powered by nutrients with up to 5x more absorption."
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Rapid cellular hydration & mineral balance"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Sharper mood, clearer focus, sustained energy"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Fast post-workout electrolyte & mineral refill"
    },
    {
      "type": "text",
      "id": "benefit_4",
      "label": "Benefit 4",
      "default": "Wake up clearer less midday fog & brain fuzz"
    },
    {
      "type": "text",
      "id": "benefit_5",
      "label": "Benefit 5"
    },
    {
      "type": "text",
      "id": "benefit_6",
      "label": "Benefit 6"
    },
    {
      "type": "header",
      "content": "Format Toggle (BAG / STICKS)"
    },
    {
      "type": "checkbox",
      "id": "show_format_toggle",
      "label": "Show format toggle",
      "default": true
    },
    {
      "type": "text",
      "id": "format_bag_label",
      "label": "BAG button label",
      "default": "BAG"
    },
    {
      "type": "text",
      "id": "format_sticks_label",
      "label": "STICKS button label",
      "default": "STICKS"
    },
    {
      "type": "header",
      "content": "Flavor Labels"
