{% liquid
  assign product = section.settings.product | default: product
  assign product_form_id = 'ctr-pbv-' | append: section.id

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products[0]
  endif

  assign variant = product.selected_or_first_available_variant | default: product.variants.first

  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign image_3 = section.settings.image_3 
  assign image_4 = section.settings.image_4
  assign image_5 = section.settings.image_5

  if image_1 == blank and product.media.size > 0
    assign image_1 = product.media[0].preview_image
  endif
  if image_2 == blank and product.media.size > 1
    assign image_2 = product.media[1].preview_image
  endif
  if image_3 == blank and product.media.size > 2
    assign image_3 = product.media[2].preview_image
  endif

  assign reviews_rating_path = settings.data__product__reviews_rating | replace: ' ', '' | split: '.'
  assign reviews_rating = product.metafields[reviews_rating_path.first][reviews_rating_path.last].value
  assign reviews_rating = reviews_rating.rating | default: reviews_rating | default: 4.97 | times: 1.0

  assign reviews_count_path = settings.data__product__reviews_count | replace: ' ', '' | split: '.'
  assign reviews_count = product.metafields[reviews_count_path.first][reviews_count_path.last].value | default: 368 | times: 1

  assign title = section.settings.product_title | default: product.title

  comment
    Resolve the three key variant objects from admin-supplied IDs.
    Falls back to first variant so Editor preview doesn't break.
  endcomment
  assign bag_mango_variant     = blank
  assign bag_raspberry_variant = blank
  assign sticks_mango_variant  = blank
  for v in product.variants
    if v.id == section.settings.bag_mango_variant_id
      assign bag_mango_variant = v
    endif
    if v.id == section.settings.bag_raspberry_variant_id
      assign bag_raspberry_variant = v
    endif
    if v.id == section.settings.sticks_mango_variant_id
      assign sticks_mango_variant = v
    endif
  endfor
  if bag_mango_variant == blank
    assign bag_mango_variant = product.variants.first
  endif
  if sticks_mango_variant == blank
    assign sticks_mango_variant = product.variants.first
  endif

  comment
    Raspberry available check -- disable pill when sold out
  endcomment
  assign raspberry_available = false
  assign raspberry_exists = false
  if bag_raspberry_variant != blank
    assign raspberry_exists = true
    assign raspberry_available = bag_raspberry_variant.available
  endif
%}

{%- comment -%}
  Extract selling plan IDs + prices for each of the 3 target variants.
  Reuse the same Liquid logic block 3 times (bag_mango, bag_raspberry, sticks_mango).
{%- endcomment -%}

{%- comment -%} --- bag_mango --- {%- endcomment -%}
{%- assign _bm_sp30 = 0 -%}{%- assign _bm_sp60 = 0 -%}{%- assign _bm_sp90 = 0 -%}
{%- assign _bm_p30 = bag_mango_variant.price -%}{%- assign _bm_ca30 = bag_mango_variant.compare_at_price | default: bag_mango_variant.price -%}
{%- assign _bm_p60 = bag_mango_variant.price -%}{%- assign _bm_ca60 = bag_mango_variant.compare_at_price | default: bag_mango_variant.price -%}
{%- assign _bm_p90 = bag_mango_variant.price -%}{%- assign _bm_ca90 = bag_mango_variant.compare_at_price | default: bag_mango_variant.price -%}
{%- for alloc in bag_mango_variant.selling_plan_allocations -%}
  {%- assign _pn = alloc.selling_plan.name | downcase -%}
  {%- if _pn contains '30' or _pn contains '1 month' -%}{%- assign _bm_sp30 = alloc.selling_plan.id -%}{%- assign _bm_p30 = alloc.price -%}{%- assign _bm_ca30 = alloc.compare_at_price | default: bag_mango_variant.price -%}
  {%- elsif _pn contains '60' or _pn contains '2 month' -%}{%- assign _bm_sp60 = alloc.selling_plan.id -%}{%- assign _bm_p60 = alloc.price -%}{%- assign _bm_ca60 = alloc.compare_at_price | default: bag_mango_variant.price -%}
  {%- elsif _pn contains '90' or _pn contains '3 month' -%}{%- assign _bm_sp90 = alloc.selling_plan.id -%}{%- assign _bm_p90 = alloc.price -%}{%- assign _bm_ca90 = alloc.compare_at_price | default: bag_mango_variant.price -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} --- bag_raspberry --- {%- endcomment -%}
{%- assign _br_sp30 = 0 -%}{%- assign _br_sp60 = 0 -%}{%- assign _br_sp90 = 0 -%}
{%- assign _br_p30 = bag_raspberry_variant.price | default: 0 -%}{%- assign _br_ca30 = bag_raspberry_variant.compare_at_price | default: bag_raspberry_variant.price | default: 0 -%}
{%- assign _br_p60 = bag_raspberry_variant.price | default: 0 -%}{%- assign _br_ca60 = bag_raspberry_variant.compare_at_price | default: bag_raspberry_variant.price | default: 0 -%}
{%- assign _br_p90 = bag_raspberry_variant.price | default: 0 -%}{%- assign _br_ca90 = bag_raspberry_variant.compare_at_price | default: bag_raspberry_variant.price | default: 0 -%}
{%- if bag_raspberry_variant != blank -%}
  {%- for alloc in bag_raspberry_variant.selling_plan_allocations -%}
    {%- assign _pn = alloc.selling_plan.name | downcase -%}
    {%- if _pn contains '30' or _pn contains '1 month' -%}{%- assign _br_sp30 = alloc.selling_plan.id -%}{%- assign _br_p30 = alloc.price -%}{%- assign _br_ca30 = alloc.compare_at_price | default: bag_raspberry_variant.price -%}
    {%- elsif _pn contains '60' or _pn contains '2 month' -%}{%- assign _br_sp60 = alloc.selling_plan.id -%}{%- assign _br_p60 = alloc.price -%}{%- assign _br_ca60 = alloc.compare_at_price | default: bag_raspberry_variant.price -%}
    {%- elsif _pn contains '90' or _pn contains '3 month' -%}{%- assign _br_sp90 = alloc.selling_plan.id -%}{%- assign _br_p90 = alloc.price -%}{%- assign _br_ca90 = alloc.compare_at_price | default: bag_raspberry_variant.price -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} --- sticks_mango --- {%- endcomment -%}
{%- assign _sm_sp30 = 0 -%}{%- assign _sm_sp60 = 0 -%}{%- assign _sm_sp90 = 0 -%}
{%- assign _sm_p30 = sticks_mango_variant.price -%}{%- assign _sm_ca30 = sticks_mango_variant.compare_at_price | default: sticks_mango_variant.price -%}
{%- assign _sm_p60 = sticks_mango_variant.price -%}{%- assign _sm_ca60 = sticks_mango_variant.compare_at_price | default: sticks_mango_variant.price -%}
{%- assign _sm_p90 = sticks_mango_variant.price -%}{%- assign _sm_ca90 = sticks_mango_variant.compare_at_price | default: sticks_mango_variant.price -%}
{%- for alloc in sticks_mango_variant.selling_plan_allocations -%}
  {%- assign _pn = alloc.selling_plan.name | downcase -%}
  {%- if _pn contains '30' or _pn contains '1 month' -%}{%- assign _sm_sp30 = alloc.selling_plan.id -%}{%- assign _sm_p30 = alloc.price -%}{%- assign _sm_ca30 = alloc.compare_at_price | default: sticks_mango_variant.price -%}
  {%- elsif _pn contains '60' or _pn contains '2 month' -%}{%- assign _sm_sp60 = alloc.selling_plan.id -%}{%- assign _sm_p60 = alloc.price -%}{%- assign _sm_ca60 = alloc.compare_at_price | default: sticks_mango_variant.price -%}
  {%- elsif _pn contains '90' or _pn contains '3 month' -%}{%- assign _sm_sp90 = alloc.selling_plan.id -%}{%- assign _sm_p90 = alloc.price -%}{%- assign _sm_ca90 = alloc.compare_at_price | default: sticks_mango_variant.price -%}
  {%- endif -%}
{%- endfor -%}

{% style %}
  /* ============================================
     CTR Purchase Box -- Variants (ctr-pbv)
  ============================================ */
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #shopify-section-{{ section.id }} .ctr-pbv {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    color: {{ section.settings.text_color }};
    margin-left: auto;
    margin-right: auto;
  }

  /* -- Two-column layout -- */
  #shopify-section-{{ section.id }} .ctr-pbv__inner {
    display: grid;
    grid-template-columns: 1fr minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }

  /* -- Gallery -- */
  #shopify-section-{{ section.id }} .ctr-pbv__gallery-layout {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    position: relative;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__thumb {
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    aspect-ratio: 1 / 1;
    width: 70px;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__thumb.is-active {
    border-color: rgba(17, 17, 17, 0.8);
    box-shadow: 0 0 0 1px rgba(17, 17, 17, 0.4);
  }

  #shopify-section-{{ section.id }} .ctr-pbv__thumb img,
  #shopify-section-{{ section.id }} .ctr-pbv__hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__hero-image {
    position: relative;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    min-height: 470px;
    box-shadow: inset 0 0 0 1px rgba(17, 17, 17, 0.04);
  }

  #shopify-section-{{ section.id }} .ctr-pbv__hero-image > div {
    position: absolute;
    inset: 0;
  }

  /* First slide visible before Alpine initialises (no x-cloak, but belt-and-braces) */
  #shopify-section-{{ section.id }} .ctr-pbv__hero-image > div:first-child {
    display: block;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__hero-image img {
    object-fit: contain;
    padding: 24px;
  }


  /* -- FrontRow widget -- */
  #shopify-section-{{ section.id }} .ctr-pbv__frontrow {
    grid-column: 2 / -1;
    padding-top: 8px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ctr-pbv__frontrow iframe {
    width: 100%;
    display: block;
    border: 0;
  }

  /* -- Copy column -- */
  #shopify-section-{{ section.id }} .ctr-pbv__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* -- Title row -- */
  #shopify-section-{{ section.id }} .ctr-pbv__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__title {
    margin: 0;
    font-size: 40px;
    line-height: 0.98;
    font-weight: 700;

    @media (max-width: 768px) {
      font-size: 28px;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__clinicians-badge {
    display: block;
    width: 150px;
    height: 30px;
    object-fit: contain;
    flex-shrink: 0;

    @media (max-width: 768px) {
      display: none;
    }
  }

  /* -- Rating row -- */
  #shopify-section-{{ section.id }} .ctr-pbv__rating-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    line-height: 1.2;
    color: rgba(17, 17, 17, 0.88);
  }

  #shopify-section-{{ section.id }} .ctr-pbv__stars {
    display: inline-flex;
    gap: 3px;
    color: #111;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__stars svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
    display: block;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__rating-links {
    margin-left: auto;
    display: flex;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__rating-links a {
    font-size: 14px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    color: #000000;
    position: relative;
    padding-left: 10px;
    margin-left: 10px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__rating-links a:first-child:before {
    display: none;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__rating-links a:before {
    content: '';
    position: absolute;
    left: -8px;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 3px;
    background: #000000;
    z-index: 1;
    border-radius: 999px;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__rating-links a:hover { opacity: 1; }

  /* -- Description + benefits -- */
  #shopify-section-{{ section.id }} .ctr-pbv__description {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #707070;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__benefits li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px; 
    font-weight: 500;
    line-height: 1.35;
    color: #707070;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__benefit-dot {
    width: 16px;
    height: 16px;


    flex-shrink: 0;
    margin-top: 1px; 
    object-fit: contain;
    display: block;
  }

  /* -- Format Toggle (BAG / STICKS) -- segmented control -- */
  #shopify-section-{{ section.id }} .ctr-pbv__format-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    align-self: flex-start;
    background: #F0EDE7;
    border-radius: 999px; 
    padding: 1px;
    border: 1px solid #ffffff;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__format-btn {
    width: 105px;
    min-height: 36px;
    border: 1.5px solid transparent;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 13px;
    font-weight: 600; 
    color: rgba(17, 17, 17, 0.45);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    letter-spacing: 0.01em;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__format-btn.is-active {
    background: #fff;
    border-color: #111;
    color: #111;
  }

  /* -- Tier cards (stacked radio-button style) -- */
  #shopify-section-{{ section.id }} .ctr-pbv__tiers {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-card {
    border: 1.5px solid #fff;
    border-radius: 12px;
    background: #F0EDE7;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-card.ctr-pbv__tier-card--buyonce {
    background-color: transparent;
    border-color: #E1E3E7;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-card.is-selected {
    background: #fff;
    border-color: #111;
    box-shadow: 0 0 0 1px #111;
  }

  /* Tier card header row */
  #shopify-section-{{ section.id }} .ctr-pbv__tier-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;

    @media (max-width: 768px) {
      gap: 4px;
      align-items: flex-start;
    }
  }

  /* Radio circle */
  #shopify-section-{{ section.id }} .ctr-pbv__tier-radio {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid rgba(17, 17, 17, 0.25);
    flex-shrink: 0;
    position: relative;
    transition: border-color 0.15s;

    @media (max-width: 768px) {
      width: 16px;
      height: 16px;
      margin-right: 4px;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-card.is-selected .ctr-pbv__tier-radio {
    border-color: #111;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-radio::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: #111;
    opacity: 0;
    transition: opacity 0.15s;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-card.is-selected .ctr-pbv__tier-radio::after {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-label {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;

    @media (max-width: 768px) {
      font-size: 16px;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 4px 10px 4px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    background: {{ section.settings.discount_badge_color }};
    white-space: nowrap;

    @media (max-width: 768px) {
      font-size: 10px;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-pricing {
    margin-left: auto;
    display: flex;
    align-items: baseline;
    gap: 6px;
    text-align: right;

    @media (max-width: 768px) {
      flex-direction: column-reverse;
      gap: 0;
      align-items: flex-end;
      position: relative;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-compare {
    font-size: 13px;
    font-weight: 400;
    color: rgba(17, 17, 17, 0.38);
    text-decoration: line-through;

    @media (max-width: 768px) {
      font-size: 12px;
      position: absolute;
      top: 100%;
      left: 0;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__tier-price {
    font-size: 16px;
    font-weight: 700;
    color: #111;

    @media (max-width: 768px) {
      font-size: 14px;
    }
  }

  /* Tier expanded body (perks + flavor selectors) */
  #shopify-section-{{ section.id }} .ctr-pbv__tier-body {
    padding: 0 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 0;
    
  }

  /* Perk checklist */
  #shopify-section-{{ section.id }} .ctr-pbv__perks {
    list-style: none;
    margin: 0;
    padding: 12px 0 0;
    display: grid;
    gap: 6px;
  }

  /* Always-visible perks -- sit between tier-head and the x-show body */
  #shopify-section-{{ section.id }} .ctr-pbv__perks--always {
    padding: 0 16px 10px 45px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__perks li {
    display: flex;
    gap: 7px;
    font-size: 14px;
    line-height: 1.4;
    color: rgba(17, 17, 17, 0.78);

    @media (max-width: 768px) {
      font-size: 12px;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__perks li::before {
    content: '\2713';
    font-weight: 700;
    color: #111;
    flex-shrink: 0;
  }

  /* -- Flavor selector block -- */
  #shopify-section-{{ section.id }} .ctr-pbv__flavor-blocks {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid #E1E3E7;
    padding-top: 12px;
    margin-top: 12px;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-left {
    flex: 1;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-label {
    font-size: 16px;
    font-weight: 600;
    color: #1A1A1A;
    margin-bottom: 10px;

    @media (max-width: 768px) {
      font-size: 14px;
    }
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1.5px solid rgba(17, 17, 17, 0.18);
    border-radius: 999px;
    padding: 5px 14px 6px;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: rgba(17, 17, 17, 0.5);
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, opacity 0.15s;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-pill.is-selected {
    border-color: #111;
    color: #111;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-pill.is-sold-out {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-thumb {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    overflow: hidden;
    /* background: #f5f3f0; */
    flex-shrink: 0;
    /* border: 1px solid rgba(17, 17, 17, 0.08); */
  }

  #shopify-section-{{ section.id }} .ctr-pbv__flavor-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 6px;
    box-sizing: border-box;
  }

  /* -- Buy Once body -- */
  #shopify-section-{{ section.id }} .ctr-pbv__buyonce-body {
    padding: 0 16px 16px;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__buyonce-section {
    padding: 12px 0 0;
  }

  #shopify-section-{{ section.id }} .ctr-pbv__buyonce-section--sep {
    border-top: 1px solid rgba(17, 17, 17, 0.08) !important;
    margin-top: 4px;
    padding-top: 14px;
  }

  /* Flavor row inside Buy Once */
  #shopify-section-{{ section.id }} .ctr-pbv__buyonce-flavor-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 8px;
