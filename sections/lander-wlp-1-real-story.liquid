<script>
(function(){
  var REVEAL_AT = {{ reveal_seconds }};
  var v = document.getElementById('vslVid');
  var player = document.getElementById('vslPlayer');
  var unmute = document.getElementById('vslUnmute');
  var unmuteLbl = document.getElementById('vslUnmuteLabel');
  var playBtn = document.getElementById('vslPlayBtn');
  var prog = document.getElementById('vslProg');
  var bar = document.getElementById('vslBar');
  var mob = document.getElementById('vslMob');
  if(!v) return;

  var revealed = false;
  function reveal(){
    if(revealed) return;
    revealed = true;
    bar.classList.add('is-revealed');
    mob.classList.add('is-on');
  }

  // Autoplay-muted on load (cold Meta best practice)
  // Browsers block sound until user interacts. Provide a clear unmute button.
  v.addEventListener('play', function(){
    player.classList.add('is-playing');
  });
  v.addEventListener('pause', function(){
    player.classList.remove('is-playing');
  });
  v.addEventListener('ended', function(){
    player.classList.remove('is-playing');
  });
  v.addEventListener('timeupdate', function(){
    if(v.duration > 0){
      var p = (v.currentTime / v.duration) * 100;
      if(prog) prog.style.width = p + '%';
    }
    if(v.currentTime >= REVEAL_AT) reveal();
  });

  // Big play overlay (in case autoplay is blocked)
  playBtn.addEventListener('click', function(e){
    e.stopPropagation();
    v.play();
  });

  // Unmute pill — most important VSL interaction
  unmute.addEventListener('click', function(e){
    e.stopPropagation();
    if(v.muted){
      v.muted = false;
      v.volume = 1;
      v.play();
      player.classList.add('is-unmuted');
      unmuteLbl.textContent = 'Muted on';
      // Once unmuted, hide the pill after a couple seconds
      setTimeout(function(){ unmute.style.display = 'none'; }, 1800);
    }
  });

  // Click anywhere on video toggles play/pause once it's started
  v.addEventListener('click', function(){
    if(v.paused){ v.play(); } else { v.pause(); }
  });

  // Reveal on scroll past the video
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(!en.isIntersecting && en.boundingClientRect.top < 0) reveal();
      });
    }, {threshold: 0});
    io.observe(player);
  }

  // ---------- BUYBOX PLAN PICKER ----------
  var opts = document.querySelectorAll('[data-opt]');
  var buyCtas = document.querySelectorAll('[data-buy-cta]');
  opts.forEach(function(opt){
    opt.addEventListener('click', function(){
      opts.forEach(function(o){ o.classList.remove('is-on'); var i=o.querySelector('input'); if(i) i.checked=false; });
      opt.classList.add('is-on');
      var i = opt.querySelector('input'); if(i) i.checked = true;
      var cart = opt.getAttribute('data-cart');
      buyCtas.forEach(function(c){ c.setAttribute('href', cart); });
    });
  });

  // ATC handler — POST /cart/add.js so the Skio selling_plan actually attaches.
  // Cart permalinks (/cart/X:1?selling_plan=Y) silently drop the plan on absorbmore.com.
  function parseCart(url){
    var m = (url || '').match(/\/cart\/(\d+):(\d+)(?:\?selling_plan=(\d+))?/);
    if(!m) return null;
    return { id: m[1], quantity: parseInt(m[2], 10) || 1, selling_plan: m[3] || null };
  }
  document.querySelectorAll('[data-atc]').forEach(function(cta){
    cta.addEventListener('click', function(e){
      var url = cta.getAttribute('href') || '';
      var parsed = parseCart(url);
      if(!parsed) return;
      e.preventDefault();
      var origLabel = cta.innerHTML;
      cta.setAttribute('aria-busy','true');
      cta.innerHTML = 'Adding…';
      var body = { id: parsed.id, quantity: parsed.quantity };
      if(parsed.selling_plan) body.selling_plan = parsed.selling_plan;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body)
      }).then(function(){ window.location.href = '/cart'; })
        .catch(function(){ window.location.href = url; })
        .finally(function(){ cta.innerHTML = origLabel; cta.removeAttribute('aria-busy'); });
    });
  });
})();
</script>

