{%- comment -%} WLP-1 Real Story VSL — cold paid Meta. Hero is the 65s customer testimonial (autoplay muted, burned captions). Offer reveals after watch trigger or scroll. Live PDP buybox (1mo 20% / 3mo MOST POPULAR 30% / 6mo BEST VALUE 35%). {%- endcomment -%}

{%- liquid
  assign video_src     = section.settings.video_src     | default: 'https://cdn.shopify.com/videos/c/vp/cfc94774f10c400caaf1ea0d0b9da98d/cfc94774f10c400caaf1ea0d0b9da98d.HD-720p-1.6Mbps-85830065.mp4'
  assign video_src_hd  = section.settings.video_src_hd  | default: 'https://cdn.shopify.com/videos/c/vp/cfc94774f10c400caaf1ea0d0b9da98d/cfc94774f10c400caaf1ea0d0b9da98d.HD-1080p-2.5Mbps-85830065.mp4'
  assign video_src_sd  = section.settings.video_src_sd  | default: 'https://cdn.shopify.com/videos/c/vp/cfc94774f10c400caaf1ea0d0b9da98d/cfc94774f10c400caaf1ea0d0b9da98d.SD-480p-0.9Mbps-85830065.mp4'
  assign video_poster  = section.settings.video_poster  | default: 'https://cdn.shopify.com/s/files/1/0821/3997/1873/files/wlp1-real-story-poster.jpg?v=1780699542'
  assign buy_img       = section.settings.buy_img       | default: 'https://www.absorbmore.com/cdn/shop/files/TAC_PDP-Image_WLP1.png?v=1774483977&width=960'
  assign cart_1mo      = section.settings.cart_1mo      | default: '/cart/52472821121313:1?selling_plan=691162546465'
  assign cart_3mo      = section.settings.cart_3mo      | default: '/cart/52472821154081:1?selling_plan=691162579233'
  assign cart_6mo      = section.settings.cart_6mo      | default: '/cart/52472821186849:1?selling_plan=691166544161'
  assign price_1mo_per = section.settings.price_1mo_per | default: '$79.20/mo'
  assign price_1mo_total = section.settings.price_1mo_total | default: '$79.20'
  assign price_1mo_was = section.settings.price_1mo_was | default: '$99.20'
  assign price_1mo_save = section.settings.price_1mo_save | default: '$20.00'
  assign price_3mo_per = section.settings.price_3mo_per | default: '$69.00/mo'
  assign price_3mo_total = section.settings.price_3mo_total | default: '$207.00'
  assign price_3mo_was = section.settings.price_3mo_was | default: '$296.00'
  assign price_3mo_save = section.settings.price_3mo_save | default: '$89.00'
  assign price_6mo_per = section.settings.price_6mo_per | default: '$64.00/mo'
  assign price_6mo_total = section.settings.price_6mo_total | default: '$384.00'
  assign price_6mo_was = section.settings.price_6mo_was | default: '$594.00'
  assign price_6mo_save = section.settings.price_6mo_save | default: '$210.00'
  assign rating        = section.settings.rating        | default: '4.8'
  assign reveal_seconds = section.settings.reveal_seconds | default: 15
-%}

<style>
  .vsl{ --ink:#1c2230; --ink-soft:#3a4456; --muted:#7a8395; --line:#e3e6ec; --line-soft:#eef0f5;
        --paper:#fbfaf7; --cream:#f6f3ec; --cream-soft:#faf8f3; --blue:#4659ff; --blue-deep:#2f3fd4; --blue-soft:#e8ebff;
        --sage:#2f7d5e; --warn:#c44a2a; --gold:#f0a92b;
        color:var(--ink); background:var(--paper); -webkit-font-smoothing:antialiased; line-height:1.5; }
  .vsl *{box-sizing:border-box}
  .vsl img,.vsl video{max-width:100%;display:block}
  .vsl a{color:inherit;text-decoration:none}
  .vsl .wrap{max-width:920px;margin:0 auto;padding:0 18px}
  .vsl .wrap--wide{max-width:1120px}
  .vsl .center{text-align:center}

  /* ---------- TOP STICKY BAR (cold-Meta hook frame) ---------- */
  .vsl-bar{position:sticky;top:0;z-index:60;background:var(--ink);color:#fff;border-bottom:1px solid rgba(255,255,255,.08);transition:background .25s ease}
  .vsl-bar__row{display:flex;align-items:center;justify-content:center;gap:12px;padding:10px 14px;font-size:13px;text-align:center;line-height:1.3;min-height:42px}
  .vsl-bar__lead{font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:12px;display:inline-flex;align-items:center;gap:8px}
  .vsl-bar__dot{width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(240,169,43,.25);animation:vslPulse 2.2s ease-in-out infinite}
  @keyframes vslPulse{0%,100%{opacity:1}50%{opacity:.55}}
  .vsl-bar__cta{display:none;background:var(--blue);color:#fff;padding:7px 14px;border-radius:4px;font-weight:700;font-size:12px;letter-spacing:.04em;text-transform:uppercase;margin-left:8px;transition:background .2s}
  .vsl-bar__cta:hover{background:var(--blue-deep)}
  .vsl-bar.is-revealed{background:var(--blue-deep)}
  .vsl-bar.is-revealed .vsl-bar__cta{display:inline-flex}
  .vsl-bar.is-revealed .vsl-bar__dot{background:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.25)}
  @media(max-width:480px){.vsl-bar__row{gap:8px;padding:9px 12px}.vsl-bar__lead{font-size:11px;letter-spacing:.04em}.vsl-bar__cta{font-size:11px;padding:6px 10px}}

  /* ---------- HERO FRAME ---------- */
  .vsl-hero{background:var(--cream);padding:22px 0 30px;border-bottom:1px solid var(--line)}
  @media(min-width:880px){.vsl-hero{padding:36px 0 44px}}
  .vsl-hero__eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--ink);background:var(--cream-soft);border:1px solid var(--line);padding:6px 11px;border-radius:999px;margin:0 auto 14px;}
  .vsl-hero__eyebrow svg{width:13px;height:13px;color:var(--sage);flex:0 0 auto}
  .vsl-hero h1{font-size:clamp(26px,5.6vw,40px);line-height:1.1;letter-spacing:-.025em;font-weight:800;margin:0 auto 12px;max-width:720px;color:var(--ink)}
  .vsl-hero h1 em{font-style:normal;color:var(--blue-deep)}
  .vsl-hero__sub{font-size:clamp(15px,2.1vw,18px);max-width:600px;margin:0 auto 18px;color:var(--ink-soft);line-height:1.5}
  .vsl-hero__sub b{color:var(--ink);font-weight:600}

  /* ---------- VIDEO PLAYER ---------- */
  .vsl-player{position:relative;max-width:420px;margin:0 auto;background:#000;border-radius:14px;overflow:hidden;box-shadow:0 18px 50px -18px rgba(28,34,48,.45);aspect-ratio:9/16}
  @media(min-width:880px){.vsl-player{max-width:480px;border-radius:18px}}
  .vsl-player video{width:100%;height:100%;object-fit:cover;display:block;background:#000}
  .vsl-player__poster{position:absolute;inset:0;background-size:cover;background-position:center;transition:opacity .3s ease}
  .vsl-player.is-playing .vsl-player__poster{opacity:0;pointer-events:none}
  .vsl-player__overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;background:linear-gradient(180deg,rgba(0,0,0,0) 30%,rgba(0,0,0,.55) 100%);padding:18px;pointer-events:none}
  .vsl-player__play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:78px;height:78px;border-radius:50%;background:rgba(255,255,255,.96);display:flex;align-items:center;justify-content:center;cursor:pointer;border:0;padding:0;box-shadow:0 8px 28px rgba(0,0,0,.35);pointer-events:auto;transition:transform .2s}
  .vsl-player__play:hover{transform:translate(-50%,-50%) scale(1.06)}
  .vsl-player__play svg{width:30px;height:30px;color:#1c2230;margin-left:4px}
  .vsl-player.is-playing .vsl-player__play{display:none}
  .vsl-player__unmute{position:absolute;top:14px;right:14px;display:inline-flex;align-items:center;gap:6px;background:rgba(0,0,0,.7);color:#fff;font-size:12px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;padding:8px 12px;border-radius:999px;border:0;cursor:pointer;pointer-events:auto;backdrop-filter:blur(4px);transition:background .2s,opacity .25s;z-index:3}
  .vsl-player__unmute:hover{background:rgba(0,0,0,.85)}
  .vsl-player__unmute svg{width:14px;height:14px}
  .vsl-player.is-unmuted .vsl-player__unmute{opacity:.55}
  .vsl-player__caption-tag{position:absolute;left:14px;top:14px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;background:rgba(255,255,255,.92);color:var(--ink);padding:5px 10px;border-radius:999px;pointer-events:none;z-index:2;display:inline-flex;align-items:center;gap:6px}
  .vsl-player__caption-tag svg{width:11px;height:11px;color:var(--warn)}
  .vsl-player__progress{position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(255,255,255,.18);overflow:hidden;z-index:3}
  .vsl-player__progress span{display:block;height:100%;width:0;background:var(--gold);transition:width .15s linear}

  /* ---------- TRUST STRIP ---------- */
  .vsl-trust{background:var(--paper);padding:14px 0;border-bottom:1px solid var(--line)}
  .vsl-trust__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 18px;align-items:center;justify-items:center;text-align:center;font-size:12px;color:var(--ink-soft);font-weight:600}
  @media(min-width:760px){.vsl-trust__grid{grid-template-columns:repeat(4,1fr);font-size:13px}}
  .vsl-trust__cell{display:inline-flex;align-items:center;gap:7px;line-height:1.2}
  .vsl-trust__cell svg{width:15px;height:15px;color:var(--blue);flex:0 0 auto}
  .vsl-trust__cell b{color:var(--ink);font-weight:700}

  /* ---------- SECTIONS ---------- */
  .vsl-sec{padding:42px 0;border-bottom:1px solid var(--line)}
  .vsl-sec--blue{background:var(--blue-soft)}
  .vsl-sec--cream{background:var(--cream)}
  .vsl-sec--ink{background:var(--ink);color:#fff}
  .vsl-sec--ink h2{color:#fff}
  .vsl-sec__eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--sage);margin:0 0 8px}
  .vsl-sec__eyebrow.on-ink{color:var(--gold)}
  .vsl-sec h2{font-size:clamp(22px,4.2vw,32px);line-height:1.15;letter-spacing:-.02em;font-weight:800;margin:0 0 12px;color:var(--ink);max-width:680px}
  .vsl-sec h2.center{margin-left:auto;margin-right:auto}
  .vsl-sec p{font-size:clamp(15px,2vw,17px);line-height:1.55;color:var(--ink-soft);margin:0 0 14px}
  .vsl-sec--ink p{color:rgba(255,255,255,.85)}

  /* ---------- RECAP ("what she said") ---------- */
  .vsl-recap__grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:18px}
  @media(min-width:760px){.vsl-recap__grid{grid-template-columns:repeat(3,1fr);gap:18px}}
  .vsl-recap__card{background:var(--cream-soft);border:1px solid var(--line);border-radius:12px;padding:18px 18px 16px;position:relative}
  .vsl-recap__t{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-deep);margin:0 0 8px}
  .vsl-recap__q{font-size:17px;font-weight:600;color:var(--ink);line-height:1.35;margin:0 0 10px}
  .vsl-recap__q::before{content:"\201C";color:var(--blue);font-weight:800;margin-right:2px}
  .vsl-recap__q::after{content:"\201D";color:var(--blue);font-weight:800;margin-left:2px}
  .vsl-recap__cap{font-size:12px;color:var(--muted);font-style:italic}

  /* ---------- TRANSITION BAND ---------- */
  .vsl-band{background:var(--ink);color:#fff;padding:26px 0;text-align:center}
  .vsl-band__lead{font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:var(--gold);margin:0 0 6px}
  .vsl-band__line{font-size:clamp(17px,2.6vw,22px);font-weight:700;line-height:1.3;margin:0 0 14px;color:#fff;max-width:580px;margin-left:auto;margin-right:auto}
  .vsl-band__cta{display:inline-flex;align-items:center;justify-content:center;background:var(--blue);color:#fff !important;font-weight:700;font-size:14px;letter-spacing:.04em;text-transform:uppercase;padding:13px 26px;border-radius:4px;transition:background .2s}
  .vsl-band__cta:hover{background:var(--blue-deep)}
  .vsl-band__cta::after{content:" →";margin-left:8px}

  /* ---------- BUYBOX ---------- */
  .vsl-buy{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;max-width:560px;margin:18px auto 0;position:relative;box-shadow:0 18px 40px -22px rgba(28,34,48,.18)}
  @media(min-width:760px){.vsl-buy{padding:26px}}
  .vsl-buy__flag{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--blue);color:#fff;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:999px;white-space:nowrap}
  .vsl-buy__hero{display:flex;align-items:center;justify-content:center;background:var(--cream);border-radius:10px;padding:14px;margin:6px 0 14px}
  .vsl-buy__hero img{width:160px;height:auto}
  .vsl-buy h3{font-size:20px;font-weight:800;margin:0 0 6px;text-align:center;color:var(--ink)}
  .vsl-buy__stars{display:flex;align-items:center;justify-content:center;gap:8px;font-size:13px;color:var(--ink-soft);margin:0 0 16px}
  .vsl-buy__stars b{color:var(--ink);font-weight:700}
  .stars5{display:inline-block;width:78px;height:14px;background:linear-gradient(90deg,var(--gold) 0%,var(--gold) 100%);-webkit-mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='78' height='14' viewBox='0 0 78 14'><g fill='black'><polygon points='7,0 8.6,4.8 13.5,4.8 9.5,7.7 11,12.6 7,9.6 3,12.6 4.5,7.7 0.5,4.8 5.4,4.8'/><polygon points='23,0 24.6,4.8 29.5,4.8 25.5,7.7 27,12.6 23,9.6 19,12.6 20.5,7.7 16.5,4.8 21.4,4.8'/><polygon points='39,0 40.6,4.8 45.5,4.8 41.5,7.7 43,12.6 39,9.6 35,12.6 36.5,7.7 32.5,4.8 37.4,4.8'/><polygon points='55,0 56.6,4.8 61.5,4.8 57.5,7.7 59,12.6 55,9.6 51,12.6 52.5,7.7 48.5,4.8 53.4,4.8'/><polygon points='71,0 72.6,4.8 77.5,4.8 73.5,7.7 75,12.6 71,9.6 67,12.6 68.5,7.7 64.5,4.8 69.4,4.8'/></g></svg>") no-repeat;mask:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='78' height='14' viewBox='0 0 78 14'><g fill='black'><polygon points='7,0 8.6,4.8 13.5,4.8 9.5,7.7 11,12.6 7,9.6 3,12.6 4.5,7.7 0.5,4.8 5.4,4.8'/><polygon points='23,0 24.6,4.8 29.5,4.8 25.5,7.7 27,12.6 23,9.6 19,12.6 20.5,7.7 16.5,4.8 21.4,4.8'/><polygon points='39,0 40.6,4.8 45.5,4.8 41.5,7.7 43,12.6 39,9.6 35,12.6 36.5,7.7 32.5,4.8 37.4,4.8'/><polygon points='55,0 56.6,4.8 61.5,4.8 57.5,7.7 59,12.6 55,9.6 51,12.6 52.5,7.7 48.5,4.8 53.4,4.8'/><polygon points='71,0 72.6,4.8 77.5,4.8 73.5,7.7 75,12.6 71,9.6 67,12.6 68.5,7.7 64.5,4.8 69.4,4.8'/></g></svg>") no-repeat}
  .vsl-buy__sub{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 8px;text-align:center}

  .vsl-opts{display:grid;gap:10px;margin:0 0 16px}
  .vsl-opt{display:flex;align-items:center;gap:12px;padding:13px 14px;border:2px solid var(--line);border-radius:10px;background:#fff;cursor:pointer;transition:all .15s ease}
  .vsl-opt:hover{border-color:var(--blue-soft)}
  .vsl-opt.is-on{border-color:var(--blue);background:var(--blue-soft)}
  .vsl-opt input{position:absolute;opacity:0;pointer-events:none}
  .vsl-opt__bullet{width:18px;height:18px;border-radius:50%;border:2px solid var(--line);flex:0 0 auto;position:relative;transition:all .15s}
  .vsl-opt.is-on .vsl-opt__bullet{border-color:var(--blue)}
  .vsl-opt.is-on .vsl-opt__bullet::after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--blue)}
  .vsl-opt__main{flex:1;min-width:0}
  .vsl-opt__title{font-weight:700;font-size:15px;color:var(--ink);display:flex;flex-wrap:wrap;align-items:center;gap:6px;line-height:1.25}
  .vsl-opt__chip{font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:2px 7px;border-radius:4px;background:var(--cream);color:var(--ink-soft);white-space:nowrap}
  .vsl-opt__chip--blue{background:var(--blue);color:#fff}
  .vsl-opt__chip--sage{background:var(--sage);color:#fff}
  .vsl-opt__meta{font-size:12px;color:var(--muted);margin-top:3px}
  .vsl-opt__price{text-align:right;flex:0 0 auto;font-size:13px}
  .vsl-opt__price b{display:block;font-weight:800;font-size:15px;color:var(--ink);letter-spacing:-.01em}
  .vsl-opt__price-row{display:block;font-size:11px;color:var(--muted);margin-top:2px}
  .vsl-opt__price-row s{margin-right:4px}
  .vsl-opt__save{display:block;font-size:11px;color:var(--sage);font-weight:700;margin-top:2px}

  .vsl-buy__list{list-style:none;padding:0;margin:0 0 16px;display:grid;gap:8px}
  .vsl-buy__list li{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:var(--ink);line-height:1.4}
  .vsl-buy__list li svg{width:18px;height:18px;color:var(--sage);flex:0 0 auto;margin-top:1px}
  .vsl-buy__cta{display:flex;align-items:center;justify-content:center;width:100%;padding:16px;background:var(--blue);color:#fff !important;font-weight:700;font-size:15px;letter-spacing:.04em;text-transform:uppercase;border-radius:6px;border:0;cursor:pointer;text-decoration:none;transition:background .2s}
  .vsl-buy__cta:hover{background:var(--blue-deep)}
  .vsl-buy__cta::after{content:" →";margin-left:10px}
  .vsl-buy__fine{font-size:12px;color:var(--muted);text-align:center;margin:10px 0 0;line-height:1.4}

  /* ---------- ACTIVES ---------- */
  .vsl-actives{display:grid;grid-template-columns:1fr;gap:14px;margin-top:18px}
  @media(min-width:760px){.vsl-actives{grid-template-columns:repeat(3,1fr);gap:16px}}
  .vsl-act{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px}
  .vsl-act__name{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-deep);margin:0 0 6px}
  .vsl-act__h{font-size:17px;font-weight:800;margin:0 0 8px;line-height:1.25;color:var(--ink)}
  .vsl-act__t{font-size:14px;line-height:1.5;color:var(--ink-soft);margin:0}

  /* ---------- COMPARISON TABLE ---------- */
  .vsl-cmp{margin-top:18px;background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .vsl-cmp table{width:100%;border-collapse:collapse;font-size:13px}
  .vsl-cmp th,.vsl-cmp td{padding:11px 10px;text-align:center;border-bottom:1px solid var(--line);vertical-align:middle}
  .vsl-cmp th{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);background:var(--cream-soft)}
  .vsl-cmp tr:last-child td{border-bottom:0}
  .vsl-cmp .vsl-cmp__lbl{text-align:left;font-weight:600;color:var(--ink);padding-left:14px;background:var(--cream-soft)}
  .vsl-cmp .yes{color:var(--sage);font-weight:700}
  .vsl-cmp .no{color:var(--warn);font-weight:600}
  .vsl-cmp .wlp-col{background:var(--blue-soft);font-weight:700;color:var(--blue-deep)}
  @media(max-width:520px){.vsl-cmp{font-size:12px}.vsl-cmp th,.vsl-cmp td{padding:9px 6px}}

  /* ---------- REVIEWS PROOF ---------- */
  .vsl-rev{display:grid;grid-template-columns:1fr;gap:14px;margin-top:18px}
  @media(min-width:760px){.vsl-rev{grid-template-columns:repeat(3,1fr);gap:16px}}
  .vsl-rev__card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px}
  .vsl-rev__stars{margin-bottom:8px}
  .vsl-rev__q{font-size:14px;color:var(--ink);line-height:1.5;margin:0 0 10px}
  .vsl-rev__n{font-size:12px;color:var(--ink-soft);font-weight:700}
  .vsl-rev__v{display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--sage);font-weight:600;margin-left:6px}
  .vsl-rev__v svg{width:11px;height:11px}

  /* ---------- FAQ ---------- */
  .vsl-faq{max-width:680px;margin:18px auto 0}
  .vsl-faq__item{background:#fff;border:1px solid var(--line);border-radius:10px;margin-bottom:10px;overflow:hidden}
  .vsl-faq__q{cursor:pointer;padding:16px 18px;font-weight:700;font-size:15px;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:14px;list-style:none;line-height:1.35}
  .vsl-faq__q::-webkit-details-marker{display:none}
  .vsl-faq__q::after{content:"+";font-size:22px;color:var(--blue);font-weight:400;transition:transform .2s}
  .vsl-faq__item[open] .vsl-faq__q::after{transform:rotate(45deg)}
