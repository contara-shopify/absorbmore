<script>
(function () {
  var plans = document.querySelectorAll('.buybox .plan');
  var cta = document.getElementById('bvt-buy-cta');
  if (!plans.length || !cta) return;

  plans.forEach(function (plan) {
    plan.addEventListener('click', function () {
      plans.forEach(function (p) { p.classList.remove('selected'); });
      plan.classList.add('selected');
    });
  });

  cta.addEventListener('click', function (e) {
    e.preventDefault();
    var selected = document.querySelector('.buybox .plan.selected') || plans[0];
    var variantId = selected.getAttribute('data-variant-id');
    var sellingPlanId = selected.getAttribute('data-selling-plan-id');
    var qty = parseInt(selected.getAttribute('data-quantity') || '1', 10);
    if (!variantId) return;

    cta.disabled = true;
    var originalLabel = cta.textContent;
    cta.textContent = 'Adding to cart...';

    var body = { id: variantId, quantity: qty };
    if (sellingPlanId) body.selling_plan = sellingPlanId;

    fetch('/cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    }).then(function (r) {
      if (!r.ok) throw new Error('add failed');
      window.location.href = '/checkout';
    }).catch(function () {
      cta.disabled = false;
      cta.textContent = originalLabel;
      window.location.href = '/checkout';
    });
  });
})();
</script>
