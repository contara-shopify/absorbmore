                  },
                  "blocks": {}
                },
                "collapsible_FJYqgf": {
                  "type": "collapsible",
                  "name": "Collapsible",
                  "settings": {
                    "label": "Is there a risk-free way to try?",
                    "metafield_namespace_key": "product.smart.faqs",
                    "metafield_image_key": "image",
                    "metafield_label_key": "question",
                    "accordion_class": "accordion",
                    "content": "<p>Yes. Every order is backed by a 30-day money-back guarantee from the day your order is delivered. If it doesn't work for you, email hello@absorbmore.com and we'll refund you, no questions asked. Free shipping on orders over $50.</p>",
                    "show": false,
